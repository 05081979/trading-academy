orgs.fvg_o              := input.color(color.new(color.green,10), "Open",             group = "First 1m FVG", inline = "fvg_o")
orgs.fvg_o_style        := input.string("····", "", options = ["⎯⎯⎯","----","····"],  group = "First 1m FVG", inline = "fvg_o")
orgs.fvg_c              := input.color(color.new(color.green,10), "Close",            group = "First 1m FVG", inline = "fvg_c")
orgs.fvg_c_style        := input.string("····", "", options = ["⎯⎯⎯","----","····"],  group = "First 1m FVG", inline = "fvg_c")
orgs.fvg_ce             := input.color(color.new(color.green,10), "C.E.",             group = "First 1m FVG", inline = "fvg_ce")
orgs.fvg_ce_style       := input.string("····", "", options = ["⎯⎯⎯","----","····"],  group = "First 1m FVG", inline = "fvg_ce")
orgs.fvg_link           := input.color(color.new(color.green,10), "Link",             group = "First 1m FVG", inline = "fvg_link")
orgs.fvg_link_style     := input.string("⎯⎯⎯", "", options = ["⎯⎯⎯","----","····"],  group = "First 1m FVG", inline = "fvg_link")
orgs.fvg_show_label     := input.bool(true, "Label",                                  group = "First 1m FVG", inline = "fvg_label")
orgs.fvg_label_size     := input.string(size.small, "", options = [size.auto,size.tiny,size.small,size.normal,size.large,size.huge], group = "First 1m FVG", inline = "fvg_label")
orgs.fvg_label_color    := input.color(color.gray, "",                                group = "First 1m FVG", inline = "fvg_label")
orgs.fvg_label_bg       := input.color(color.new(color.black,100), "",                group = "First 1m FVG", inline = "fvg_label")
orgs.show_fvg_bg        := input.bool(true, "Background",                             group = "First 1m FVG", inline = "fvg_bg")
orgs.fvg_bg             := input.color(color.new(color.green,95), "",                 group = "First 1m FVG", inline = "fvg_bg")
orgs.fvg_extend_monday  := input.bool(true, "Extend Monday's FVG",                    group = "First 1m FVG")
orgs.fvg_extend_all     := input.bool(true, "Extend All",                             group = "First 1m FVG")

orgs.show_openrange     := input.bool(true, "Open Range Gap",                         group = "Open Range Gap", inline = "org")
orgs.org_o              := input.color(color.new(color.gray,10), "Open",              group = "Open Range Gap", inline = "org_o")
orgs.org_o_style        := input.string("⎯⎯⎯", "", options = ["⎯⎯⎯","----","····"],  group = "Open Range Gap", inline = "org_o")
orgs.org_c              := input.color(color.new(color.gray,10), "Close",             group = "Open Range Gap", inline = "org_c")
orgs.org_c_style        := input.string("⎯⎯⎯", "", options = ["⎯⎯⎯","----","····"],  group = "Open Range Gap", inline = "org_c")
orgs.org_ce             := input.color(color.new(color.red,10), "C.E.",               group = "Open Range Gap", inline = "org_ce")
orgs.org_ce_style       := input.string("----", "", options = ["⎯⎯⎯","----","····"],  group = "Open Range Gap", inline = "org_ce")
orgs.org_o_trace        := input.color(color.new(color.gray,10), "Trace Open",        group = "Open Range Gap", inline = "org_o_trace")
orgs.org_o_trace_style  := input.string("⎯⎯⎯", "", options = ["⎯⎯⎯","----","····"],  group = "Open Range Gap", inline = "org_o_trace")
orgs.org_show_qdr       := input.bool(true, "Quadrants",                              group = "Open Range Gap", inline = "org_qdr")
orgs.org_qdr            := input.color(color.new(color.gray,10), "",                  group = "Open Range Gap", inline = "org_qdr")
orgs.org_qdr_style      := input.string("····", "", options = ["⎯⎯⎯","----","····"],  group = "Open Range Gap", inline = "org_qdr")
orgs.show_org_bg        := input.bool(true, "Background",                             group = "Open Range Gap", inline = "org_bg")
orgs.org_bg1            := input.color(color.new(color.blue,90), "",                  group = "Open Range Gap", inline = "org_bg")
orgs.org_bg2            := input.color(color.new(color.green,90), "",                 group = "Open Range Gap", inline = "org_bg")
orgs.org_bg3            := input.color(color.new(color.red,90), "",                   group = "Open Range Gap", inline = "org_bg")
orgs.org_bg4            := input.color(color.new(color.orange,90), "",                group = "Open Range Gap", inline = "org_bg")
orgs.show_org_fill      := input.bool(true, "Fill",                                   group = "Open Range Gap", inline = "org_fill")
orgs.org_fill1          := input.color(color.new(color.blue,95), "",                  group = "Open Range Gap", inline = "org_fill")
orgs.org_fill2          := input.color(color.new(color.blue,80), "",                  group = "Open Range Gap", inline = "org_fill")
orgs.org_extend         := input.bool(false, "Extend to end of day",                  group = "Open Range Gap")
orgs.org_factor         := input.int(5, "Minimum Size", minval=1, tooltip="Hide Open Range Gaps smaller than this size.", group = "Open Range Gap")

orgs.show_labels        := input.bool(true, "Labels",                                 group = "ORG — Labels", inline = "org_lbl")
orgs.org_label_size     := input.string(size.small, "", options = [size.auto,size.tiny,size.small,size.normal,size.large,size.huge], group = "ORG — Labels", inline = "org_lbl")
orgs.org_label_color    := input.color(color.gray, "",                                 group = "ORG — Labels", inline = "org_lbl")
orgs.org_label_bg       := input.color(color.new(color.black,100), "",                 group = "ORG — Labels", inline = "org_lbl")

// ─── ORG Helper Variables ─────────────────────────────────────────────────────

int org_tc = (time - time[1]) * orgs.buffer
int org_ts = (time - time[1]) * 3

// ─── ORG Internal Functions ───────────────────────────────────────────────────

orgLineStyle(string style) =>
    out = switch style
        "----" => line.style_dashed
        "····" => line.style_dotted
        =>        line.style_solid
    out

orgValidTF() =>
    timeframe.in_seconds() <= timeframe.in_seconds(orgs.hide_above)

org_getLtfValues(o, c, t) =>
    float _o = na
    float _c = na
    int   _t = na
    int index = na
    if o.size() > 1
        for i = 0 to o.size() - 1
            if not na(o.get(i))
                index := i
                break
        if not na(index)
            if o.size() >= index
                _o := o.get(index)
            if c.size() >= index
                _c := c.get(index)
            if t.size() >= index
                _t := t.get(index)
    [_o, _c, _t]

org_sessionStarted() =>
    bool started = false
    if timeframe.isseconds
        insession = request.security(syminfo.tickerid, "1", (not na(time("1", "1614-0930", "America/New_York")) and na(time("1", "1614-0930", "America/New_York")[1])), lookahead=barmerge.lookahead_on)
        started := insession
    else
        if (timeframe.isminutes and timeframe.multiplier == 1)
            insession = (not na(time("1", "1614-0930", "America/New_York")) and na(time("1", "1614-0930", "America/New_York")[1]))
            started := insession
        if (timeframe.isminutes and timeframe.multiplier > 1)
            insession = request.security_lower_tf(syminfo.tickerid, "1", (not na(time("1", "1614-0930", "America/New_York")) and na(time("1", "1614-0930", "America/New_York")[1])))
            started := insession.includes(true)
    started

org_sessionEnded() =>
    bool ended = false
    if timeframe.isseconds
        insession = request.security(syminfo.tickerid, "1", (na(time("1", "1614-0930", "America/New_York")) and not na(time("1", "1614-0930", "America/New_York")[1])), lookahead=barmerge.lookahead_on)
        ended := insession
    else
        if (timeframe.isminutes and timeframe.multiplier == 1)
            insession = (na(time("1", "1614-0930", "America/New_York")) and not na(time("1", "1614-0930", "America/New_York")[1]))
            ended := insession
        if (timeframe.isminutes and timeframe.multiplier > 1)
            insession = request.security_lower_tf(syminfo.tickerid, "1", (na(time("1", "1614-0930", "America/New_York")) and not na(time("1", "1614-0930", "America/New_York")[1])))
            ended := insession.includes(true)
    ended

org_get1mFVG(l1, l2, l3, h1, h2, h3, min1, max1, min2, max2, min3, max3, t3) =>
    float o = na
    float c = na
    if (hour(t3, "America/New_York") == 9 and minute(t3, "America/New_York") >= 31) or (hour(t3, "America/New_York") > 9 and hour(t3, "America/New_York") <= 12)
        if l1 > h3
            if min2 > max3
                o := max3
            else
                o := h3
            if min1 > max2
                c := min1
            else
                c := l1
        if h1 < l3
            if max1 < min2
                c := max1
            else
                c := h1
            if min3 > max2
                o := min3
            else
                o := l3
    [o, c, t3]

org_firstFVG() =>
    float fvg_o = na
    float fvg_c = na
    int   fvg_t = na
    if ta.change(time("1")) != 0
        if timeframe.isseconds
            [_o, _c, _t] = request.security(syminfo.tickerid, "1", org_get1mFVG(low[1], low[2], low[3], high[1], high[2], high[3], math.min(open[1], close[1]), math.max(open[1], close[1]), math.min(open[2], close[2]), math.max(open[2], close[2]), math.min(open[3], close[3]), math.max(open[3], close[3]), time[2]), lookahead = barmerge.lookahead_on)
            fvg_o := _o
            fvg_c := _c
            fvg_t := _t
        else
            if (timeframe.isminutes and timeframe.multiplier == 1)
                if barstate.isconfirmed
                    [_o, _c, _t] = org_get1mFVG(low, low[1], low[2], high, high[1], high[2], math.min(open, close), math.max(open, close), math.min(open[1], close[1]), math.max(open[1], close[1]), math.min(open[2], close[2]), math.max(open[2], close[2]), time[1])
                    fvg_o := _o
                    fvg_c := _c
                    fvg_t := _t
            if (timeframe.isminutes and timeframe.multiplier >= 2)
                [o, c, t] = request.security_lower_tf(syminfo.tickerid, "1", org_get1mFVG(low[1], low[2], low[3], high[1], high[2], high[3], math.min(open[1], close[1]), math.max(open[1], close[1]), math.min(open[2], close[2]), math.max(open[2], close[2]), math.min(open[3], close[3]), math.max(open[3], close[3]), time[2]))
                [_o, _c, _t] = org_getLtfValues(o, c, t)
                fvg_o := _o
                fvg_c := _c
                fvg_t := time
    [fvg_o, fvg_c, fvg_t]

// ─── ORG Methods ──────────────────────────────────────────────────────────────

method org_clear(OpenRange this) =>
    this.line_open.delete()
    this.line_open_trace.delete()
    this.line_close.delete()
    this.line_q1.delete()
    this.line_ce.delete()
    this.line_q2.delete()
    this.line_fvg_o.delete()
    this.line_fvg_c.delete()
    this.line_fvg_ce.delete()
    this.line_fvg_link.delete()
    this.lf_org1.delete()
    this.lf_org2.delete()
    this.lf_org3.delete()
    this.lf_org4.delete()
    this.lf_fvg.delete()
    this.label_fvg.delete()
    this.label_org1.delete()
    this.label_org2.delete()
    this.label_org3.delete()
    this.label_org4.delete()
    this.label_org5.delete()
    this.box_fill1.delete()
    this.box_fill2.delete()

method org_terminateRange(OpenRange this) =>
    this.line_open.set_x2(time)
    this.line_close.set_x2(time)
    this.line_q1.set_x2(time)
    this.line_ce.set_x2(time)
    this.line_q2.set_x2(time)
    this.label_org1.set_x(time)
    this.label_org2.set_x(time)
    this.label_org3.set_x(time)
    this.label_org4.set_x(time)
    this.label_org5.set_x(time)
    this.box_fill1.delete()
    this.box_fill2.delete()
    this.label_org1.delete()
    this.label_org2.delete()
    this.label_org3.delete()
    this.label_org4.delete()
    this.label_org5.delete()

method org_updateFill(OpenRange this) =>
    if this.open < this.close
        if this.box_fill2.get_bottom() >= this.open and low < this.box_fill2.get_bottom()
            this.box_fill2.set_bottom(math.max(low, this.open))
            this.box_fill1.set_bottom(this.box_fill2.get_bottom())
    else
        if this.box_fill2.get_bottom() <= this.open and high > this.box_fill2.get_bottom()
            this.box_fill2.set_bottom(math.min(high, this.open))
            this.box_fill1.set_bottom(this.box_fill2.get_bottom())

// ─── ORG Render ───────────────────────────────────────────────────────────────

method org_render(OpenRange[] this) =>
    if this.size() > 0
        OpenRange org = this.first()
        if not na(org.close)
            if orgs.show_openrange
                if math.abs(org.open - org.close) > orgs.org_factor
                    if na(org.line_open)
                        float q  = math.abs(org.open - org.close)/4
                        float q1 = org.close > org.open ? org.close-q        : org.open-q
                        float q2 = org.close > org.open ? org.close-(q*2)    : org.open-(q*2)
                        float q3 = org.close > org.open ? org.close-(q*3)    : org.open-(q*3)
                        org.line_open  := line.new(org.close_time, org.open,     time+org_tc, org.open,     xloc=xloc.bar_time, color=orgs.org_o,  style=orgLineStyle(orgs.org_o_style))
                        org.line_ce    := line.new(org.close_time, q2,           time+org_tc, q2,           xloc=xloc.bar_time, color=orgs.org_ce, style=orgLineStyle(orgs.org_ce_style))
                        org.line_close := line.new(org.close_time, org.close,    time+org_tc, org.close,    xloc=xloc.bar_time, color=orgs.org_c,  style=orgLineStyle(orgs.org_c_style))
                        if orgs.org_show_qdr
                            org.line_q1 := line.new(org.close_time, q1, time+org_tc, q1, xloc=xloc.bar_time, color=orgs.org_qdr, style=orgLineStyle(orgs.org_qdr_style))
                            org.line_q2 := line.new(org.close_time, q3, time+org_tc, q3, xloc=xloc.bar_time, color=orgs.org_qdr, style=orgLineStyle(orgs.org_qdr_style))
                        if orgs.show_org_bg
                            if org.open < org.close
                                if orgs.org_show_qdr
                                    org.lf_org1 := linefill.new(org.line_open, org.line_q2, color=orgs.org_bg1)
                                    org.lf_org2 := linefill.new(org.line_q2, org.line_ce,   color=orgs.org_bg2)
                                    org.lf_org3 := linefill.new(org.line_ce, org.line_q1,   color=orgs.org_bg3)
                                    org.lf_org4 := linefill.new(org.line_q1, org.line_close, color=orgs.org_bg4)
                                else
                                    org.lf_org1 := linefill.new(org.line_open, org.line_ce,   color=orgs.org_bg1)
                                    org.lf_org2 := linefill.new(org.line_ce, org.line_close,  color=orgs.org_bg2)
                            else
                                if orgs.org_show_qdr
                                    org.lf_org1 := linefill.new(org.line_open, org.line_q1,   color=orgs.org_bg1)
                                    org.lf_org2 := linefill.new(org.line_q1, org.line_ce,     color=orgs.org_bg2)
                                    org.lf_org3 := linefill.new(org.line_ce, org.line_q2,     color=orgs.org_bg3)
                                    org.lf_org4 := linefill.new(org.line_q2, org.line_close,  color=orgs.org_bg4)
                                else
                                    org.lf_org1 := linefill.new(org.line_open, org.line_ce,   color=orgs.org_bg1)
                                    org.lf_org2 := linefill.new(org.line_ce, org.line_close,  color=orgs.org_bg2)
                        if orgs.show_org_fill
                            org.box_fill1 := box.new(time+org_tc, org.open,  time+org_tc-org_ts, org.close, xloc=xloc.bar_time, border_color=orgs.org_fill1, bgcolor=orgs.org_fill1)
                            org.box_fill2 := box.new(time+org_tc, org.close, time+org_tc-org_ts, org.close, xloc=xloc.bar_time, border_color=orgs.org_fill2, bgcolor=orgs.org_fill2)
                        if orgs.show_labels
                            if orgs.org_show_qdr
                                if org.open < org.close
                                    org.label_org2 := label.new(time+org_tc, q1, str.tostring(q1, "#,##0.00") + " (1/4)", xloc=xloc.bar_time, textcolor=orgs.org_label_color, color=orgs.org_label_bg, size=orgs.org_label_size, style=label.style_label_left)
                                    org.label_org4 := label.new(time+org_tc, q3, str.tostring(q3, "#,##0.00") + " (3/4)", xloc=xloc.bar_time, textcolor=orgs.org_label_color, color=orgs.org_label_bg, size=orgs.org_label_size, style=label.style_label_left)
                                else
                                    org.label_org2 := label.new(time+org_tc, q1, str.tostring(q1, "#,##0.00") + " (3/4)", xloc=xloc.bar_time, textcolor=orgs.org_label_color, color=orgs.org_label_bg, size=orgs.org_label_size, style=label.style_label_left)
                                    org.label_org4 := label.new(time+org_tc, q3, str.tostring(q3, "#,##0.00") + " (1/4)", xloc=xloc.bar_time, textcolor=orgs.org_label_color, color=orgs.org_label_bg, size=orgs.org_label_size, style=label.style_label_left)
                            org.label_org3 := label.new(time+org_tc, q2,        str.tostring(q2, "#,##0.00") + " (1/2)",   xloc=xloc.bar_time, textcolor=orgs.org_label_color, color=orgs.org_label_bg, size=orgs.org_label_size, style=label.style_label_left)
                            org.label_org5 := label.new(time+org_tc, org.close, str.tostring(org.close, "#,##0.00") + " (close)", xloc=xloc.bar_time, textcolor=orgs.org_label_color, color=orgs.org_label_bg, size=orgs.org_label_size, style=label.style_label_left)
                    else
                        if orgs.org_extend or (not orgs.org_extend and (hour(time, "America/New_York") < 10 or (hour(time, "America/New_York") == 10 and minute(time, "America/New_York") == 0)))
                            org.line_open.set_x2(time+org_tc)
                            org.line_open_trace.set_x2(org.close_time)
                            org.line_close.set_x2(time+org_tc)
                            org.line_q1.set_x2(time+org_tc)
                            org.line_ce.set_x2(time+org_tc)
                            org.line_q2.set_x2(time+org_tc)
                            org.label_org1.set_x(time+org_tc)
                            org.label_org2.set_x(time+org_tc)
                            org.label_org3.set_x(time+org_tc)
                            org.label_org4.set_x(time+org_tc)
                            org.label_org5.set_x(time+org_tc)
                            org.box_fill1.set_right(time+org_tc)
                            org.box_fill1.set_left(time+org_tc-org_ts)
                            org.box_fill2.set_right(time+org_tc)
                            org.box_fill2.set_left(time+org_tc-org_ts)
                            org.org_updateFill()
            if not na(org.line_fvg_o)
                org.line_fvg_o.set_x2(time+org_tc)
                org.line_fvg_c.set_x2(time+org_tc)
                org.line_fvg_ce.set_x2(time+org_tc)
                org.line_fvg_link.set_x1(time+org_tc)
                org.line_fvg_link.set_x2(time+org_tc)
                org.label_fvg.set_x(time+org_tc)
        else
            if not na(org.open) and orgs.show_openrange
                if na(org.line_open_trace)
                    if orgs.show_labels
                        org.label_org1 := label.new(time+org_tc, org.open, str.tostring(org.open, "#,##0.00") + " (open)", xloc=xloc.bar_time, textcolor=orgs.org_label_color, color=orgs.org_label_bg, size=orgs.org_label_size, style=label.style_label_left)
                    org.line_open_trace := line.new(org.open_time, org.open, time+org_tc, org.open, xloc=xloc.bar_time, color=orgs.org_o_trace, style=orgLineStyle(orgs.org_o_trace_style))
                else
                    org.line_open_trace.set_x2(time+org_tc)
                    org.label_org1.set_x(time+org_tc)
        if orgs.fvg_extend_monday or orgs.fvg_extend_all
            for org in this
                if (orgs.fvg_extend_monday and org.is_Monday and org.woy == weekofyear(time, "America/New_York")) or (orgs.fvg_extend_all and org.woy == weekofyear(time_tradingday, "America/New_York"))
                    if not na(org.line_fvg_o)
                        org.line_fvg_o.set_x2(time+org_tc)
                        org.line_fvg_c.set_x2(time+org_tc)
                        org.line_fvg_ce.set_x2(time+org_tc)
                        org.line_fvg_link.set_x1(time+org_tc)
                        org.line_fvg_link.set_x2(time+org_tc)
                        org.label_fvg.set_x(time+org_tc)
        if (not orgs.org_extend and (hour(time, "America/New_York") == 10 and minute(time, "America/New_York") == 0))
            org.org_terminateRange()
    this

// ─── ORG Main Execution ──────────────────────────────────────────────────────

if orgValidTF()
    if org_sessionStarted()
        if orgs.org_extend
            if orgRanges.size() > 0
                OpenRange old = orgRanges.first()
                old.org_terminateRange()
        OpenRange org = OpenRange.new()
        org.open      := close
        org.open_time := time
        orgRanges.unshift(org)

    if org_sessionEnded()
        if orgRanges.size() > 0
            OpenRange org = orgRanges.first()
            org.close      := open
            org.close_time := time

    if orgs.show_fvg
        if orgRanges.size() > 0
            OpenRange org = orgRanges.first()
            if na(org.line_fvg_o)
                [o, c, t] = org_firstFVG()
                if not na(o)
                    org.is_Monday      := dayofweek(time, "America/New_York") == dayofweek.monday
                    org.woy            := weekofyear(time, "America/New_York")
                    org.line_fvg_o     := line.new(t, o, (t+org_tc), o, xloc=xloc.bar_time, color=orgs.fvg_o, style=orgLineStyle(orgs.fvg_o_style))
                    org.line_fvg_c     := line.new(t, c, (t+org_tc), c, xloc=xloc.bar_time, color=orgs.fvg_c, style=orgLineStyle(orgs.fvg_c_style))
                    org.line_fvg_ce    := line.new(t, (o+c)/2, (t+org_tc), (o+c)/2, xloc=xloc.bar_time, color=orgs.fvg_ce, style=orgLineStyle(orgs.fvg_ce_style))
                    org.line_fvg_link  := line.new((t+org_tc), o, (t+org_tc), c, xloc=xloc.bar_time, color=orgs.fvg_link, style=orgLineStyle(orgs.fvg_link_style), width=3)
                    if orgs.fvg_show_label
                        org.label_fvg := label.new(time+org_tc, (o+c)/2, "1st FVG", xloc=xloc.bar_time, textcolor=orgs.fvg_label_color, color=orgs.fvg_label_bg, size=orgs.fvg_label_size, style=label.style_label_left)
                    if orgs.show_fvg_bg
                        org.lf_fvg := linefill.new(org.line_fvg_o, org.line_fvg_c, orgs.fvg_bg)

    if orgRanges.size() > orgs.max
        OpenRange temp = orgRanges.pop()
        temp.org_clear()

    orgRanges.org_render()


// ═══════════════════════════════════════════════════════════════════════════════
// ██  NWOG / NDOG  (© cryptonnnite — integrated, no external library)  ██████
// ═══════════════════════════════════════════════════════════════════════════════

// ─── NWOG/NDOG Inline Helpers ─────────────────────────────────────────────────

nwog_isNewbar(string tf) =>
    timeframe.change(tf)

nwog_getTextSize(string s) =>
    switch s
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        "large"  => size.large
        "huge"   => size.huge
        => size.normal

nwog_getBoxAlign(string s) =>
    switch s
        "left"   => text.align_left
        "center" => text.align_center
        "right"  => text.align_right
        "top"    => text.align_top
        "bottom" => text.align_bottom
        => text.align_center

nwog_getLineStyle(string s) =>
    switch s
        "solid"  => line.style_solid
        "dashed" => line.style_dashed
        "dotted" => line.style_dotted
        => line.style_solid

// ─── NWOG/NDOG Types ──────────────────────────────────────────────────────────

type NwogGap
    float high
    float low
    int start
    int end_t

// ─── NWOG/NDOG Settings ──────────────────────────────────────────────────────

string nwogGroup = "NWOG ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
string ndogGroup = "NDOG ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
string nwogGeneral = "NWOG/NDOG General"

bool showNWOG = input.bool(true, "", inline = "nw1", group = nwogGroup)
string nwogLabel = input.string("NWOG", "", inline = "nw1", group = nwogGroup)
color nwogBg = input.color(color.rgb(164, 249, 73, 85), "", inline = "nw1", group = nwogGroup)
bool showNwogCE = input.bool(false, "NWOG C.E.", tooltip = "C.E. = Consequent Encroachment (midpoint)", group = nwogGroup, inline = "nw2")
string nwogCEStyle = input.string("dotted", "", options = ["dotted", "dashed", "solid"], group = nwogGroup, inline = "nw2")
color nwogCEColor = input.color(color.blue, "", group = nwogGroup, inline = "nw2")
string nwogLabelXPos = input.string("right", title = "Label", options = ["left", "center", "right"], inline = "nw5", group = nwogGroup)
string nwogLabelYPos = input.string("top", title = "", options = ["top", "center", "bottom"], inline = "nw5", group = nwogGroup)
string nwogLabelSz = input.string("small", title = "", options = ["tiny", "small", "normal", "large", "huge"], inline = "nw5", group = nwogGroup)
color nwogLabelCol = input.color(color.black, "", inline = "nw5", group = nwogGroup)
int nwogsAmt = input.int(4, "Previous NWOGs", minval = 1, maxval = 100, inline = "nw3", group = nwogGroup)
color prevNwogBg = input.color(color.rgb(0, 0, 0, 90), "", inline = "nw3", group = nwogGroup)
bool extAllNwogs = input.bool(false, "Extend Previous NWOGs", group = nwogGroup)
bool extToCurDay = input.bool(true, "Extend to Current Day", tooltip = "Otherwise extended to end of week", group = nwogGroup)

bool showNDOG = input.bool(true, "", inline = "nd2", group = ndogGroup)
string ndogLabelTxt = input.string("NDOG", "", inline = "nd2", group = ndogGroup)
color ndogBg = input.color(color.rgb(255, 235, 59, 85), "", inline = "nd2", group = ndogGroup)
bool showNdogCE = input.bool(false, "NDOG C.E.", tooltip = "C.E. = Consequent Encroachment (midpoint)", group = ndogGroup, inline = "nd3")
string ndogCEStyle = input.string("dotted", "", options = ["dotted", "dashed", "solid"], group = ndogGroup, inline = "nd3")
color ndogCEColor = input.color(color.blue, "", group = ndogGroup, inline = "nd3")
string ndogLabelXPos = input.string("right", title = "Label", options = ["left", "center", "right"], inline = "nd5", group = ndogGroup)
string ndogLabelYPos = input.string("top", title = "", options = ["top", "center", "bottom"], inline = "nd5", group = ndogGroup)
string ndogLabelSz = input.string("small", title = "", options = ["tiny", "small", "normal", "large", "huge"], inline = "nd5", group = ndogGroup)
color ndogLabelCol = input.color(color.black, "", inline = "nd5", group = ndogGroup)
int ndogsAmt = input.int(4, "Previous NDOG", minval = 1, maxval = 100, inline = "nd4", group = ndogGroup)
color prevNdogBg = input.color(color.rgb(0, 0, 0, 90), "", inline = "nd4", group = ndogGroup)
bool extAllNdogs = input.bool(false, "Extend Previous NDOGs", group = ndogGroup)

bool nwog_eventHorizon = input.bool(false, "Event Horizon", inline = "ng2", group = nwogGeneral)
string nwog_ehStyle = input.string("dashed", "", options = ["dotted", "dashed", "solid"], group = nwogGeneral, inline = "ng2")
color nwog_ehColor = input.color(color.red, "", inline = "ng2", group = nwogGeneral)
bool nwog_5to6gap = input.bool(true, "5pm to 6pm GAP", tooltip = "Use 5pm-6pm gap instead of full day close-to-open", group = nwogGeneral)
bool nwog_showPrice = input.bool(false, "Price Labels", inline = "ng1", group = nwogGeneral)
string nwog_priceSz = input.string("small", title = "", options = ["tiny", "small", "normal", "large", "huge"], inline = "ng1", group = nwogGeneral)
color nwog_priceCol = input.color(color.black, "", inline = "ng1", group = nwogGeneral)
bool nwog_showDate = input.bool(true, "Show date label", group = nwogGeneral)
string nwog_dateFmt = input.string("dd.MM", title = "Date Format", options = ["dd.MM", "MM.dd", "dd.MM.yy", "MM.dd.yy"], group = nwogGeneral)

// ─── NWOG/NDOG Data Fetching ──────────────────────────────────────────────────

nwog_getGapData() =>
    NwogGap.new(math.max(close[1], open), math.min(close[1], open), time, time_close)

NwogGap nwog_weekGap = request.security(syminfo.tickerid, "1W", nwog_getGapData(), lookahead = barmerge.lookahead_on)
[nwog_dayGap, nwog_curDayClose] = request.security(syminfo.tickerid, "1D", [nwog_getGapData(), time_close], lookahead = barmerge.lookahead_on)
[nwog_isNewWk, nwog_hPrevClose, nwog_hCurOpen] = request.security(syminfo.tickerid, "240", [nwog_isNewbar("W"), close[1], open], lookahead = barmerge.lookahead_on)

if timeframe.isintraday and nwog_isNewbar("D") and nwog_5to6gap
    nwog_dayGap.high := math.max(close[1], open)
    nwog_dayGap.low := math.min(close[1], open)

if timeframe.multiplier < 60
    if nwog_isNewWk and nwog_5to6gap
        nwog_weekGap.high := math.max(nwog_hPrevClose, nwog_hCurOpen)
        nwog_weekGap.low := math.min(nwog_hPrevClose, nwog_hCurOpen)
else if (timeframe.isdaily or timeframe.isintraday) and nwog_isNewbar("W") and nwog_5to6gap
    nwog_weekGap.high := math.max(close[1], open)
    nwog_weekGap.low := math.min(close[1], open)

// ─── NWOG/NDOG Arrays ────────────────────────────────────────────────────────

var array<box> nwogArr = array.new<box>(0)
var array<line> nwogCEArr = array.new<line>(0)
var array<label> nwogHLbl = array.new<label>(0)
var array<label> nwogCELbl = array.new<label>(0)
var array<label> nwogLLbl = array.new<label>(0)

var array<box> ndogArr = array.new<box>(0)
var array<line> ndogCEArr = array.new<line>(0)
var array<label> ndogHLbl = array.new<label>(0)
var array<label> ndogCELbl = array.new<label>(0)
var array<label> ndogLLbl = array.new<label>(0)

var line nwog_ehLine = na

// ─── NWOG Rendering ───────────────────────────────────────────────────────────

if showNWOG and (timeframe.isdaily or timeframe.isintraday)
    if nwog_isNewbar("W")
        string wkLbl = nwog_showDate ? str.format_time(nwog_weekGap.start, nwog_dateFmt, syminfo.timezone) + " - " + str.format_time(nwog_weekGap.end_t, nwog_dateFmt, syminfo.timezone) + " | " + nwogLabel : nwogLabel
        float nwogCe = (nwog_weekGap.high + nwog_weekGap.low) / 2

        array.push(nwogArr, box.new(nwog_weekGap.start, nwog_weekGap.high, nwog_weekGap.end_t, nwog_weekGap.low, xloc = xloc.bar_time, bgcolor = nwogBg, border_width = 0, text = wkLbl, text_size = nwog_getTextSize(nwogLabelSz), text_halign = nwog_getBoxAlign(nwogLabelXPos), text_valign = nwog_getBoxAlign(nwogLabelYPos), text_color = nwogLabelCol))

        if showNwogCE
            array.push(nwogCEArr, line.new(nwog_weekGap.start, nwogCe, nwog_weekGap.end_t, nwogCe, xloc = xloc.bar_time, style = nwog_getLineStyle(nwogCEStyle), color = nwogCEColor))

        if nwog_showPrice
            array.push(nwogHLbl, label.new(nwog_weekGap.end_t, nwog_weekGap.high, str.tostring(nwog_weekGap.high, format.mintick), style = label.style_label_lower_left, xloc = xloc.bar_time, color = color.rgb(0, 0, 0, 100), textcolor = nwog_priceCol, size = nwog_getTextSize(nwog_priceSz)))
            array.push(nwogCELbl, label.new(nwog_weekGap.end_t, nwogCe, str.tostring(nwogCe, format.mintick), style = label.style_label_left, xloc = xloc.bar_time, color = color.rgb(0, 0, 0, 100), textcolor = nwog_priceCol, size = nwog_getTextSize(nwog_priceSz)))
            array.push(nwogLLbl, label.new(nwog_weekGap.end_t, nwog_weekGap.low, str.tostring(nwog_weekGap.low, format.mintick), style = label.style_label_upper_left, xloc = xloc.bar_time, color = color.rgb(0, 0, 0, 100), textcolor = nwog_priceCol, size = nwog_getTextSize(nwog_priceSz)))

        if array.size(nwogArr) > nwogsAmt
            box.delete(array.shift(nwogArr))
            if showNwogCE
                line.delete(array.shift(nwogCEArr))
            if nwog_showPrice
                label.delete(array.shift(nwogHLbl))
                label.delete(array.shift(nwogCELbl))
                label.delete(array.shift(nwogLLbl))

        if nwog_eventHorizon and array.size(nwogArr) > 1
            box curNw = array.last(nwogArr)
            box prevNw = array.get(nwogArr, array.size(nwogArr) - 2)
            float cH = box.get_top(curNw)
            float cL = box.get_bottom(curNw)
            float pH = box.get_top(prevNw)
            float pL = box.get_bottom(prevNw)
            float ehLvl = 0.0
            if cH > pH and cL > pH
                ehLvl := (cL + pH) / 2
            else if pH > cH and pL > cH
                ehLvl := (pL + cH) / 2
            nwog_ehLine := line.new(nwog_weekGap.start, ehLvl, nwog_weekGap.end_t, ehLvl, xloc = xloc.bar_time, style = nwog_getLineStyle(nwog_ehStyle), color = nwog_ehColor)
            line.delete(nwog_ehLine[1])

    if nwog_isNewbar("D")
        if extAllNwogs and array.size(nwogArr) > 0
            for i = array.size(nwogArr) - 1 to 0
                int extTo = extToCurDay ? nwog_curDayClose : nwog_weekGap.end_t
                box.set_right(array.get(nwogArr, i), extTo)
                if i != array.size(nwogArr) - 1
                    box.set_bgcolor(array.get(nwogArr, i), prevNwogBg)
                if showNwogCE
                    line.set_x2(array.get(nwogCEArr, i), extTo)
                if nwog_showPrice
                    label.set_x(array.get(nwogHLbl, i), extTo)
                    label.set_x(array.get(nwogCELbl, i), extTo)
                    label.set_x(array.get(nwogLLbl, i), extTo)

        if extToCurDay and array.size(nwogArr) > 0
            box.set_right(array.last(nwogArr), nwog_curDayClose)
            if showNwogCE
                line.set_x2(array.last(nwogCEArr), nwog_curDayClose)
            if nwog_showPrice
                label.set_x(array.last(nwogHLbl), nwog_curDayClose)
                label.set_x(array.last(nwogCELbl), nwog_curDayClose)
                label.set_x(array.last(nwogLLbl), nwog_curDayClose)
            if nwog_eventHorizon
                line.set_x2(nwog_ehLine, nwog_curDayClose)

// ─── NDOG Rendering ───────────────────────────────────────────────────────────

if showNDOG and timeframe.isintraday
    if nwog_isNewbar("D")
        if (dayofweek != dayofweek.sunday and showNWOG) or not showNWOG
            string dLbl = nwog_showDate ? str.format_time(nwog_dayGap.start, nwog_dateFmt, syminfo.timezone) + " | " + ndogLabelTxt : ndogLabelTxt
            float ndogCe = (nwog_dayGap.high + nwog_dayGap.low) / 2

            array.push(ndogArr, box.new(nwog_dayGap.start, nwog_dayGap.high, nwog_dayGap.end_t, nwog_dayGap.low, xloc = xloc.bar_time, bgcolor = ndogBg, border_width = 0, text = dLbl, text_size = nwog_getTextSize(ndogLabelSz), text_halign = nwog_getBoxAlign(ndogLabelXPos), text_valign = nwog_getBoxAlign(ndogLabelYPos), text_color = ndogLabelCol))

            if showNdogCE
                array.push(ndogCEArr, line.new(nwog_dayGap.start, ndogCe, nwog_dayGap.end_t, ndogCe, xloc = xloc.bar_time, style = nwog_getLineStyle(ndogCEStyle), color = ndogCEColor))

            if nwog_showPrice
                array.push(ndogHLbl, label.new(nwog_dayGap.end_t, nwog_dayGap.high, str.tostring(nwog_dayGap.high, format.mintick), style = label.style_label_lower_left, xloc = xloc.bar_time, color = color.rgb(0, 0, 0, 100), textcolor = nwog_priceCol, size = nwog_getTextSize(nwog_priceSz)))
                array.push(ndogCELbl, label.new(nwog_dayGap.end_t, ndogCe, str.tostring(ndogCe, format.mintick), style = label.style_label_left, xloc = xloc.bar_time, color = color.rgb(0, 0, 0, 100), textcolor = nwog_priceCol, size = nwog_getTextSize(nwog_priceSz)))
                array.push(ndogLLbl, label.new(nwog_dayGap.end_t, nwog_dayGap.low, str.tostring(nwog_dayGap.low, format.mintick), style = label.style_label_upper_left, xloc = xloc.bar_time, color = color.rgb(0, 0, 0, 100), textcolor = nwog_priceCol, size = nwog_getTextSize(nwog_priceSz)))

            if array.size(ndogArr) > ndogsAmt
                box.delete(array.shift(ndogArr))
                if showNdogCE
                    line.delete(array.shift(ndogCEArr))
                if nwog_showPrice
                    label.delete(array.shift(ndogHLbl))
                    label.delete(array.shift(ndogCELbl))
                    label.delete(array.shift(ndogLLbl))

    if extAllNdogs and array.size(ndogArr) > 0
        for i = 0 to array.size(ndogArr) - 1
            box.set_right(array.get(ndogArr, i), nwog_dayGap.end_t)
            if (showNWOG and dayofweek == dayofweek.sunday and i <= array.size(ndogArr) - 1) or i < array.size(ndogArr) - 1
                box.set_bgcolor(array.get(ndogArr, i), prevNdogBg)
            if showNdogCE
                line.set_x2(array.get(ndogCEArr, i), nwog_dayGap.end_t)
            if nwog_showPrice
                label.set_x(array.get(ndogHLbl, i), nwog_dayGap.end_t)
                label.set_x(array.get(ndogCELbl, i), nwog_dayGap.end_t)
                label.set_x(array.get(ndogLLbl, i), nwog_dayGap.end_t)
