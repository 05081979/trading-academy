// ── Per-HTF inputs (show | timeframe | count | bull_color | bear_color) ──────────

htf1.settings.show         := input.bool(false, 'HTF 1      ', inline='htf1')
htf_1                       = input.timeframe('3',   '', options=['', '1T', '10T', '100T', '1000T', '1S', '5S', '10S', '15S', '30S', '45S', '1', '2', '3', '5', '9', '10', '12', '15', '17', '27', '30', '40', '45', '69', '81', '90', '243', '729', '60', '120', '180', '240', '360', '480', '720', 'D', 'W', 'M', '3M', '6M', '12M'], inline='htf1')
htf1.settings.htf          := htf_1
htf1.settings.max_display  := input.int(30, '', inline='htf1')
htf1.settings.bull_color   := input.color(color.new(color.green,    10), '', inline='htf1')
htf1.settings.bear_color   := input.color(color.new(color.gray,    30), '', inline='htf1')

