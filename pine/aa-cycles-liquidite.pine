// ===== 30 MINUTE SUB-CYCLE BOXES =====
// Chaque 90mn est divise en 3 x 30mn via le calcul q30 (1, 2, 3)
// On detecte le changement de q30 pour creer/reset les boxes
var box tc30_bx = na
var label tc30_lb_cur = na
var float tc30_h = na
var float tc30_l = na
var int tc30_sb = na

// Couleur 30mn selon la session en cours
color _tc30_col = _opHM < 230 or _opHM >= 1800 ? tc30_asia : _opHM < 700 ? tc30_lo : _opHM < 1130 ? tc30_am : _opHM < 1600 ? tc30_pm : tc30_asia

bool _new30 = n30 and tc_gate
if tc30_show and _new30
    tc30_h := high
    tc30_l := low
    tc30_sb := bar_index
    tc30_bx := box.new(bar_index, high, bar_index, low, bgcolor=color.new(_tc30_col, 100 - tc30_op), border_color=tc30_brd, border_width=1)
    if tc30_lbl
        tc30_lb_cur := label.new(bar_index, high, str.tostring(q30) + "/3", style=label.style_label_down, textcolor=color.new(_tc30_col, 20), color=color.new(color.white, 100), size=f_lsz(sz_30))
else if tc30_show and tc_gate and not na(tc30_h)
    tc30_h := math.max(tc30_h, high)
    tc30_l := math.min(tc30_l, low)
    if not na(tc30_bx)
        box.set_top(tc30_bx, tc30_h)
        box.set_bottom(tc30_bx, tc30_l)
        box.set_right(tc30_bx, bar_index)
    if not na(tc30_lb_cur)
        label.set_x(tc30_lb_cur, int(math.avg(tc30_sb, bar_index)))
        label.set_y(tc30_lb_cur, tc30_h)

// EQ du cycle 90mn precedent (base sur time cycles, pas QT)
// Chaque session TC stocke son H/L quand elle se termine -> EQ = (H+L)/2
// On detecte le changement via les tc_bx* : quand une nouvelle box est creee, l'ancienne est finie
// Methode simple : tracker le H/L du cycle TC courant
var float _cur_tc_h = na
var float _cur_tc_l = na
// Detecter quand N'IMPORTE QUEL cycle TC commence (= le precedent vient de finir)
bool _any_tc_start = false
if (tc_s0 and na(tc_hi0[1])) or (tc_s1 and na(tc_hi1[1])) or (tc_s2 and na(tc_hi2[1])) or (tc_s3 and na(tc_hi3[1])) or (tc_s4 and na(tc_hi4[1])) or (tc_s5 and na(tc_hi5[1])) or (tc_s6 and na(tc_hi6[1])) or (tc_s7 and na(tc_hi7[1])) or (tc_s8 and na(tc_hi8[1])) or (tc_s9 and na(tc_hi9[1]))
    _any_tc_start := true
    if not na(_cur_tc_h) and not na(_cur_tc_l)
        _prev_tc_h := _cur_tc_h
        _prev_tc_l := _cur_tc_l
    _cur_tc_h := high
    _cur_tc_l := low
else
    if high > nz(_cur_tc_h)
        _cur_tc_h := high
    if low < nz(_cur_tc_l, 1e10)
        _cur_tc_l := low

if q9_eq and _any_tc_start and not na(_prev_tc_h) and not na(_prev_tc_l)
    line.delete(q9_eq_ln)
    label.delete(q9_eq_lb)
    float eq_price = (_prev_tc_h + _prev_tc_l) / 2
    q9_eq_ln := line.new(bar_index, eq_price, bar_index + 5, eq_price, color=q9_eq_c, style=f_style(q9_eq_s), width=q9_eq_w)
    q9_eq_lb := label.new(bar_index + 5, eq_price, "EQ", style=label.style_none, textcolor=q9_eq_c, size=f_lsz(sz_eq))
if q9_eq and not na(q9_eq_ln)
    line.set_x2(q9_eq_ln, bar_index + 5)
if q9_eq and not na(q9_eq_lb)
    label.set_x(q9_eq_lb, bar_index + 6)

// ===== SESSION TIME FIBS =====
string gFib = "SESSION TIME FIBS"
bool fib_on = input.bool(true, "Enable Time Fibs", group=gFib)

bool fib_s1on = input.bool(true, "Session 1", inline="fs1", group=gFib)
int fib_s1start = input.int(230, "Start", inline="fs1", group=gFib, tooltip="HHMM format NY time (e.g. 230 = 02:30)")
int fib_s1end = input.int(700, "End", inline="fs1", group=gFib)
string fib_s1name = input.string("London", "Name", inline="fs1n", group=gFib)

bool fib_s2on = input.bool(true, "Session 2", inline="fs2", group=gFib)
int fib_s2start = input.int(700, "Start", inline="fs2", group=gFib)
int fib_s2end = input.int(1130, "End", inline="fs2", group=gFib)
string fib_s2name = input.string("NY AM", "Name", inline="fs2n", group=gFib)

bool fib_s3on = input.bool(true, "Session 3", inline="fs3", group=gFib)
int fib_s3start = input.int(1130, "Start", inline="fs3", group=gFib)
int fib_s3end = input.int(1600, "End", inline="fs3", group=gFib)
string fib_s3name = input.string("NY PM", "Name", inline="fs3n", group=gFib)

bool fib_s4on = input.bool(false, "Session 4", inline="fs4", group=gFib)
int fib_s4start = input.int(1800, "Start", inline="fs4", group=gFib)
int fib_s4end = input.int(230, "End", inline="fs4", group=gFib, tooltip="If End < Start, session crosses midnight")
string fib_s4name = input.string("Asia", "Name", inline="fs4n", group=gFib)

string gFibL = "TIME FIBS — LEVELS"
float fib_lv1 = input.float(0.382, "Fib 1", group=gFibL, step=0.001)
float fib_lv2 = input.float(0.625, "Fib 2", group=gFibL, step=0.001)
float fib_lv3 = input.float(0.786, "Fib 3", group=gFibL, step=0.001)
bool fib_show3 = input.bool(true, "Show Fib 3", group=gFibL)

string gFibS = "TIME FIBS — STYLE"
color fib_lineCol = input.color(color.new(#000000, 30), "Lines", group=gFibS, inline="fc1")
color fib_zoneCol = input.color(color.new(#2962FF, 88), "Zone", group=gFibS, inline="fc1")
int fib_lineW = input.int(1, "Width", minval=1, maxval=4, group=gFibS, inline="fw")
string fib_lineSt = input.string("Solid", "", options=["Solid","Dashed","Dotted"], group=gFibS, inline="fw")
bool fib_showLb = input.bool(true, "Labels", group=gFibS, inline="flb")
color fib_labelCol = input.color(color.new(#000000, 20), "", group=gFibS, inline="flb")
bool fib_showName = input.bool(true, "Session Name", group=gFibS, inline="flb")
bool fib_todayOnly = input.bool(false, "Today Only", group=gFibS)

// --- Time Fibs helpers ---
fib_lsty = f_style(fib_lineSt)
bool fib_isToday = dayofmonth(time, TZ) == dayofmonth(timenow, TZ) and month(time, TZ) == month(timenow, TZ) and year(time, TZ) == year(timenow, TZ)

f_fib_inSes(int hmv, int startHM, int endHM) =>
    if endHM > startHM
        hmv >= startHM and hmv < endHM
    else
        hmv >= startHM or hmv < endHM

f_fib_durMin(int startHM, int endHM) =>
    int sMin = math.floor(startHM / 100) * 60 + (startHM % 100)
    int eMin = math.floor(endHM / 100) * 60 + (endHM % 100)
    eMin > sMin ? eMin - sMin : (1440 - sMin) + eMin

bool fib_in1 = f_fib_inSes(hm, fib_s1start, fib_s1end)
bool fib_in2 = f_fib_inSes(hm, fib_s2start, fib_s2end)
bool fib_in3 = f_fib_inSes(hm, fib_s3start, fib_s3end)
bool fib_in4 = f_fib_inSes(hm, fib_s4start, fib_s4end)
bool fib_new1 = fib_in1 and not fib_in1[1]
bool fib_new2 = fib_in2 and not fib_in2[1]
bool fib_new3 = fib_in3 and not fib_in3[1]
bool fib_new4 = fib_in4 and not fib_in4[1]
int fib_dur1 = f_fib_durMin(fib_s1start, fib_s1end)
int fib_dur2 = f_fib_durMin(fib_s2start, fib_s2end)
int fib_dur3 = f_fib_durMin(fib_s3start, fib_s3end)
int fib_dur4 = f_fib_durMin(fib_s4start, fib_s4end)

// --- Time Fibs draw ---
f_fib_draw(bool isNew, bool show, int durMin, string sesName) =>
    var line fl0 = na, var line fl1 = na, var line fl2 = na, var line fl3 = na, var line fl4 = na
    var label flb0 = na, var label flb1 = na, var label flb2 = na, var label flb3 = na, var label flb4 = na
    var label flbName = na
    var box fzone = na
    if isNew and show and fib_on and (not fib_todayOnly or fib_isToday)
        float bF = durMin / timeframe.in_seconds() * 60
        int b1 = int(math.round(bF * fib_lv1))
        int b2 = int(math.round(bF * fib_lv2))
        int b3 = int(math.round(bF * fib_lv3))
        int bE = int(math.round(bF))
        float tp = high + 5000
        float bt = low - 5000
        line.delete(fl0), line.delete(fl1), line.delete(fl2), line.delete(fl3), line.delete(fl4)
        label.delete(flb0), label.delete(flb1), label.delete(flb2), label.delete(flb3), label.delete(flb4), label.delete(flbName)
        box.delete(fzone)
        fl0 := line.new(bar_index, tp, bar_index, bt, color=fib_lineCol, width=fib_lineW, style=fib_lsty)
        fl1 := line.new(bar_index + b1, tp, bar_index + b1, bt, color=fib_lineCol, width=fib_lineW, style=fib_lsty)
        fl2 := line.new(bar_index + b2, tp, bar_index + b2, bt, color=fib_lineCol, width=fib_lineW, style=fib_lsty)
        if fib_show3
            fl3 := line.new(bar_index + b3, tp, bar_index + b3, bt, color=fib_lineCol, width=fib_lineW, style=fib_lsty)
        fl4 := line.new(bar_index + bE, tp, bar_index + bE, bt, color=fib_lineCol, width=fib_lineW, style=fib_lsty)
        fzone := box.new(bar_index + b1, tp, bar_index + b2, bt, border_color=color.new(color.white, 100), bgcolor=fib_zoneCol)
        if fib_showLb
            flb0 := label.new(bar_index, bt, "0", style=label.style_none, textcolor=fib_labelCol, size=size.tiny)
            flb1 := label.new(bar_index + b1, bt, str.tostring(fib_lv1), style=label.style_none, textcolor=fib_labelCol, size=size.tiny)
            flb2 := label.new(bar_index + b2, bt, str.tostring(fib_lv2), style=label.style_none, textcolor=fib_labelCol, size=size.tiny)
            if fib_show3
                flb3 := label.new(bar_index + b3, bt, str.tostring(fib_lv3), style=label.style_none, textcolor=fib_labelCol, size=size.tiny)
            flb4 := label.new(bar_index + bE, bt, "1", style=label.style_none, textcolor=fib_labelCol, size=size.tiny)
        if fib_showName
            int midB = int(math.round(bF * 0.5))
            flbName := label.new(bar_index + midB, tp, sesName, style=label.style_none, textcolor=fib_labelCol, size=size.small)

f_fib_draw(fib_new1, fib_s1on, fib_dur1, fib_s1name)
f_fib_draw(fib_new2, fib_s2on, fib_dur2, fib_s2name)
f_fib_draw(fib_new3, fib_s3on, fib_dur3, fib_s3name)
f_fib_draw(fib_new4, fib_s4on, fib_dur4, fib_s4name)

// ═══════════════════════════════════════
// === CISD DETECTION ===
// ═══════════════════════════════════════
f_find_extreme(int bias) =>
    int shift = 0
    float ext = open
    int att = close > open ? 1 : close < open ? -1 : 0
    if att == 0 or att != bias
        [ext, time]
    else
        for i = 1 to 100
            att := close[i] > open[i] ? 1 : close[i] < open[i] ? -1 : 0
            if att == 0
                continue
            if att != bias
                break
            shift := i
            if bias == 1
                if open[i] < ext
                    ext := open[i]
            else
                if open[i] > ext
                    ext := open[i]
        int extShift = 0
        for k = 0 to shift
            if open[k] == ext
                extShift := k
                break
        [ext, time[extShift]]

f_cisd_detect() =>
    var int _vibes = 0
    var float _entry = na
    var int _entryT = na
    var float _pain = na
    if _vibes == 0 and bar_index > 10
        int first = close > open ? 1 : close < open ? -1 : 0
        if first == 0
            for k = 1 to 50
                first := close[k] > open[k] ? 1 : close[k] < open[k] ? -1 : 0
                if first != 0
                    break
        if first != 0
            _vibes := first
            [p, t] = f_find_extreme(first)
            _entry := p
            _entryT := t
            _pain := first == 1 ? high : low
    if _vibes == 1 and high > _pain
        _pain := high
        [p, t] = f_find_extreme(1)
        _entry := p
        _entryT := t
    else if _vibes == -1 and low < _pain
        _pain := low
        [p, t] = f_find_extreme(-1)
        _entry := p
        _entryT := t
    bool _bullTrig = _vibes == -1 and close > _entry
    bool _bearTrig = _vibes == 1 and close < _entry
    float _trigPrc = na
    int _trigT = na
    if _bullTrig or _bearTrig
        _trigPrc := _entry
        _trigT := nz(_entryT, time)
        int newVibes = _bullTrig ? 1 : -1
        _vibes := newVibes
        [rp, rt] = f_find_extreme(newVibes)
        _entry := rp
        _entryT := rt
        _pain := newVibes == 1 ? high : low
    [_bullTrig, _bearTrig, nz(_trigPrc), int(nz(_trigT, time))]

// CISD MTF
[cb1m,cs1m,cp1m,ct1m] = request.security(syminfo.tickerid,"1",f_cisd_detect())
[cb5m,cs5m,cp5m,ct5m] = request.security(syminfo.tickerid,"5",f_cisd_detect())
[cb15,cs15,cp15,ct15] = request.security(syminfo.tickerid,"15",f_cisd_detect())
[cb30,cs30,cp30,ct30] = request.security(syminfo.tickerid,"30",f_cisd_detect())
[cb1h,cs1h,cp1h,ct1h] = request.security(syminfo.tickerid,"60",f_cisd_detect())
[cb4h,cs4h,cp4h,ct4h] = request.security(syminfo.tickerid,"240",f_cisd_detect())
[cbD,csD,cpD,ctD] = request.security(syminfo.tickerid,"D",f_cisd_detect())

var float[] ci_prc = array.new_float()
var int[] ci_tL = array.new_int()
var int[] ci_bar = array.new_int()
var bool[] ci_bull = array.new_bool()
var string[] ci_lbl = array.new_string()

f_store_cisd(bool bSig, bool sSig, float prc, int trig_time, string lbl) =>
    if bSig and not bSig[1] and not na(prc) and prc > 0
        array.unshift(ci_prc, prc)
        array.unshift(ci_tL, trig_time)
        array.unshift(ci_bar, bar_index)
        array.unshift(ci_bull, true)
        array.unshift(ci_lbl, "+CISD " + lbl)
    if sSig and not sSig[1] and not na(prc) and prc > 0
        array.unshift(ci_prc, prc)
        array.unshift(ci_tL, trig_time)
        array.unshift(ci_bar, bar_index)
        array.unshift(ci_bull, false)
        array.unshift(ci_lbl, "-CISD " + lbl)
    true

if i_cisd_show and i_c1m
    f_store_cisd(cb1m,cs1m,cp1m,ct1m,"1m")
if i_cisd_show and i_c5m
    f_store_cisd(cb5m,cs5m,cp5m,ct5m,"5m")
if i_cisd_show and i_c15
    f_store_cisd(cb15,cs15,cp15,ct15,"15m")
if i_cisd_show and i_c30
    f_store_cisd(cb30,cs30,cp30,ct30,"30m")
if i_cisd_show and i_c1h
    f_store_cisd(cb1h,cs1h,cp1h,ct1h,"1H")
if i_cisd_show and i_c4h
    f_store_cisd(cb4h,cs4h,cp4h,ct4h,"4H")
if i_cisd_show and i_cD
    f_store_cisd(cbD,csD,cpD,ctD,"D")

if array.size(ci_prc) > 0
    for i = array.size(ci_prc) - 1 to 0
        int cb = array.get(ci_bar, i)
        if bar_index > cb + 1
            float lvl = array.get(ci_prc, i)
            bool isBull = array.get(ci_bull, i)
            bool broken = isBull ? close < lvl : close > lvl
            if broken
                array.remove(ci_prc, i)
                array.remove(ci_tL, i)
                array.remove(ci_bar, i)
                array.remove(ci_bull, i)
                array.remove(ci_lbl, i)

while array.size(ci_prc) > i_cisd_max
    array.pop(ci_prc)
    array.pop(ci_tL)
    array.pop(ci_bar)
    array.pop(ci_bull)
    array.pop(ci_lbl)

// ═══════════════════════════════════════
// === MSB + OB PROBABILITY ===
// ═══════════════════════════════════════
f_msb_ob() =>
    float _ph = ta.pivothigh(high, i_msb_pp, i_msb_pp)
    float _pl = ta.pivotlow(low, i_msb_pp, i_msb_pp)
    var float _lph = na
    var float _lpl = na
    var int _lpht = na
    var int _lplt = na
    if not na(_ph)
        _lph := _ph
        _lpht := time[i_msb_pp]
    if not na(_pl)
        _lpl := _pl
        _lplt := time[i_msb_pp]
    float _chg = ta.change(close)
    float _avg = ta.sma(_chg, 50)
    float _std = ta.stdev(_chg, 50)
    float _z = nz(_std) > 0 ? (_chg - _avg) / _std : 0.0
    float _vpct = ta.percentrank(volume, 100)
    bool _bullMSB = not na(_lph) and close > _lph and close[1] <= _lph and _z > i_msb_z
    bool _bearMSB = not na(_lpl) and close < _lpl and close[1] >= _lpl and _z < -i_msb_z
    float _obT = na
    float _obB = na
    int _obTime = na
    float _score = na
    bool _hpz = false
    if _bullMSB or _bearMSB
        int idx = 1
        for i = 1 to 10
            if (_bullMSB and close[i] < open[i]) or (_bearMSB and close[i] > open[i])
                idx := i
                break
        _obT := high[idx]
        _obB := low[idx]
        _obTime := time[idx]
        _score := math.min(100, (math.abs(_z) * 20) + (_vpct * 0.5))
        _hpz := _score > 80
    float _msbLvl = _bullMSB ? _lph : _bearMSB ? _lpl : na
    int _msbLvlT = _bullMSB ? nz(_lpht, time) : _bearMSB ? nz(_lplt, time) : na
    if _bullMSB
        _lph := na
    if _bearMSB
        _lpl := na
    [_bullMSB, _bearMSB, nz(_obT), nz(_obB), nz(_obTime, time), nz(_score), _hpz, nz(_msbLvl), nz(_msbLvlT, time)]

// MSB MTF
[mb1m,ms1m,ot1m,ob1m,oT1m,sc1m,hp1m,ml1m,mT1m] = request.security(syminfo.tickerid,"1",f_msb_ob())
[mb5m,ms5m,ot5m,ob5m,oT5m,sc5m,hp5m,ml5m,mT5m] = request.security(syminfo.tickerid,"5",f_msb_ob())
[mb15,ms15,ot15,ob15,oT15,sc15,hp15,ml15,mT15] = request.security(syminfo.tickerid,"15",f_msb_ob())
[mb30,ms30,ot30,ob30,oT30,sc30,hp30,ml30,mT30] = request.security(syminfo.tickerid,"30",f_msb_ob())
[mb1h,ms1h,ot1h,ob1h,oT1h,sc1h,hp1h,ml1h,mT1h] = request.security(syminfo.tickerid,"60",f_msb_ob())
[mb4h,ms4h,ot4h,ob4h,oT4h,sc4h,hp4h,ml4h,mT4h] = request.security(syminfo.tickerid,"240",f_msb_ob())
[mbD,msD,otD,obD,oTD,scD,hpD,mlD,mTD] = request.security(syminfo.tickerid,"D",f_msb_ob())

var float[] ob_tops = array.new_float()
var float[] ob_bots = array.new_float()
var int[] ob_tms = array.new_int()
var float[] ob_scores = array.new_float()
var bool[] ob_bull = array.new_bool()
var bool[] ob_hpz = array.new_bool()
var bool[] ob_mit = array.new_bool()
var string[] ob_lbl = array.new_string()
var int[] msb_tL = array.new_int()
var int[] msb_tR = array.new_int()
var float[] msb_y = array.new_float()
var bool[] msb_dir = array.new_bool()

f_store_msb(bool bSig, bool sSig, float oT, float oB, int oTime, float sc, bool hpz, float mLvl, int mTime, string lbl) =>
    bool isBull = bSig and not bSig[1]
    bool isBear = sSig and not sSig[1]
    if (isBull or isBear) and not na(oT) and oT > 0
        array.unshift(ob_tops, oT)
        array.unshift(ob_bots, oB)
        array.unshift(ob_tms, oTime)
        array.unshift(ob_scores, sc)
        array.unshift(ob_bull, isBull)
        array.unshift(ob_hpz, hpz)
        array.unshift(ob_mit, false)
        array.unshift(ob_lbl, (isBull ? "OB+ " : "OB- ") + lbl)
        if not na(mLvl)
            array.unshift(msb_tL, mTime)
            array.unshift(msb_tR, time)
            array.unshift(msb_y, mLvl)
            array.unshift(msb_dir, isBull)
    true

if i_msb_show and i_m1m
    f_store_msb(mb1m,ms1m,ot1m,ob1m,oT1m,sc1m,hp1m,ml1m,mT1m,"1m")
if i_msb_show and i_m5m
    f_store_msb(mb5m,ms5m,ot5m,ob5m,oT5m,sc5m,hp5m,ml5m,mT5m,"5m")
if i_msb_show and i_m15
    f_store_msb(mb15,ms15,ot15,ob15,oT15,sc15,hp15,ml15,mT15,"15m")
if i_msb_show and i_m30
    f_store_msb(mb30,ms30,ot30,ob30,oT30,sc30,hp30,ml30,mT30,"30m")
if i_msb_show and i_m1h
    f_store_msb(mb1h,ms1h,ot1h,ob1h,oT1h,sc1h,hp1h,ml1h,mT1h,"1H")
if i_msb_show and i_m4h
    f_store_msb(mb4h,ms4h,ot4h,ob4h,oT4h,sc4h,hp4h,ml4h,mT4h,"4H")
if i_msb_show and i_mD
    f_store_msb(mbD,msD,otD,obD,oTD,scD,hpD,mlD,mTD,"D")

if array.size(ob_tops) > 0
    for i = array.size(ob_tops) - 1 to 0
        if not array.get(ob_mit, i)
            if array.get(ob_bull, i) ? low < array.get(ob_bots, i) : high > array.get(ob_tops, i)
                array.set(ob_mit, i, true)

while array.size(ob_tops) > i_msb_max
    array.pop(ob_tops)
    array.pop(ob_bots)
    array.pop(ob_tms)
    array.pop(ob_scores)
    array.pop(ob_bull)
    array.pop(ob_hpz)
    array.pop(ob_mit)
    array.pop(ob_lbl)
while array.size(msb_tL) > 30
    array.pop(msb_tL)
    array.pop(msb_tR)
    array.pop(msb_y)
    array.pop(msb_dir)

// ═══════════════════════════════════════
// === CISD + MSB OB DRAWING ===
// ═══════════════════════════════════════
var array<line>  _cisd_lines  = array.new<line>()
var array<label> _cisd_labels = array.new<label>()
var array<line>  _msb_lines   = array.new<line>()
var array<label> _msb_labels  = array.new<label>()
var array<box>   _msb_boxes   = array.new<box>()

if barstate.islast
    // Cleanup CISD
    for ln in _cisd_lines
        line.delete(ln)
    _cisd_lines.clear()
    for lb in _cisd_labels
        label.delete(lb)
    _cisd_labels.clear()
    // Cleanup MSB
    for ln in _msb_lines
        line.delete(ln)
    _msb_lines.clear()
    for lb in _msb_labels
        label.delete(lb)
    _msb_labels.clear()
    for bx in _msb_boxes
        box.delete(bx)
    _msb_boxes.clear()

    // CISD Levels
    if i_cisd_show and array.size(ci_prc) > 0
        for i = 0 to array.size(ci_prc) - 1
            float cp = array.get(ci_prc, i)
            int ct = array.get(ci_tL, i)
            bool cib = array.get(ci_bull, i)
            string cl = array.get(ci_lbl, i)
            color cc = cib ? i_cisd_bull_c : i_cisd_bear_c
            _cisd_lines.push(line.new(ct, cp, time + 5 * (time - nz(time[1], time - 1)), cp, xloc=xloc.bar_time, color=cc, width=i_cisd_w, style=line.style_solid))
            _cisd_labels.push(label.new(time + 5 * (time - nz(time[1], time - 1)), cp, cl, xloc=xloc.bar_time, color=color(na), textcolor=cc, style=label.style_label_left, size=f_lsz(i_cisd_sz)))

    // MSB + OB Probability
    if i_msb_show
        int _tExt = time + 15 * (time - nz(time[1], time - 1))
        for i = 0 to math.max(array.size(msb_tL) - 1, 0)
            if i < array.size(msb_tL)
                bool mb = array.get(msb_dir, i)
                color mc = mb ? i_msb_bull_c : i_msb_bear_c
                int mL = array.get(msb_tL, i)
                int mR = array.get(msb_tR, i)
                float my = array.get(msb_y, i)
                _msb_lines.push(line.new(mL, my, mR, my, xloc=xloc.bar_time, color=mc, width=1))
                _msb_labels.push(label.new(int(math.avg(mL, mR)), my, "MSB", xloc=xloc.bar_time, color=color(na), textcolor=mc, style=mb ? label.style_label_down : label.style_label_up, size=size.tiny))
        for i = 0 to math.max(array.size(ob_tops) - 1, 0)
            if i < array.size(ob_tops)
                float ot = array.get(ob_tops, i)
                float obt = array.get(ob_bots, i)
                int oTm = array.get(ob_tms, i)
                float sc = array.get(ob_scores, i)
                bool bull = array.get(ob_bull, i)
                bool hpz = array.get(ob_hpz, i)
                bool mit = array.get(ob_mit, i)
                string ol = array.get(ob_lbl, i)
                color base_c = bull ? i_msb_bull_c : i_msb_bear_c
                color hpz_c = bull ? i_msb_hpz_bull : i_msb_hpz_bear
                color ob_c = mit ? color.new(color.gray, 90) : hpz ? color.new(hpz_c, 80) : color.new(base_c, 85)
                color ob_bc = mit ? color.new(color.gray, 70) : hpz ? color.new(hpz_c, 40) : color.new(base_c, 60)
                color txt_c = mit ? color.new(color.gray, 50) : hpz ? hpz_c : base_c
                int rTm = mit ? oTm + 15 * (time - nz(time[1], time - 1)) : _tExt
                _msb_boxes.push(box.new(oTm, ot, rTm, obt, xloc=xloc.bar_time, border_color=ob_bc, bgcolor=ob_c, border_style=line.style_dashed, border_width=1, text=ol + " " + str.tostring(sc, "#") + "%", text_size=f_lsz(i_bx_txt_sz), text_color=txt_c, text_halign=text.align_right))
                float poc = (ot + obt) / 2
                _msb_lines.push(line.new(oTm, poc, rTm, poc, xloc=xloc.bar_time, color=color.new(txt_c, 40), style=line.style_dashed, width=1))

// ═══════════════════════════════════════
// === HIPPO BLOCKS MTF ===
// ═══════════════════════════════════════

hippo_extendBox       = input.int(10, "Extend boxes (barres HTF)", group = "HIPPO")
hippo_showGreaterThen = input.float(0.01, "Taille min (% corps)", group = "HIPPO")

hippo_show15m = input.bool(true,  "HIPPO 15m",   group = "HIPPO Timeframes", inline = "htf1")
hippo_col15m  = input.color(color.new(#2196F3, 65), "", group = "HIPPO Timeframes", inline = "htf1")
hippo_show30m = input.bool(false, "HIPPO 30m",   group = "HIPPO Timeframes", inline = "htf2")
hippo_col30m  = input.color(color.new(#9C27B0, 65), "", group = "HIPPO Timeframes", inline = "htf2")
hippo_show1h  = input.bool(true,  "HIPPO 1H",    group = "HIPPO Timeframes", inline = "htf3")
hippo_col1h   = input.color(color.new(#FF9800, 65), "", group = "HIPPO Timeframes", inline = "htf3")
hippo_show4h  = input.bool(false, "HIPPO 4H",    group = "HIPPO Timeframes", inline = "htf4")
hippo_col4h   = input.color(color.new(#F44336, 65), "", group = "HIPPO Timeframes", inline = "htf4")
hippo_showD   = input.bool(false, "HIPPO Daily", group = "HIPPO Timeframes", inline = "htf5")
hippo_colD    = input.color(color.new(#795548, 65), "", group = "HIPPO Timeframes", inline = "htf5")

hippo_detect() =>
    isGreen  = open[1] < close[1] and open[2] < close[2] and low > high[2] and low[1] > high[3]
    isRed    = open[1] > close[1] and open[2] > close[2] and high < low[2] and high[1] < low[3]
    sizeOkG  = (high[2] - low[1]) > ((low[1]  / 100) * hippo_showGreaterThen)
    sizeOkR  = (high[1] - low[2]) > ((high[1] / 100) * hippo_showGreaterThen)
    greenSig = isGreen and sizeOkG and barstate.isconfirmed
    redSig   = isRed   and sizeOkR and barstate.isconfirmed
    extendMs = hippo_extendBox * timeframe.in_seconds() * 1000
    [greenSig, redSig, high[2], low[1], high[1], low[2], time[2], time[0] + extendMs]

[hippo_g15, hippo_r15, hippo_gt15, hippo_gb15, hippo_rt15, hippo_rb15, hippo_tL15, hippo_tR15] = request.security(syminfo.tickerid, "15",  hippo_detect())
[hippo_g30, hippo_r30, hippo_gt30, hippo_gb30, hippo_rt30, hippo_rb30, hippo_tL30, hippo_tR30] = request.security(syminfo.tickerid, "30",  hippo_detect())
[hippo_g1h, hippo_r1h, hippo_gt1h, hippo_gb1h, hippo_rt1h, hippo_rb1h, hippo_tL1h, hippo_tR1h] = request.security(syminfo.tickerid, "60",  hippo_detect())
[hippo_g4h, hippo_r4h, hippo_gt4h, hippo_gb4h, hippo_rt4h, hippo_rb4h, hippo_tL4h, hippo_tR4h] = request.security(syminfo.tickerid, "240", hippo_detect())
[hippo_gD,  hippo_rD,  hippo_gtD,  hippo_gbD,  hippo_rtD,  hippo_rbD,  hippo_tLD,  hippo_tRD]  = request.security(syminfo.tickerid, "D",   hippo_detect())

hippo_draw(sig_g, sig_r, gTop, gBot, rTop, rBot, tLeft, tRight, bgCol, lbl) =>
    var box b = na
    if sig_g and not sig_g[1]
        b := box.new(int(tLeft), gTop, int(tRight), gBot,
             xloc         = xloc.bar_time,
             border_color = na,
             bgcolor      = bgCol,
             text         = lbl,
             text_size    = size.tiny,
             text_color   = color.new(bgCol, 0),
             text_halign  = text.align_right)
    if sig_r and not sig_r[1]
        b := box.new(int(tLeft), rTop, int(tRight), rBot,
             xloc         = xloc.bar_time,
             border_color = na,
             bgcolor      = bgCol,
             text         = lbl,
             text_size    = size.tiny,
             text_color   = color.new(bgCol, 0),
             text_halign  = text.align_right)

if hippo_show15m
    hippo_draw(hippo_g15, hippo_r15, hippo_gt15, hippo_gb15, hippo_rt15, hippo_rb15, hippo_tL15, hippo_tR15, hippo_col15m, "H 15m")
if hippo_show30m
    hippo_draw(hippo_g30, hippo_r30, hippo_gt30, hippo_gb30, hippo_rt30, hippo_rb30, hippo_tL30, hippo_tR30, hippo_col30m, "H 30m")
if hippo_show1h
    hippo_draw(hippo_g1h, hippo_r1h, hippo_gt1h, hippo_gb1h, hippo_rt1h, hippo_rb1h, hippo_tL1h, hippo_tR1h, hippo_col1h,  "H 1H")
if hippo_show4h
    hippo_draw(hippo_g4h, hippo_r4h, hippo_gt4h, hippo_gb4h, hippo_rt4h, hippo_rb4h, hippo_tL4h, hippo_tR4h, hippo_col4h,  "H 4H")
if hippo_showD
    hippo_draw(hippo_gD,  hippo_rD,  hippo_gtD,  hippo_gbD,  hippo_rtD,  hippo_rbD,  hippo_tLD,  hippo_tRD,  hippo_colD,   "H D")
