type CL
    array<box> bx
    array<label> lb
    float h
    float l
    float ph
    float pl
    int cap
    int hx
    int lx
    int phx
    int plx
type LQ
    line ln
    label lb
    float price
    bool is_high
    bool swept
    color col
    int sbar
    int stime

