// © AA — MSB/OB + HIPPO + BPR + Multi-HTF FVG/BPR (sans CISD)
//@version=6
indicator("Algorithmic Academy - Smart Money Toolkit", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500, max_bars_back=5000)
// Note: max_boxes_count limité à 500 par TradingView. Au-delà, TV supprime automatiquement les plus anciennes.

// ═══════════════════════════════════════
// === SHARED HELPERS ===
// ═══════════════════════════════════════
f_lsz(string s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Large" ? size.large : s == "Huge" ? size.huge : size.normal

// ═══════════════════════════════════════
// === MSB OB INPUTS ===
// ═══════════════════════════════════════
i_msb_show=input.bool(true,"Show MSB + OB",group="[MSB OB]")
i_msb_pp=input.int(7,"Pivot Lookback",minval=1,maxval=30,group="[MSB OB]")
i_msb_z=input.float(0.5,"MSB Momentum Z-Score",minval=0.1,step=0.1,group="[MSB OB]")
i_msb_max=input.int(15,"Max Active OBs",minval=1,maxval=50,group="[MSB OB]")
i_msb_bull_c=input.color(#089981,"Bullish OB",group="[MSB OB]",inline="mc1")
i_msb_bear_c=input.color(#f23645,"Bearish OB",group="[MSB OB]",inline="mc1")
i_msb_hpz_bull=input.color(#1de9b6,"HPZ Bull",group="[MSB OB]",inline="mc2")
i_msb_hpz_bear=input.color(#ff5252,"HPZ Bear",group="[MSB OB]",inline="mc2")
i_bx_txt_sz=input.string("Tiny","OB Text Size",options=["Tiny","Small","Normal","Large","Huge"],group="[MSB OB]")
i_m1m=input.bool(false,"1m",group="[MSB OB] TF",inline="mt0")
i_m5m=input.bool(false,"5m",group="[MSB OB] TF",inline="mt0")
i_m15=input.bool(true,"15m",group="[MSB OB] TF",inline="mt1")
i_m30=input.bool(false,"30m",group="[MSB OB] TF",inline="mt1")
i_m1h=input.bool(true,"1H",group="[MSB OB] TF",inline="mt2")
i_m4h=input.bool(false,"4H",group="[MSB OB] TF",inline="mt2")
i_mD=input.bool(false,"Daily",group="[MSB OB] TF",inline="mt3")

// ═══════════════════════════════════════
// === MSB + OB PROBABILITY ===
// ═══════════════════════════════════════
f_msb_ob() =>
    float _ph = ta.pivothigh(high, i_msb_pp, i_msb_pp)
    float _pl = ta.pivotlow(low, i_msb_pp, i_msb_pp)
    var float _lph = na
    var float _lpl = na
    var int _lpht = na
    var int _lplt = na
    if not na(_ph)
        _lph := _ph
        _lpht := time[i_msb_pp]
    if not na(_pl)
        _lpl := _pl
        _lplt := time[i_msb_pp]
    float _chg = ta.change(close)
    float _avg = ta.sma(_chg, 50)
    float _std = ta.stdev(_chg, 50)
    float _z = nz(_std) > 0 ? (_chg - _avg) / _std : 0.0
    float _vpct = ta.percentrank(volume, 100)
    bool _bullMSB = not na(_lph) and close > _lph and close[1] <= _lph and _z > i_msb_z
    bool _bearMSB = not na(_lpl) and close < _lpl and close[1] >= _lpl and _z < -i_msb_z
    float _obT = na
    float _obB = na
    int _obTime = na
    float _score = na
    bool _hpz = false
    if _bullMSB or _bearMSB
        int idx = 1
        for i = 1 to 10
            if (_bullMSB and close[i] < open[i]) or (_bearMSB and close[i] > open[i])
                idx := i
                break
        _obT := high[idx]
        _obB := low[idx]
        _obTime := time[idx]
        _score := math.min(100, (math.abs(_z) * 20) + (_vpct * 0.5))
        _hpz := _score > 80
    float _msbLvl = _bullMSB ? _lph : _bearMSB ? _lpl : na
    int _msbLvlT = _bullMSB ? nz(_lpht, time) : _bearMSB ? nz(_lplt, time) : na
    if _bullMSB
        _lph := na
    if _bearMSB
        _lpl := na
    [_bullMSB, _bearMSB, nz(_obT), nz(_obB), nz(_obTime, time), nz(_score), _hpz, nz(_msbLvl), nz(_msbLvlT, time)]

// MSB MTF
[mb1m,ms1m,ot1m,ob1m,oT1m,sc1m,hp1m,ml1m,mT1m] = request.security(syminfo.tickerid,"1",f_msb_ob())
[mb5m,ms5m,ot5m,ob5m,oT5m,sc5m,hp5m,ml5m,mT5m] = request.security(syminfo.tickerid,"5",f_msb_ob())
[mb15,ms15,ot15,ob15,oT15,sc15,hp15,ml15,mT15] = request.security(syminfo.tickerid,"15",f_msb_ob())
[mb30,ms30,ot30,ob30,oT30,sc30,hp30,ml30,mT30] = request.security(syminfo.tickerid,"30",f_msb_ob())
[mb1h,ms1h,ot1h,ob1h,oT1h,sc1h,hp1h,ml1h,mT1h] = request.security(syminfo.tickerid,"60",f_msb_ob())
[mb4h,ms4h,ot4h,ob4h,oT4h,sc4h,hp4h,ml4h,mT4h] = request.security(syminfo.tickerid,"240",f_msb_ob())
[mbD,msD,otD,obD,oTD,scD,hpD,mlD,mTD] = request.security(syminfo.tickerid,"D",f_msb_ob())

var float[] ob_tops = array.new_float()
var float[] ob_bots = array.new_float()
var int[] ob_tms = array.new_int()
var float[] ob_scores = array.new_float()
var bool[] ob_bull = array.new_bool()
var bool[] ob_hpz = array.new_bool()
var bool[] ob_mit = array.new_bool()
var string[] ob_lbl = array.new_string()
var int[] msb_tL = array.new_int()
var int[] msb_tR = array.new_int()
var float[] msb_y = array.new_float()
var bool[] msb_dir = array.new_bool()

f_store_msb(bool bSig, bool sSig, float oT, float oB, int oTime, float sc, bool hpz, float mLvl, int mTime, string lbl) =>
    bool isBull = bSig and not bSig[1]
    bool isBear = sSig and not sSig[1]
    if (isBull or isBear) and not na(oT) and oT > 0
        array.unshift(ob_tops, oT)
        array.unshift(ob_bots, oB)
        array.unshift(ob_tms, oTime)
        array.unshift(ob_scores, sc)
        array.unshift(ob_bull, isBull)
        array.unshift(ob_hpz, hpz)
        array.unshift(ob_mit, false)
        array.unshift(ob_lbl, (isBull ? "OB+ " : "OB- ") + lbl)
        if not na(mLvl)
            array.unshift(msb_tL, mTime)
            array.unshift(msb_tR, time)
            array.unshift(msb_y, mLvl)
            array.unshift(msb_dir, isBull)
    true

if i_msb_show and i_m1m
    f_store_msb(mb1m,ms1m,ot1m,ob1m,oT1m,sc1m,hp1m,ml1m,mT1m,"1m")
if i_msb_show and i_m5m
    f_store_msb(mb5m,ms5m,ot5m,ob5m,oT5m,sc5m,hp5m,ml5m,mT5m,"5m")
if i_msb_show and i_m15
    f_store_msb(mb15,ms15,ot15,ob15,oT15,sc15,hp15,ml15,mT15,"15m")
if i_msb_show and i_m30
    f_store_msb(mb30,ms30,ot30,ob30,oT30,sc30,hp30,ml30,mT30,"30m")
if i_msb_show and i_m1h
    f_store_msb(mb1h,ms1h,ot1h,ob1h,oT1h,sc1h,hp1h,ml1h,mT1h,"1H")
if i_msb_show and i_m4h
    f_store_msb(mb4h,ms4h,ot4h,ob4h,oT4h,sc4h,hp4h,ml4h,mT4h,"4H")
if i_msb_show and i_mD
    f_store_msb(mbD,msD,otD,obD,oTD,scD,hpD,mlD,mTD,"D")

if array.size(ob_tops) > 0
    for i = array.size(ob_tops) - 1 to 0
        if not array.get(ob_mit, i)
            if array.get(ob_bull, i) ? low < array.get(ob_bots, i) : high > array.get(ob_tops, i)
                array.set(ob_mit, i, true)

while array.size(ob_tops) > i_msb_max
    array.pop(ob_tops)
    array.pop(ob_bots)
    array.pop(ob_tms)
    array.pop(ob_scores)
    array.pop(ob_bull)
    array.pop(ob_hpz)
    array.pop(ob_mit)
    array.pop(ob_lbl)
while array.size(msb_tL) > 30
    array.pop(msb_tL)
    array.pop(msb_tR)
    array.pop(msb_y)
    array.pop(msb_dir)

// ═══════════════════════════════════════
// === MSB OB DRAWING ===
// ═══════════════════════════════════════
var array<line>  _msb_lines   = array.new<line>()
var array<label> _msb_labels  = array.new<label>()
var array<box>   _msb_boxes   = array.new<box>()

if barstate.islast
    for ln in _msb_lines
        line.delete(ln)
    _msb_lines.clear()
    for lb in _msb_labels
        label.delete(lb)
    _msb_labels.clear()
    for bx in _msb_boxes
        box.delete(bx)
    _msb_boxes.clear()

    // MSB + OB Probability
    if i_msb_show
        int _tExt = time + 15 * (time - nz(time[1], time - 1))
        for i = 0 to math.max(array.size(msb_tL) - 1, 0)
            if i < array.size(msb_tL)
                bool mb = array.get(msb_dir, i)
                color mc = mb ? i_msb_bull_c : i_msb_bear_c
                int mL = array.get(msb_tL, i)
                int mR = array.get(msb_tR, i)
                float my = array.get(msb_y, i)
                _msb_lines.push(line.new(mL, my, mR, my, xloc=xloc.bar_time, color=mc, width=1))
                _msb_labels.push(label.new(int(math.avg(mL, mR)), my, "MSB", xloc=xloc.bar_time, color=color(na), textcolor=mc, style=mb ? label.style_label_down : label.style_label_up, size=size.tiny))
        for i = 0 to math.max(array.size(ob_tops) - 1, 0)
            if i < array.size(ob_tops)
                float ot = array.get(ob_tops, i)
                float obt = array.get(ob_bots, i)
                int oTm = array.get(ob_tms, i)
                float sc = array.get(ob_scores, i)
                bool bull = array.get(ob_bull, i)
                bool hpz = array.get(ob_hpz, i)
                bool mit = array.get(ob_mit, i)
                string ol = array.get(ob_lbl, i)
                color base_c = bull ? i_msb_bull_c : i_msb_bear_c
                color hpz_c = bull ? i_msb_hpz_bull : i_msb_hpz_bear
                color ob_c = mit ? color.new(color.gray, 90) : hpz ? color.new(hpz_c, 80) : color.new(base_c, 85)
                color ob_bc = mit ? color.new(color.gray, 70) : hpz ? color.new(hpz_c, 40) : color.new(base_c, 60)
                color txt_c = mit ? color.new(color.gray, 50) : hpz ? hpz_c : base_c
                int rTm = mit ? oTm + 15 * (time - nz(time[1], time - 1)) : _tExt
                _msb_boxes.push(box.new(oTm, ot, rTm, obt, xloc=xloc.bar_time, border_color=ob_bc, bgcolor=ob_c, border_style=line.style_dashed, border_width=1, text=ol + " " + str.tostring(sc, "#") + "%", text_size=f_lsz(i_bx_txt_sz), text_color=txt_c, text_halign=text.align_right))
                float poc = (ot + obt) / 2
                _msb_lines.push(line.new(oTm, poc, rTm, poc, xloc=xloc.bar_time, color=color.new(txt_c, 40), style=line.style_dashed, width=1))

// ═══════════════════════════════════════
// === HIPPO BLOCKS MTF ===
// ═══════════════════════════════════════
hippo_extendBox       = input.int(10, "Extend boxes (barres HTF)", group = "HIPPO")
hippo_showGreaterThen = input.float(0.01, "Taille min (% corps)", group = "HIPPO")

hippo_show15m = input.bool(true,  "HIPPO 15m",   group = "HIPPO Timeframes", inline = "htf1")
hippo_col15m  = input.color(color.new(#2196F3, 65), "", group = "HIPPO Timeframes", inline = "htf1")
hippo_show30m = input.bool(false, "HIPPO 30m",   group = "HIPPO Timeframes", inline = "htf2")
hippo_col30m  = input.color(color.new(#9C27B0, 65), "", group = "HIPPO Timeframes", inline = "htf2")
hippo_show1h  = input.bool(true,  "HIPPO 1H",    group = "HIPPO Timeframes", inline = "htf3")
hippo_col1h   = input.color(color.new(#FF9800, 65), "", group = "HIPPO Timeframes", inline = "htf3")
hippo_show4h  = input.bool(false, "HIPPO 4H",    group = "HIPPO Timeframes", inline = "htf4")
hippo_col4h   = input.color(color.new(#F44336, 65), "", group = "HIPPO Timeframes", inline = "htf4")
hippo_showD   = input.bool(false, "HIPPO Daily", group = "HIPPO Timeframes", inline = "htf5")
hippo_colD    = input.color(color.new(#795548, 65), "", group = "HIPPO Timeframes", inline = "htf5")

hippo_detect() =>
    isGreen  = open[1] < close[1] and open[2] < close[2] and low > high[2] and low[1] > high[3]
    isRed    = open[1] > close[1] and open[2] > close[2] and high < low[2] and high[1] < low[3]
    sizeOkG  = (high[2] - low[1]) > ((low[1]  / 100) * hippo_showGreaterThen)
    sizeOkR  = (high[1] - low[2]) > ((high[1] / 100) * hippo_showGreaterThen)
    greenSig = isGreen and sizeOkG and barstate.isconfirmed
    redSig   = isRed   and sizeOkR and barstate.isconfirmed
    extendMs = hippo_extendBox * timeframe.in_seconds() * 1000
    [greenSig, redSig, high[2], low[1], high[1], low[2], time[2], time[0] + extendMs]

[hippo_g15, hippo_r15, hippo_gt15, hippo_gb15, hippo_rt15, hippo_rb15, hippo_tL15, hippo_tR15] = request.security(syminfo.tickerid, "15",  hippo_detect())
[hippo_g30, hippo_r30, hippo_gt30, hippo_gb30, hippo_rt30, hippo_rb30, hippo_tL30, hippo_tR30] = request.security(syminfo.tickerid, "30",  hippo_detect())
[hippo_g1h, hippo_r1h, hippo_gt1h, hippo_gb1h, hippo_rt1h, hippo_rb1h, hippo_tL1h, hippo_tR1h] = request.security(syminfo.tickerid, "60",  hippo_detect())
[hippo_g4h, hippo_r4h, hippo_gt4h, hippo_gb4h, hippo_rt4h, hippo_rb4h, hippo_tL4h, hippo_tR4h] = request.security(syminfo.tickerid, "240", hippo_detect())
[hippo_gD,  hippo_rD,  hippo_gtD,  hippo_gbD,  hippo_rtD,  hippo_rbD,  hippo_tLD,  hippo_tRD]  = request.security(syminfo.tickerid, "D",   hippo_detect())

hippo_draw(sig_g, sig_r, gTop, gBot, rTop, rBot, tLeft, tRight, bgCol, lbl) =>
    var box b = na
    if sig_g and not sig_g[1]
        b := box.new(int(tLeft), gTop, int(tRight), gBot, xloc=xloc.bar_time, border_color=na, bgcolor=bgCol, text=lbl, text_size=size.tiny, text_color=color.new(bgCol, 0), text_halign=text.align_right)
    if sig_r and not sig_r[1]
        b := box.new(int(tLeft), rTop, int(tRight), rBot, xloc=xloc.bar_time, border_color=na, bgcolor=bgCol, text=lbl, text_size=size.tiny, text_color=color.new(bgCol, 0), text_halign=text.align_right)

if hippo_show15m
    hippo_draw(hippo_g15, hippo_r15, hippo_gt15, hippo_gb15, hippo_rt15, hippo_rb15, hippo_tL15, hippo_tR15, hippo_col15m, "H 15m")
if hippo_show30m
    hippo_draw(hippo_g30, hippo_r30, hippo_gt30, hippo_gb30, hippo_rt30, hippo_rb30, hippo_tL30, hippo_tR30, hippo_col30m, "H 30m")
if hippo_show1h
    hippo_draw(hippo_g1h, hippo_r1h, hippo_gt1h, hippo_gb1h, hippo_rt1h, hippo_rb1h, hippo_tL1h, hippo_tR1h, hippo_col1h,  "H 1H")
if hippo_show4h
    hippo_draw(hippo_g4h, hippo_r4h, hippo_gt4h, hippo_gb4h, hippo_rt4h, hippo_rb4h, hippo_tL4h, hippo_tR4h, hippo_col4h,  "H 4H")
if hippo_showD
    hippo_draw(hippo_gD,  hippo_rD,  hippo_gtD,  hippo_gbD,  hippo_rtD,  hippo_rbD,  hippo_tLD,  hippo_tRD,  hippo_colD,   "H D")

// ═══════════════════════════════════════
// === iFVG (BPR) — Algoryze ===
// ═══════════════════════════════════════
General_settings  = 'General settings'
tmf               = input.timeframe("","Timeframe", group = General_settings)
fvg_usewidth      = true
fvg_gapwidth      = 0.009
fvg_method        = '%'

mitgationTypeWick = input.string("Wick","Mitigation Type",options = ["Wick","Close"],inline = "mitper", group = General_settings) == "Wick"
mitgPer           = input.int(50,"Mitigation %",minval = 1,maxval = 100,inline = "mitper",step = 10, group = General_settings)

FVG_settings      = 'FVG settings'
fvgStyle          = input.string(line.style_dotted,"FVG Style",options = [line.style_solid,line.style_dotted,line.style_dashed], group = FVG_settings)
fvgLabl           = input.string(size.small,"Lable Size",options = [size.auto,size.tiny,size.normal,size.small,size.large], group = General_settings)

BPR_settings      = 'BPR settings'
bprStyle          = input.string(line.style_solid,"BPR Style",options = [line.style_solid,line.style_dotted,line.style_dashed], group = BPR_settings)
showhist          = false

numFVG            = input.int(2,"FVG Count", group = FVG_settings)
numBRB            = input.int(2,"BPR Count", group = BPR_settings)

Style_settings    = 'Color settings'
styleOption       = input.string("TLAB colors",  title = "Style:     ",  options = ["TLAB colors", "standart colors", "Monochrome black BG", "Monochrome grey BG", "Custom"], inline = 'h5', group = Style_settings)
Custom_S          = input.color (color.rgb(0, 4, 255) , 'Custom color ', group = Style_settings)

// Couleurs FVG/BPR personnalisables (priment sur styleOption si activees)
useCustomBoxColors = input.bool(true, "Use Custom Box Colors", group = Style_settings, tooltip = "Override style preset with dedicated Bull/Bear box colors")
bullBoxColor       = input.color(color.new(#00d451, 0), "Bull Box Color", inline = "bx", group = Style_settings)
bearBoxColor       = input.color(color.new(color.red, 0), "Bear Box Color", inline = "bx", group = Style_settings)

colorHigh = useCustomBoxColors ? bearBoxColor :
          styleOption == "TLAB colors"           ? #9c9c9c   :
          styleOption   == "standart colors"       ? color.red :
          styleOption   == "Monochrome grey BG"    ? #000000   :
          styleOption   == "Monochrome black BG"   ? #9c9c9c   :
          styleOption   == "Custom"                ? Custom_S    : na

colorLow = useCustomBoxColors ? bullBoxColor :
          styleOption == "TLAB colors"           ? #9c9c9c :
          styleOption  == "standart colors"       ? #00d451 :
          styleOption  == "Monochrome grey BG"    ? #000000 :
          styleOption  == "Monochrome black BG"   ? #9c9c9c :
          styleOption  == "Custom"                ? Custom_S  :na

imbalance_detection(top, btm, condition,atr) =>
    var is_width = true
    if fvg_usewidth
        dist = top - btm
        is_width := switch fvg_method
            'Points' => dist > fvg_gapwidth
            '%' => dist / btm * 100 > fvg_gapwidth
        is_width
    is_true = condition and is_width
    is_true

type fvgDetails
    int   Type = 0
    float Top = na
    float Btm = na
    int   left = na
    int   left2 = na
    int   right = na
    int   cnt = 0
    color   fvgClr=na

getFVG() =>
    atr = ta.atr(200)
    fvgDetails fd = fvgDetails.new()
    isFvgBull = imbalance_detection(low, high[2], low  > high[2] and close[1] > high[2],atr)
    isFvgBear = imbalance_detection(low[2], high, high < low[2]  and close[1] < low[2] ,atr)
    if  isFvgBull
        fd.Type     := 1
        fd.Top      := low
        fd.Btm      := high[2]
        fd.left     := time
        fd.left2    := time[2]
        fd.right    := time
        fd.fvgClr   := colorLow
    if  isFvgBear
        fd.Type  := -1
        fd.Top   := low[2]
        fd.Btm   := high
        fd.left  := time[2]
        fd.left2 := time
        fd.right := time
        fd.fvgClr   := colorHigh
    [fd,open, close,high,low,high[1],low[1],close[1]]

[fd,open_, close_,high_,low_,high_p,low_p,close_p] = request.security(syminfo.tickerid,tmf, getFVG())

var arrFVDD = array.new<fvgDetails>(0)
var arrFVDDType = array.new_bool(0)
var arrFVDBox    = array.new_box(0)
var arrFVDLblTop = array.new_label(0)

if  arrFVDBox.size() > numFVG
    arrFVDBox.pop().delete()
    arrFVDLblTop.pop().delete()
    arrFVDDType.pop()

var arrFVD_BPR = array.new<fvgDetails>(0)
var arrFVD_BPRBox = array.new_box(0)

if arrFVD_BPRBox.size() > numBRB
    arrFVD_BPRBox.pop().delete()
    arrFVD_BPR.pop()

addtimt = 5*(time[1] - time[2])
if open_ != open_[1]
    isBPR = false
    if not na(fd) and not na(fd[1])
        if arrFVDD.size() > 0  and (fd.Type == 1 or fd.Type == -1)
            i = 0
            while i < arrFVDD.size()
                odlfd = arrFVDD.get(i)
                c1 =  fd.Top <= odlfd.Top and fd.Btm >= odlfd.Btm
                c2 = fd.Top <= odlfd.Top and fd.Top > odlfd.Btm  and fd.Btm < odlfd.Btm
                c3 = fd.Top > odlfd.Top and fd.Btm >= odlfd.Btm and fd.Btm < odlfd.Top
                c4 = fd.Top >= odlfd.Top and fd.Btm <= odlfd.Btm
                if c1 or c2 or c3 or c4
                    top_ = fd.Top
                    btm_ = fd.Btm
                    bleft_ = odlfd.left
                    if c2
                        top_ := fd.Top
                        btm_ := odlfd.Btm
                    else if c3
                        top_ := odlfd.Top
                        btm_ := fd.Btm
                    else if c4
                        top_ := odlfd.Top
                        btm_ := odlfd.Btm
                    isBPR := true
                    arrFVD_BPR.unshift(fvgDetails.new(fd.Type,top_,btm_,bleft_,time,0))
                    arrFVD_BPRBox.unshift(box.new(bleft_, top_, time, btm_, border_color = fd.fvgClr, bgcolor = color.new(fd.fvgClr, 75), xloc = xloc.bar_time,border_style = bprStyle,text = "BPR",text_size = fvgLabl,text_halign = text.align_right,text_color = fd.fvgClr))
                i += 1
    bullMit = mitgationTypeWick ? low_ : close_
    bearMit = mitgationTypeWick ? high_ : close_
    if arrFVDDType.size() > 0
        i = 0
        while i < arrFVDDType.size()
            fdnTpe = arrFVDDType.get(i)
            fdnLblTop = arrFVDLblTop.get(i)
            fdnBox    = arrFVDBox.get(i)
            fdnLblTop.set_x(time+addtimt)
            fdnBox.set_right(time+addtimt)
            minval = math.min(fdnBox.get_bottom(), fdnBox.get_top())
            maxvla = math.max(fdnBox.get_bottom(), fdnBox.get_top())
            midPnt = (maxvla - minval)*mitgPer*0.01
            if fdnTpe
                if bullMit < (maxvla - midPnt)
                    arrFVDLblTop.remove(i).delete()
                    arrFVDBox.remove(i).delete()
                    arrFVDDType.remove(i)
                    i -= 1
            else
                if bearMit > (minval + midPnt)
                    arrFVDLblTop.remove(i).delete()
                    arrFVDBox.remove(i).delete()
                    arrFVDDType.remove(i)
                    i -= 1
            i += 1
    if arrFVD_BPR.size() > 0
        i = 0
        while i < arrFVD_BPR.size()
            fdn = arrFVD_BPR.get(i)
            arrFVD_BPRBox.get(i).set_right(time+addtimt)
            minval = math.min(fdn.Top,fdn.Btm)
            maxvla = math.max(fdn.Top,fdn.Btm)
            midPnt = (maxvla - minval)*mitgPer*0.01
            if fdn.Type == 1
                if bullMit < (maxvla - midPnt)
                    bx = arrFVD_BPRBox.remove(i)
                    if showhist
                        bx.set_right(time+addtimt)
                    else
                        bx.delete()
                    arrFVD_BPR.remove(i)
                    i -= 1
            else
                if bearMit > (minval + midPnt)
                    bx = arrFVD_BPRBox.remove(i)
                    if showhist
                        bx.set_right(time+addtimt)
                    else
                        bx.delete()
                    arrFVD_BPR.remove(i)
                    i -= 1
            i += 1
    bullMitp = mitgationTypeWick ? low_p : close_p
    bearMitp = mitgationTypeWick ? high_p : close_p
    if arrFVDD.size() > 0
        i = 0
        while i < arrFVDD.size()
            fdn = arrFVDD.get(i)
            minval = math.min(fdn.Top,fdn.Btm)
            maxvla = math.max(fdn.Top,fdn.Btm)
            midPnt = (maxvla - minval)*mitgPer*0.01
            if fdn.Type == 1
                if  bullMitp < (maxvla - midPnt)
                    arrFVDD.remove(i)
                    i -= 1
            else
                if  bearMitp > (minval + midPnt)
                    arrFVDD.remove(i)
                    i -= 1
            i += 1
    if not na(fd) and not na(fd[1])
        if fd.Type == 1 or fd.Type == -1
            arrFVDD.unshift(fd)
            if not isBPR
                arrFVDDType.unshift(fd.Type == 1)
                int  fvgLeft = math.min(fd.left, fd.left2)
                arrFVDBox.unshift(box.new(fvgLeft, fd.Top, time+addtimt, fd.Btm, border_color = fd.fvgClr, bgcolor = color.new(fd.fvgClr, 80), xloc = xloc.bar_time, border_style = fvgStyle))
                arrFVDLblTop.unshift(label.new(time+addtimt, (fd.Top+fd.Btm)/2, color = #ff525200, xloc = xloc.bar_time, style = label.style_label_right, size = fvgLabl, text = "FVG", textcolor = fd.fvgClr))

// ═══════════════════════════════════════
// === MULTI-HTF FVG / BPR ===
// Affiche les FVG et BPR de 7 timeframes (15m/30m/1H/4H/8H/12H/D)
// simultanement sur le graph courant (utile en 1m pour voir tous les HTF)
// ═══════════════════════════════════════

g_mtf = "Multi-HTF FVG/BPR"

mtf_show15  = input.bool(true,  "15m", group=g_mtf, inline="mtf15")
mtf_bull15  = input.color(color.new(#2196F3, 70),  "Bull", group=g_mtf, inline="mtf15")
mtf_bear15  = input.color(color.new(#0D47A1, 55),  "Bear", group=g_mtf, inline="mtf15")

mtf_show30  = input.bool(false, "30m", group=g_mtf, inline="mtf30")
mtf_bull30  = input.color(color.new(#9C27B0, 70),  "Bull", group=g_mtf, inline="mtf30")
mtf_bear30  = input.color(color.new(#4A148C, 55),  "Bear", group=g_mtf, inline="mtf30")

mtf_show1h  = input.bool(true,  "1H",  group=g_mtf, inline="mtf1h")
mtf_bull1h  = input.color(color.new(#FF9800, 70),  "Bull", group=g_mtf, inline="mtf1h")
mtf_bear1h  = input.color(color.new(#E65100, 55),  "Bear", group=g_mtf, inline="mtf1h")

mtf_show4h  = input.bool(true,  "4H",  group=g_mtf, inline="mtf4h")
mtf_bull4h  = input.color(color.new(#F44336, 70),  "Bull", group=g_mtf, inline="mtf4h")
mtf_bear4h  = input.color(color.new(#B71C1C, 55),  "Bear", group=g_mtf, inline="mtf4h")

mtf_show8h  = input.bool(false, "8H",  group=g_mtf, inline="mtf8h")
mtf_bull8h  = input.color(color.new(#00BCD4, 70),  "Bull", group=g_mtf, inline="mtf8h")
mtf_bear8h  = input.color(color.new(#006064, 55),  "Bear", group=g_mtf, inline="mtf8h")

mtf_show12h = input.bool(false, "12H", group=g_mtf, inline="mtf12h")
mtf_bull12h = input.color(color.new(#8BC34A, 70),  "Bull", group=g_mtf, inline="mtf12h")
mtf_bear12h = input.color(color.new(#33691E, 55),  "Bear", group=g_mtf, inline="mtf12h")

mtf_showD   = input.bool(false, "Daily", group=g_mtf, inline="mtfD")
mtf_bullD   = input.color(color.new(#795548, 70),  "Bull", group=g_mtf, inline="mtfD")
mtf_bearD   = input.color(color.new(#3E2723, 55),  "Bear", group=g_mtf, inline="mtfD")

// ── Affichage FVG vs BPR (independants) ──
mtf_showFVG = input.bool(true,  "Afficher FVG", group=g_mtf, inline="mtfShow")
mtf_showBPR = input.bool(true,  "Afficher BPR", group=g_mtf, inline="mtfShow")

mtf_fvgStyle = input.string(line.style_dotted, "Style FVG", options=[line.style_solid, line.style_dotted, line.style_dashed], group=g_mtf, inline="mtfStyle")
mtf_bprStyle = input.string(line.style_solid,  "Style BPR", options=[line.style_solid, line.style_dotted, line.style_dashed], group=g_mtf, inline="mtfStyle")

mtf_fvgBgOp = input.int(85, "Transparence FVG (0=opaque 100=invisible)", minval=0, maxval=100, group=g_mtf, inline="mtfOp")
mtf_bprBgOp = input.int(30, "Transparence BPR (0=opaque 100=invisible)", minval=0, maxval=100, group=g_mtf, inline="mtfOp")

mtf_lblSize = input.string("Tiny", "Taille Label", options=["Tiny","Small","Normal","Large","Huge"], group=g_mtf)
mtf_showLbl = input.bool(true,  "Afficher labels", group=g_mtf)

// ── Filtre proximite du prix ──
mtf_nearOnly = input.bool(true, "Garder seulement BPR/FVG proches du prix actuel", group=g_mtf)
mtf_nearPct  = input.float(3.0, "Distance max du prix (%)", minval=0.1, maxval=50.0, step=0.5, group=g_mtf, tooltip="Supprime les BPR/FVG dont la zone est a plus de X%% du prix actuel. Libere des boxes pour les zones pertinentes.")

mtf_numFVG  = input.int(20, "Nb FVG max / TF", minval=1, maxval=200, group=g_mtf)
mtf_numBPR  = input.int(100, "Nb BPR max / TF", minval=1, maxval=500, group=g_mtf)
mtf_minPct  = input.float(0.009, "Min gap %", minval=0.0, step=0.001, group=g_mtf)
mtf_mitPer  = input.int(50, "Mitigation %", minval=1, maxval=100, group=g_mtf)
mtf_mitWick = input.string("Wick", "Mitigation Type", options=["Wick","Close"], group=g_mtf) == "Wick"
mtf_tagTF   = input.bool(true, "Inclure nom TF dans label (ex: FVG 15m)", group=g_mtf)
mtf_lookahead = input.bool(true, "Real-time (lookahead, peut repaint)", group=g_mtf, tooltip="Active pour detecter FVG/BPR sur la barre HTF en cours de formation.")
mtf_useMitFVG = input.bool(true,  "Mitiger FVG (supprimer quand traverses)", group=g_mtf)
mtf_useMitBPR = input.bool(false, "Mitiger BPR (supprimer quand traverses)", group=g_mtf, tooltip="Decoche pour garder tous les BPR affiches jusqu'a la limite d'array (Nb BPR max)")

// Fonction: recupere les donnees FVG brutes pour un TF (sans couleur)
f_fvg_raw() =>
    isBull = low > high[2] and close[1] > high[2] and (low - high[2]) / high[2] * 100 > mtf_minPct
    isBear = high < low[2]  and close[1] < low[2]  and (low[2] - high) / high * 100 > mtf_minPct
    typ  = isBull ? 1 : isBear ? -1 : 0
    top_ = isBull ? low     : isBear ? low[2] : 0.0
    btm_ = isBull ? high[2] : isBear ? high   : 0.0
    lft1 = isBull ? time    : isBear ? time[2] : 0
    lft2 = isBull ? time[2] : isBear ? time    : 0
    [typ, top_, btm_, lft1, lft2, open, close, high, low, high[1], low[1], close[1]]

// Type utilitaire local (reutilise fvgDetails existant)
// Process multi-TF : helper qui traite UN timeframe donne
process_mtf(string tf_str, bool enabled, color bullCol, color bearCol, string tfLabel) =>
    var arrFVG      = array.new<fvgDetails>(0)
    var arrFVGType  = array.new_bool(0)
    var arrFVGBox   = array.new_box(0)
    var arrFVGLbl   = array.new_label(0)
    var arrBPR      = array.new<fvgDetails>(0)
    var arrBPRBox   = array.new_box(0)
    if enabled
        lh = mtf_lookahead ? barmerge.lookahead_on : barmerge.lookahead_off
        [typ_, top_, btm_, lft1_, lft2_, open_, close_, high_, low_, high_p, low_p, close_p] = request.security(syminfo.tickerid, tf_str, f_fvg_raw(), lookahead=lh)

        // Nettoyage ancienneté
        if arrFVGBox.size() > mtf_numFVG
            arrFVGBox.pop().delete()
            arrFVGLbl.pop().delete()
            arrFVGType.pop()
        // arrFVG (memoire historique pour detection BPR) : on garde plus large
        if arrFVG.size() > mtf_numFVG * 4
            arrFVG.pop()
        if arrBPRBox.size() > mtf_numBPR
            arrBPRBox.pop().delete()
            arrBPR.pop()

        addtimt = 5*(time[1] - time[2])

        // Detection : fire sur chaque barre LTF. Dedup sur top/btm pour eviter doublons.
        isDup = typ_ != 0 and arrFVG.size() > 0 and math.abs(arrFVG.get(0).Top - top_) < syminfo.mintick and math.abs(arrFVG.get(0).Btm - btm_) < syminfo.mintick
        shouldProcess = (typ_ != 0 and not isDup) or (open_ != open_[1])

        if shouldProcess
            isBPR = false
            clr = typ_ == 1 ? bullCol : typ_ == -1 ? bearCol : color.gray
            // Construit l'objet FVG courant
            fd = fvgDetails.new(Type=typ_, Top=top_, Btm=btm_, left=lft1_, left2=lft2_, right=time, cnt=0, fvgClr=clr)

            // Detection BPR : overlap avec FVG existants
            if typ_ != 0 and arrFVG.size() > 0
                i = 0
                while i < arrFVG.size()
                    oldfd = arrFVG.get(i)
                    c1 = fd.Top <= oldfd.Top and fd.Btm >= oldfd.Btm
                    c2 = fd.Top <= oldfd.Top and fd.Top > oldfd.Btm and fd.Btm < oldfd.Btm
                    c3 = fd.Top > oldfd.Top and fd.Btm >= oldfd.Btm and fd.Btm < oldfd.Top
                    c4 = fd.Top >= oldfd.Top and fd.Btm <= oldfd.Btm
                    if c1 or c2 or c3 or c4
                        bprTop = c2 ? fd.Top : c3 ? oldfd.Top : c4 ? oldfd.Top : fd.Top
                        bprBtm = c2 ? oldfd.Btm : c3 ? fd.Btm : c4 ? oldfd.Btm : fd.Btm
                        bprLft = oldfd.left
                        if mtf_showBPR
                            isBPR := true
                            topPx = math.max(bprTop, bprBtm)
                            btmPx = math.min(bprTop, bprBtm)
                            arrBPR.unshift(fvgDetails.new(Type=typ_, Top=topPx, Btm=btmPx, left=bprLft, left2=time, right=time, cnt=0, fvgClr=clr))
                            bprTxt = mtf_showLbl ? (mtf_tagTF ? "BPR " + tfLabel : "BPR") : ""
                            arrBPRBox.unshift(box.new(bprLft, topPx, time, btmPx, border_color=color.new(clr, 0), border_width=2, bgcolor=color.new(clr, mtf_bprBgOp), xloc=xloc.bar_time, border_style=mtf_bprStyle, text=bprTxt, text_size=f_lsz(mtf_lblSize), text_halign=text.align_right, text_color=color.new(clr, 0)))
                    i += 1

            // Extension des boxes FVG (droite) + mitigation optionnelle
            bullMit = mtf_mitWick ? low_ : close_
            bearMit = mtf_mitWick ? high_ : close_
            if arrFVGType.size() > 0
                i = 0
                while i < arrFVGType.size()
                    isBull = arrFVGType.get(i)
                    bx = arrFVGBox.get(i)
                    lb = arrFVGLbl.get(i)
                    bx.set_right(time+addtimt)
                    lb.set_x(time+addtimt)
                    if mtf_useMitFVG
                        mn = math.min(bx.get_bottom(), bx.get_top())
                        mx = math.max(bx.get_bottom(), bx.get_top())
                        mid = (mx - mn) * mtf_mitPer * 0.01
                        kill = isBull ? bullMit < (mx - mid) : bearMit > (mn + mid)
                        if kill
                            arrFVGLbl.remove(i).delete()
                            arrFVGBox.remove(i).delete()
                            arrFVGType.remove(i)
                            i -= 1
                    i += 1

            // Extension des boxes BPR (droite) + mitigation optionnelle
            if arrBPR.size() > 0
                i = 0
                while i < arrBPR.size()
                    bpr = arrBPR.get(i)
                    arrBPRBox.get(i).set_right(time+addtimt)
                    if mtf_useMitBPR
                        mn = math.min(bpr.Top, bpr.Btm)
                        mx = math.max(bpr.Top, bpr.Btm)
                        mid = (mx - mn) * mtf_mitPer * 0.01
                        kill = bpr.Type == 1 ? bullMit < (mx - mid) : bearMit > (mn + mid)
                        if kill
                            arrBPRBox.remove(i).delete()
                            arrBPR.remove(i)
                            i -= 1
                    i += 1

            // Nettoyage array FVG "historique" (pour detection BPR future)
            bullMitp = mtf_mitWick ? low_p : close_p
            bearMitp = mtf_mitWick ? high_p : close_p
            if arrFVG.size() > 0
                i = 0
                while i < arrFVG.size()
                    fdn = arrFVG.get(i)
                    mn = math.min(fdn.Top, fdn.Btm)
                    mx = math.max(fdn.Top, fdn.Btm)
                    mid = (mx - mn) * mtf_mitPer * 0.01
                    kill = fdn.Type == 1 ? bullMitp < (mx - mid) : bearMitp > (mn + mid)
                    if kill
                        arrFVG.remove(i)
                        i -= 1
                    i += 1

            // Ajout du nouveau FVG si pas BPR
            if typ_ != 0
                arrFVG.unshift(fd)
                if not isBPR and mtf_showFVG
                    arrFVGType.unshift(typ_ == 1)
                    fvgLeft = math.min(fd.left, fd.left2)
                    fvgTxt = mtf_showLbl ? (mtf_tagTF ? "FVG " + tfLabel : "FVG") : ""
                    arrFVGBox.unshift(box.new(fvgLeft, fd.Top, time+addtimt, fd.Btm, border_color=clr, bgcolor=color.new(clr, mtf_fvgBgOp), xloc=xloc.bar_time, border_style=mtf_fvgStyle))
                    arrFVGLbl.unshift(label.new(time+addtimt, (fd.Top+fd.Btm)/2, color=#ff525200, xloc=xloc.bar_time, style=label.style_label_right, size=f_lsz(mtf_lblSize), text=fvgTxt, textcolor=clr))
    // Filtre "proche du prix" : supprime BPR/FVG dont la zone est > mtf_nearPct% du close actuel
    if enabled and mtf_nearOnly and close > 0
        thr = close * mtf_nearPct * 0.01
        // FVG
        if arrFVGBox.size() > 0
            i = 0
            while i < arrFVGBox.size()
                bx = arrFVGBox.get(i)
                top = bx.get_top()
                btm = bx.get_bottom()
                // distance minimum de la zone au prix
                dist = close > top ? close - top : close < btm ? btm - close : 0.0
                if dist > thr
                    arrFVGBox.remove(i).delete()
                    arrFVGLbl.remove(i).delete()
                    arrFVGType.remove(i)
                    continue
                i += 1
        // BPR
        if arrBPRBox.size() > 0
            i = 0
            while i < arrBPRBox.size()
                bx = arrBPRBox.get(i)
                top = bx.get_top()
                btm = bx.get_bottom()
                dist = close > top ? close - top : close < btm ? btm - close : 0.0
                if dist > thr
                    arrBPRBox.remove(i).delete()
                    arrBPR.remove(i)
                    continue
                i += 1
    [arrFVG.size(), arrBPR.size()]

// Appels par TF (recupere [fvg_count, bpr_count])
[c15f, c15b] = process_mtf("15",  mtf_show15,  mtf_bull15,  mtf_bear15,  "15m")
[c30f, c30b] = process_mtf("30",  mtf_show30,  mtf_bull30,  mtf_bear30,  "30m")
[c1hf, c1hb] = process_mtf("60",  mtf_show1h,  mtf_bull1h,  mtf_bear1h,  "1H")
[c4hf, c4hb] = process_mtf("240", mtf_show4h,  mtf_bull4h,  mtf_bear4h,  "4H")
[c8hf, c8hb] = process_mtf("480", mtf_show8h,  mtf_bull8h,  mtf_bear8h,  "8H")
[c12f, c12b] = process_mtf("720", mtf_show12h, mtf_bull12h, mtf_bear12h, "12H")
[cDf,  cDb]  = process_mtf("D",   mtf_showD,   mtf_bullD,   mtf_bearD,   "D")

// Tableau debug Multi-HTF (haut droite)
mtf_showDbg = input.bool(false, "Afficher tableau debug FVG/BPR", group=g_mtf)
if mtf_showDbg and barstate.islast
    var t = table.new(position.top_right, 3, 8, bgcolor=color.new(color.black, 20), border_width=1)
    t.cell(0, 0, "TF",  bgcolor=color.new(#c8a228, 0), text_color=color.white, text_size=size.small)
    t.cell(1, 0, "FVG", bgcolor=color.new(#c8a228, 0), text_color=color.white, text_size=size.small)
    t.cell(2, 0, "BPR", bgcolor=color.new(#c8a228, 0), text_color=color.white, text_size=size.small)
    t.cell(0, 1, "15m", text_color=color.white, text_size=size.small)
    t.cell(1, 1, str.tostring(c15f), text_color=color.white, text_size=size.small)
    t.cell(2, 1, str.tostring(c15b), text_color=c15b > 0 ? color.lime : color.gray, text_size=size.small)
    t.cell(0, 2, "30m", text_color=color.white, text_size=size.small)
    t.cell(1, 2, str.tostring(c30f), text_color=color.white, text_size=size.small)
    t.cell(2, 2, str.tostring(c30b), text_color=c30b > 0 ? color.lime : color.gray, text_size=size.small)
    t.cell(0, 3, "1H",  text_color=color.white, text_size=size.small)
    t.cell(1, 3, str.tostring(c1hf), text_color=color.white, text_size=size.small)
    t.cell(2, 3, str.tostring(c1hb), text_color=c1hb > 0 ? color.lime : color.gray, text_size=size.small)
    t.cell(0, 4, "4H",  text_color=color.white, text_size=size.small)
    t.cell(1, 4, str.tostring(c4hf), text_color=color.white, text_size=size.small)
    t.cell(2, 4, str.tostring(c4hb), text_color=c4hb > 0 ? color.lime : color.gray, text_size=size.small)
    t.cell(0, 5, "8H",  text_color=color.white, text_size=size.small)
    t.cell(1, 5, str.tostring(c8hf), text_color=color.white, text_size=size.small)
    t.cell(2, 5, str.tostring(c8hb), text_color=c8hb > 0 ? color.lime : color.gray, text_size=size.small)
    t.cell(0, 6, "12H", text_color=color.white, text_size=size.small)
    t.cell(1, 6, str.tostring(c12f), text_color=color.white, text_size=size.small)
    t.cell(2, 6, str.tostring(c12b), text_color=c12b > 0 ? color.lime : color.gray, text_size=size.small)
    t.cell(0, 7, "D",   text_color=color.white, text_size=size.small)
    t.cell(1, 7, str.tostring(cDf), text_color=color.white, text_size=size.small)
    t.cell(2, 7, str.tostring(cDb), text_color=cDb > 0 ? color.lime : color.gray, text_size=size.small)
