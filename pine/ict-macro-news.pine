//@version=5
indicator("ICT Macro Tracker° + News | mmxm"
         , shorttitle       = "Macro+News°"
         , overlay          = false
         , max_lines_count  = 500
         , max_labels_count = 500
         , max_boxes_count  = 500)

//#region ─── TIMEFRAME CHECK ─────────────────────────────────────────────────
if timeframe.in_seconds(timeframe.period) > 86400
    runtime.error("Go to the Daily Timeframe or lower!")
else if timeframe.in_seconds(timeframe.period) < 30
    runtime.error("Go to the 30-Second Timeframe or higher!")
//#endregion

//#region ─── GLOBAL ──────────────────────────────────────────────────────────
oneDayMS = 86400000
oneBarMS = time_close - time
noColor  = color.new(#ffffff, 100)
one      = ta.highest(timeframe.in_seconds("15") / timeframe.in_seconds(timeframe.period)) + syminfo.mintick * 10
y_btm    = one
y_top    = one + syminfo.mintick * 5

var line[]  EXT = array.new_line()
var label[] LBL = array.new_label()
var line[]  VL  = array.new_line()
var line[]  FUT = array.new_line()   // future macro windows

// News day tracking
var mdnCheck = false
if hour(time, "America/New_York") == 0 and hour(time[1], "America/New_York") != 0 and not mdnCheck
    mdnCheck := true
newDay = mdnCheck ? hour(time, "America/New_York") == 0 and hour(time[1], "America/New_York") != 0 : timeframe.change("D")
//#endregion

//#region ─── INPUTS ──────────────────────────────────────────────────────────
// ── Settings ─────────────────────────────────────────────────────────────────
_mode  = input.string("New Pane", title = "Mode",              group = "Settings", options = ["On Chart", "New Pane"])
_lwStr = input.string("2px",      title = "Largeur de ligne",  group = "Settings", options = ["1px", "2px", "3px", "4px"])
_lw    = _lwStr == "1px" ? 1 : _lwStr == "2px" ? 2 : _lwStr == "3px" ? 3 : 4
_showL = input.bool(true,  title = "Labels?",      group = "Settings", inline = "sh")
_mTxt  = input.bool(false, title = "Temps?",       group = "Settings", inline = "sh")
_extt  = input.bool(false, title = "Projections?", group = "Settings", inline = "sh")

// ── Vertical Lines ────────────────────────────────────────────────────────────
_vl_on  = input.bool(true,                    title = "Enable for Macros", group = "Vertical Lines")
_vl_col = input.color(color.new(#787B86, 50), title = "Color",             group = "Vertical Lines", inline = "vl")
_vl_wS  = input.string("1px",                 title = "Width",             group = "Vertical Lines", inline = "vl", options = ["1px", "2px", "3px", "4px"])
_vl_stS = input.string("Pointillé",           title = "Style",             group = "Vertical Lines", inline = "vl", options = ["Solide", "Pointillé", "Tirets"])
_vlw    = _vl_wS == "1px" ? 1 : _vl_wS == "2px" ? 2 : _vl_wS == "3px" ? 3 : 4
_vls    = _vl_stS == "Pointillé" ? line.style_dotted : _vl_stS == "Tirets" ? line.style_dashed : line.style_solid

// ── News Calendar ─────────────────────────────────────────────────────────────
var n_high   = input.bool(true,  title = "🔴", group = "News Calendar", inline = "ni")
var n_med    = input.bool(true,  title = "🟠", group = "News Calendar", inline = "ni")
var n_low    = input.bool(false, title = "🟡", group = "News Calendar", inline = "ni")
var n_hol    = input.bool(false, title = "⚪", group = "News Calendar", inline = "ni")
var n_auto   = input.bool(true,  title = "Auto Currency?", group = "News Calendar")
var n_usd    = input.bool(false, title = "USD", group = "News Calendar", inline = "nc")
var n_eur    = input.bool(false, title = "EUR", group = "News Calendar", inline = "nc")
var n_gbp    = input.bool(false, title = "GBP", group = "News Calendar", inline = "nc")
var n_show   = input.bool(true,  title = "Show Events?",   group = "News Calendar", inline = "nd")
var n_chart  = input.string("This Week", title = "History", group = "News Calendar", inline = "nd", options = ["Today", "This Week", "Manual"])
var n_days   = input.int(30, title = "", group = "News Calendar")

var n_impFilter = ffUtil.impFilter(n_hol, n_low, n_med, n_high)
var n_curFilter = ffUtil.curFilter(n_auto, false, false, false, false, n_eur, n_gbp, false, false, n_usd)
//#endregion

//#region ─── FUNCTIONS ───────────────────────────────────────────────────────
// ── Macro helpers ─────────────────────────────────────────────────────────────
time_isMacro(int Hs, int Ms, int He, int Me) =>
    h = hour(time, "America/New_York")
    m = minute(time, "America/New_York")
    h == Hs ? (Hs != He ? m >= Ms : m >= Ms and m < Me) : (h > Hs ? (h == He ? m < Me : h < He) : false)

method memoryCleanLine(line[] A) =>
    if A.size() > 300
        for i = 0 to 3
            A.shift().delete()

method memoryCleanLabel(label[] A) =>
    if A.size() > 100
        A.shift().delete()

macroNP(line[] NP, bool _t, string _lbl, color _col, bool _vl) =>
    if not _t[1] and _t
        NP.push(line.new(time, 1, time + oneBarMS, 1, xloc = xloc.bar_time, color = _col, width = _lw, style = line.style_solid))
        if _vl_on and _vl
            VL.push(line.new(time, 0, time, 2, xloc = xloc.bar_time, color = _vl_col, width = _vlw, style = _vls, extend = extend.both))
    if _t and NP.size() > 0
        NP.last().set_x2(time + oneBarMS)
    if _t[1] and not _t and NP.size() > 0
        NP.last().set_x2(time)
        label.new(math.round(math.avg(NP.last().get_x1(), NP.last().get_x2())), 1, text = "", tooltip = "MACRO\n" + _lbl, xloc = xloc.bar_time, style = label.style_label_center, color = noColor, textcolor = _col, size = size.small)

macroOC(line[] OC, bool _t, string _lbl, color _col, bool _vl) =>
    _txt = _mTxt ? "MACRO\n" + _lbl : "MACRO"
    if not _t[1] and _t
        v1 = line.new(time, y_btm, time, y_top, xloc = xloc.bar_time, color = _col)
        OC.push(v1)
        OC.push(line.new(time, y_top, time + oneBarMS, y_top, xloc = xloc.bar_time, color = _col))
        if _extt
            EXT.push(line.new(time, high, time, v1.get_y2(), xloc = xloc.bar_time, color = _col, style = line.style_dotted))
        if _vl_on and _vl
            VL.push(line.new(time, low - syminfo.mintick * 10000, time, high + syminfo.mintick * 10000, xloc = xloc.bar_time, color = _vl_col, width = _vlw, style = _vls, extend = extend.both))
        LBL.push(label.new(time, OC.get(OC.size() - 2).get_y2(), _showL ? _txt : "", tooltip = "MACRO\n" + _lbl, xloc = xloc.bar_time, style = label.style_label_down, color = noColor, textcolor = _col, size = size.small))
    if _t[1] and not _t and OC.size() > 0 and LBL.size() > 0
        v2 = line.new(time, y_btm, time, y_top, xloc = xloc.bar_time, color = _col)
        LBL.last().set_x(math.round(math.avg(OC.get(OC.size() - 2).get_x1(), time)))
        if y_top > OC.get(OC.size() - 2).get_y2()
            OC.get(OC.size() - 2).set_y2(y_top)
            OC.last().set_y1(y_top)
            OC.last().set_y2(y_top)
            LBL.last().set_y(y_top)
        else if y_top < OC.get(OC.size() - 2).get_y2()
            v2.set_y2(OC.get(OC.size() - 2).get_y2())
        if _extt
            EXT.push(line.new(time, high, time, v2.get_y2(), xloc = xloc.bar_time, color = _col, style = line.style_dotted))
        OC.push(v2)
    if _t and OC.size() > 0 and LBL.size() > 0
        LBL.last().set_x(math.round(math.avg(OC.get(OC.size() - 2).get_x1(), time)))
        if high > OC.last().get_y2() - syminfo.mintick * 10
            OC.get(OC.size() - 2).set_y2(high + syminfo.mintick * 10)
            OC.last().set_y1(high + syminfo.mintick * 10)
            OC.last().set_y2(high + syminfo.mintick * 10)
            LBL.last().set_y(high + syminfo.mintick * 10)
        if na or OC.last().get_x2() == time
            OC.last().set_x2(time + oneBarMS)

// ── Trace les fenêtres futures (pas encore arrivées) dans le volet ────────────
drawFutureNP(int Hs, int Ms, int He, int Me, color _col) =>
    _nyY = year(timenow, "America/New_York")
    _nyM = month(timenow, "America/New_York")
    _nyD = dayofmonth(timenow, "America/New_York")
    _s   = timestamp("America/New_York", _nyY, _nyM, _nyD, Hs, Ms, 0)
    _eD  = He < Hs or (He == Hs and Me <= Ms) ? _nyD + 1 : _nyD
    _e   = timestamp("America/New_York", _nyY, _nyM, _eD, He, Me, 0)
    if _e > timenow
        FUT.push(line.new(_s, 1, _e, 1, xloc = xloc.bar_time, color = _col, width = _lw, style = line.style_solid))
requestData() =>
    [request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_1", str.tostring(open) + "," + str.tostring(high) + "," + str.tostring(low) + "," + str.tostring(close) + "," + str.tostring(volume)),
     request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_2", str.tostring(open) + "," + str.tostring(high) + "," + str.tostring(low) + "," + str.tostring(close) + "," + str.tostring(volume)),
     request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_3", str.tostring(open) + "," + str.tostring(high) + "," + str.tostring(low) + "," + str.tostring(close) + "," + str.tostring(volume)),
     request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_4", str.tostring(open) + "," + str.tostring(high) + "," + str.tostring(low) + "," + str.tostring(close) + "," + str.tostring(volume)),
     request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_5", str.tostring(open) + "," + str.tostring(high) + "," + str.tostring(low) + "," + str.tostring(close) + "," + str.tostring(volume)),
     request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_6", str.tostring(open) + "," + str.tostring(high) + "," + str.tostring(low) + "," + str.tostring(close) + "," + str.tostring(volume)),
     request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_7", str.tostring(open) + "," + str.tostring(high) + "," + str.tostring(low) + "," + str.tostring(close) + "," + str.tostring(volume)),
     request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_8", str.tostring(open) + "," + str.tostring(high) + "," + str.tostring(low) + "," + str.tostring(close) + "," + str.tostring(volume)),
     request.seed("seed_toodegrees_toogit", "TOODEGREES_FOREX_FACTORY_SLOT_9", str.tostring(open) + "," + str.tostring(high) + "," + str.tostring(low) + "," + str.tostring(close) + "," + str.tostring(volume))]

method processData(ffUtil.News[] N, string S1, string S2, string S3, string S4, string S5, string S6, string S7, string S8, string S9) =>
    ffDec.readNews(N, S1), ffDec.readNews(N, S2), ffDec.readNews(N, S3)
    ffDec.readNews(N, S4), ffDec.readNews(N, S5), ffDec.readNews(N, S6)
    ffDec.readNews(N, S7), ffDec.readNews(N, S8), ffDec.readNews(N, S9)

