// ── News table display ──────────────────────────────────────────────────────────
if n_show and currWeek.size() > 0
    if n_chart == "Today"
        if newDay
            _ntable := ffUtil.FF_Table(currDay, n_locT, "Small", color.new(#dee1e9,0), color.new(#283c70,0), color.new(#000000,0), color.new(#dee1e9,0), n_tableBC)
        ffUtil.timeline(currDay, _ntable, color.new(#787b86,0), 0, 0, true)
    else
        if timeframe.change("W")
            _ntable := ffUtil.FF_Table(currWeek, n_locT, "Small", color.new(#dee1e9,0), color.new(#283c70,0), color.new(#000000,0), color.new(#dee1e9,0), n_tableBC)
        ffUtil.timeline(currWeek, _ntable, color.new(#787b86,0), 0, 0)
else
    _ntable.delete()

// ── Tracé des macros futures (prochaines fenêtres non encore arrivées) ────────
if barstate.islast and _mode != "On Chart"
    for fl in FUT
        fl.delete()
    FUT.clear()
    if show1
