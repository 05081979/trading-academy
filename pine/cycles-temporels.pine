// PM1 11:30-13:00
var float tc_hi7 = na, var float tc_lo7 = na, var int tc_sb7 = na
var box tc_bx7 = na, var label tc_lb7 = na
bool tc_s7 = hm >= 1130 and hm < 1300 and tc_gate
if tc_s7
