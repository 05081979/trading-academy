indicator("Algorithmic Academy - Time cycles Toolkit", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=5000)
type CL
    array<box> bx
    array<label> lb
    float h
    float l
    float ph
    float pl
    int cap
    int hx
    int lx
    int phx
    int plx
type LQ
    line ln
    label lb
    float price
    bool is_high
    bool swept
    color col
    int sbar
    int stime
    int xoff = 0

