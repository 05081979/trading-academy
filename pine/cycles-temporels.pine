TZ = "America/New_York"
f_tf_secs(string s) =>
    s == "30 seconds" ? 30 : s == "1 minute" ? 60 : s == "3 minutes" ? 180 : s == "5 minutes" ? 300 : s == "10 minutes" ? 600 : s == "15 minutes" ? 900 : s == "30 minutes" ? 1800 : s == "45 minutes" ? 2700 : s == "1 hour" ? 3600 : s == "4 hours" ? 14400 : s == "1 day" ? 86400 : s == "1 week" ? 604800 : s == "1 month" ? 2592000 : s == "3 months" ? 7776000 : s == "12 months" ? 31536000 : 0
f_tf_ok(string mn, string mx) =>
    int cur = timeframe.in_seconds()
    int mns = f_tf_secs(mn)
    int mxs = f_tf_secs(mx)
    (mns == 0 or cur >= mns) and (mxs == 0 or cur <= mxs)
f_style(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid
f_qcol(int q, color c1, color c2, color c3, color c4) =>
    q == 1 ? c1 : q == 2 ? c2 : q == 3 ? c3 : q == 4 ? c4 : c1
f_sess_name(int d) =>
    d == 1 ? s6_n1 : d == 2 ? s6_n2 : d == 3 ? s6_n3 : d == 4 ? s6_n4 : ""
f_lsz(string s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Large" ? size.large : s == "Huge" ? size.huge : size.normal
int curH = hour(time, TZ)
int curM = minute(time, TZ)
int mf18 = curH >= 18 ? (curH - 18) * 60 + curM : (curH + 6) * 60 + curM
int qDay = math.min(int(math.floor(mf18 / 360)) + 1, 4)
int m6h = mf18 % 360
int q90 = math.min(int(math.floor(m6h / 90)) + 1, 4)
float m90f = m6h % 90.0
int q30 = m90f < 30 ? 1 : m90f < 60 ? 2 : 3
int tDow = dayofweek(time, TZ)
int qWeekDay = tDow == dayofweek.monday ? 1 : tDow == dayofweek.tuesday ? 2 : tDow == dayofweek.wednesday ? 3 : tDow == dayofweek.thursday ? 4 : tDow == dayofweek.friday ? 4 : 0
int qWOM = math.min(int(math.ceil(dayofmonth(time, TZ) / 7.0)), 4)
int qMoQ = ((month(time, TZ) - 1) % 3) + 1
bool n6h = ta.change(qDay) != 0
bool n90 = ta.change(q90) != 0 or n6h
bool n30 = ta.change(q30) != 0 or n90
bool nDay = qDay == 1 and n6h
bool nWeek = ta.change(weekofyear(time, TZ)) != 0
bool nMonth = ta.change(month(time, TZ)) != 0
bool nYear = ta.change(year(time, TZ)) != 0
int curQtr = int(math.ceil(month(time, TZ) / 3.0))
bool nQtr = ta.change(curQtr) != 0
int p45 = int(math.floor(mf18 / 45))
bool n45m = ta.change(p45) != 0
int p10 = int(math.floor(mf18 / 10))
bool n10m = ta.change(p10) != 0
int p3 = int(math.floor(mf18 / 3))
bool n3m = ta.change(p3) != 0
bool tfDay = f_tf_ok(dy_mn, dy_mx)
bool tfWk = f_tf_ok(wk_mn, wk_mx)
bool tfMo = f_tf_ok(mo_mn, mo_mx)
var CL L6 = CL.new(array.new_box(), array.new_label(), na, na, na, na, 20, na, na, na, na) // keep for liquidity H/L tracking only
var CL L9 = CL.new(array.new_box(), array.new_label(), na, na, na, na, 100, na, na, na, na)
var CL L30 = CL.new(array.new_box(), array.new_label(), na, na, na, na, 100, na, na, na, na)
var CL LD = CL.new(array.new_box(), array.new_label(), na, na, na, na, 10, na, na, na, na)
var CL LW = CL.new(array.new_box(), array.new_label(), na, na, na, na, 5, na, na, na, na)
var CL LO = CL.new(array.new_box(), array.new_label(), na, na, na, na, 5, na, na, na, na)
var CL LY = CL.new(array.new_box(), array.new_label(), na, na, na, na, 3, na, na, na, na)
var lq_90a = array.new<LQ>()
var lq_30a = array.new<LQ>()
// Historique Month/Day
var lq_pm_a = array.new<LQ>()  // 3 derniers mois
var lq_pd_a = array.new<LQ>()  // 5 derniers jours
// Trackers mois courant / jour courant (pour detecter fin)
var float month_h = na
var float month_l = na
var int   month_hx = na
var int   month_lx = na
var int   month_id = na
var float day_h = na
var float day_l = na
var int   day_hx = na
var int   day_lx = na
var int   day_dow = na
var lq_6ha = array.new<LQ>()
var lq_270_a1a = array.new<LQ>()
var lq_270_a2a = array.new<LQ>()
var lq_270_ldna = array.new<LQ>()
var lq_270_ama = array.new<LQ>()
var lq_270_pma = array.new<LQ>()
// 270mn tracker : H/L sur Q1+Q2+Q3 de chaque session
var float s270_h = na
var float s270_l = na
var int s270_hx = na
var int s270_lx = na
var int s270_sess = 0
// Tracker Asia combine (Asia1 + Asia2 en un seul range)
var float asia_h = na
var float asia_l = na
var int asia_hx = na
var int asia_lx = na
var lq_da = array.new<LQ>()
var lq_wa = array.new<LQ>()
var lq_ma = array.new<LQ>()
var lq_ya = array.new<LQ>()
manage(CL ly, bool is_new, bool tf_ok, bool show_box, bool show_brd, color brd_c, bool show_lbl, string lbl_txt, color qcol, int opacity) =>
    if is_new
        ly.ph := ly.h
        ly.pl := ly.l
        ly.phx := ly.hx
        ly.plx := ly.lx
        ly.h := high
        ly.l := low
        ly.hx := bar_index
        ly.lx := bar_index
    else
        if na(ly.h) or high > ly.h
            ly.h := high
            ly.hx := bar_index
        if na(ly.l) or low < ly.l
            ly.l := low
            ly.lx := bar_index
    if tf_ok
        if is_new
            if show_box
                color bg = color.new(qcol, 100 - opacity)
                color bc = show_brd ? brd_c : color.new(qcol, 100)
                box nb = box.new(bar_index, high, bar_index, low, border_color=bc, bgcolor=bg, border_width=1)
                array.push(ly.bx, nb)
                if array.size(ly.bx) > ly.cap
                    box.delete(array.shift(ly.bx))
            if show_lbl and lbl_txt != ""
                label nl = label.new(bar_index, high, lbl_txt, style=label.style_label_down, textcolor=color.new(qcol, 20), color=color.new(color.white, 100), size=f_lsz(sz_90), yloc=yloc.price)
                array.push(ly.lb, nl)
                if array.size(ly.lb) > ly.cap
                    label.delete(array.shift(ly.lb))
        else
            if array.size(ly.bx) > 0
                box b = array.get(ly.bx, array.size(ly.bx) - 1)
                box.set_top(b, ly.h)
                box.set_bottom(b, ly.l)
                box.set_right(b, bar_index)
            if show_lbl and array.size(ly.lb) > 0
                label l = array.get(ly.lb, array.size(ly.lb) - 1)
                label.set_y(l, ly.h)
                if array.size(ly.bx) > 0
                    box b = array.get(ly.bx, array.size(ly.bx) - 1)
                    label.set_x(l, int(math.avg(box.get_left(b), bar_index)))
bool tc_active = true
// L6 : track H/L only (no boxes) for liquidity
manage(L6, n6h, true, false, false, color.gray, false, "", color.gray, 0)
manage(L9, n90, true, false, false, color.gray, false, "", color.gray, 0)
manage(L30, n30, true, false, false, color.gray, false, "", color.gray, 0)
// Previous 90mn Equilibrium line
// EQ sera calcule dans la section TIME CYCLES (apres les boxes)
var line q9_eq_ln = na
var label q9_eq_lb = na
var float _prev_tc_h = na
var float _prev_tc_l = na
string dy_labels = switch qDay
    1 => "A"
    2 => "M"
    3 => "D"
    4 => "X"
    => ""
color dy_qc = f_qcol(qWeekDay, dy_c1, dy_c2, dy_c3, dy_c4)
manage(LD, nDay, tfDay, dy_box, dy_brd, dy_brd_c, dy_lbl, dy_labels, dy_qc, dy_op)
string wk_labels = "W" + str.tostring(qWOM)
color wk_qc = f_qcol(qWOM, wk_c1, wk_c2, wk_c3, wk_c4)
manage(LW, nWeek, tfWk, wk_box, wk_brd, wk_brd_c, wk_lbl, wk_labels, wk_qc, wk_op)
string mo_labels = "Q" + str.tostring(qMoQ)
color mo_qc = f_qcol(qMoQ, mo_c1, mo_c2, mo_c3, mo_c4)
manage(LO, nMonth, tfMo, mo_box, mo_brd, mo_brd_c, mo_lbl, mo_labels, mo_qc, mo_op)
// Yearly : track H/L only (no boxes)
manage(LY, nYear, true, false, false, color.gray, false, "", color.gray, 0)
// ===== TIME BASED LIQUIDITY =====
f_addlq(array<LQ> a, float p, bool ih, color cLine, int cap, int sb, string lblTxt, string szStr, int xOff, color cLbl) =>
    int _off = na(sb) ? 0 : math.max(0, math.min(bar_index - sb, 4999))
    int _t = time[_off]
    int _end_t = lq_extR ? time + 100 * (time - time[1]) : time + lq_ext * (time - time[1])
    int _lbl_t = _end_t + xOff * (time - time[1])
    bool _isPast = str.contains(lblTxt, "MON") or str.contains(lblTxt, "TUE") or str.contains(lblTxt, "WED") or str.contains(lblTxt, "THU") or str.contains(lblTxt, "FRI") or str.contains(lblTxt, "JAN") or str.contains(lblTxt, "FEB") or str.contains(lblTxt, "MAR") or str.contains(lblTxt, "APR") or str.contains(lblTxt, "MAY") or str.contains(lblTxt, "JUN") or str.contains(lblTxt, "JUL") or str.contains(lblTxt, "AUG") or str.contains(lblTxt, "SEP") or str.contains(lblTxt, "OCT") or str.contains(lblTxt, "NOV") or str.contains(lblTxt, "DEC")
    color _line_c = lq_override_color and not _isPast ? lq_override_c : cLine
    color _lbl_c  = lq_override_color and not _isPast ? lq_override_c : cLbl
    line  _ln = line.new(_t, p, _end_t, p, xloc=xloc.bar_time, color=_line_c, style=f_style(lq_ls), width=lq_lw)
    int   _off_ticks = ih ? lq_hi_off : lq_lo_off
    float _lbl_y = p + _off_ticks * syminfo.mintick
    label _lb = lq_ll and str.length(lblTxt) > 0 ? label.new(_lbl_t, _lbl_y, lblTxt, xloc=xloc.bar_time, style=label.style_none, textcolor=_lbl_c, size=f_lsz(szStr)) : na
    array.push(a, LQ.new(_ln, _lb, p, ih, false, c, na(sb) ? bar_index : sb, _t, xOff))
    if array.size(a) > cap
        LQ o = array.shift(a)
        if not na(o.ln)
            line.delete(o.ln)
        if not na(o.lb)
            label.delete(o.lb)
f_chklq(array<LQ> a) =>
    int sz = array.size(a)
    if sz > 0
        int _end_t = lq_extR ? time + 500 * (time - time[1]) : time + lq_ext * (time - time[1])
        for i = 0 to sz - 1
            LQ lv = array.get(a, i)
            if not lv.swept
                // Etend la ligne/label avec le temps (la ligne avance avec le prix)
                if not na(lv.ln)
                    line.set_x2(lv.ln, _end_t)
                if not na(lv.lb)
                    label.set_x(lv.lb, _end_t + lv.xoff * (time - time[1]))
                bool swept_h = lv.is_high and high > lv.price
                bool swept_l = not lv.is_high and low < lv.price
                if swept_h or swept_l
                    lv.swept := true
                    color sc = lq_uc ? lv.col : lq_sc
                    // Recupere le texte d'origine (ASH, PDL, etc.) pour l'inclure dans le label sweep
                    string origTxt = not na(lv.lb) ? label.get_text(lv.lb) : ""
                    // Remplace la ligne detection par la ligne sweep (lv.stime -> time actuel)
                    if not na(lv.ln)
                        line.delete(lv.ln)
                    if not na(lv.lb)
                        label.delete(lv.lb)
                    lv.ln := line.new(lv.stime, lv.price, time, lv.price, xloc=xloc.bar_time, color=sc, style=f_style(lq_ss), width=lq_lw)
                    int mx = int(math.avg(lv.stime, time))
                    // Label sweep au milieu de la ligne : "<orig> X" (ou juste "<orig>" si sw_txt vide)
                    string finalTxt = str.length(lq_sw_txt) > 0 ? (str.length(origTxt) > 0 ? origTxt + " " + lq_sw_txt : lq_sw_txt) : origTxt
                    if str.length(finalTxt) > 0
                        lv.lb := label.new(mx, lv.price, finalTxt, xloc=xloc.bar_time, style=label.style_none, textcolor=sc, size=f_lsz(lq_xs))
// 270mn ICT sessions (ET timezone via TZ)
// Asia1 18:00-22:30, Asia2 22:30-02:30, London 02:30-07:00, AM 07:00-11:30, PM 11:30-16:00
int _270h = hour(time, TZ)
int _270m = minute(time, TZ)
int _270tot = _270h * 60 + _270m
// Minutes from midnight : 18:00=1080, 22:30=1350, 02:30=150, 07:00=420, 11:30=690, 16:00=960
// Asia spans midnight so use offset: add 360 to normalize (18:00->0, 22:30->270, 02:30->510, etc)
int _270norm = _270tot >= 1080 ? _270tot - 1080 : _270tot + 360
// Session IDs : 1=Asia1(0-270) 2=Asia2(270-510) 3=London(510-780) 4=NYAM(780-1050) 5=NYPM(1050-1320) 0=outside
int _270id = _270norm >= 0 and _270norm < 270 ? 1 : _270norm >= 270 and _270norm < 510 ? 2 : _270norm >= 510 and _270norm < 780 ? 3 : _270norm >= 780 and _270norm < 1050 ? 4 : _270norm >= 1050 and _270norm < 1320 ? 5 : 0
bool _270new = _270id != _270id[1] and _270id > 0
bool _270end = _270id[1] > 0 and (_270id != _270id[1])

// Quand une session 270mn se termine : stocker dans l'array de la session
if lq_270 and _270end and not na(s270_h) and not na(s270_l) and s270_sess > 0
    // Cap = 2 (H + L) = session du jour uniquement
    // Asia1 : met a jour le tracker Asia combine seulement
    if s270_sess == 1 and lq_270_a1
        if na(asia_h) or s270_h > asia_h
            asia_h := s270_h
            asia_hx := s270_hx
        if na(asia_l) or s270_l < asia_l
            asia_l := s270_l
            asia_lx := s270_lx
    // Asia2 : finalise et dessine le range Asia combine (Asia1+Asia2)
    if s270_sess == 2 and lq_270_a2
        if na(asia_h) or s270_h > asia_h
            asia_h := s270_h
            asia_hx := s270_hx
        if na(asia_l) or s270_l < asia_l
            asia_l := s270_l
            asia_lx := s270_lx
        if lq_asia_h and not na(asia_h)
            f_addlq(lq_270_a2a, asia_h, true, lq_ac1, 2, asia_hx, "ASH", lq_as_sz, 0, lq_ac1_lb)
        if lq_asia_l and not na(asia_l)
            f_addlq(lq_270_a2a, asia_l, false, lq_ac2, 2, asia_lx, "ASL", lq_as_sz, 0, lq_ac2_lb)
        asia_h := na
        asia_l := na
        asia_hx := na
        asia_lx := na
    if s270_sess == 3 and lq_270_ldn
        if lq_ldn_h
            f_addlq(lq_270_ldna, s270_h, true, lq_lc1, 2, s270_hx, "LDH", lq_ln_sz, 3, lq_lc1_lb)
        if lq_ldn_l
            f_addlq(lq_270_ldna, s270_l, false, lq_lc2, 2, s270_lx, "LDL", lq_ln_sz, 3, lq_lc2_lb)
    if s270_sess == 4 and lq_270_am
        if lq_am_h
            f_addlq(lq_270_ama, s270_h, true, lq_amc1, 2, s270_hx, "AMH", lq_am_sz, 6, lq_amc1_lb)
        if lq_am_l
            f_addlq(lq_270_ama, s270_l, false, lq_amc2, 2, s270_lx, "AML", lq_am_sz, 6, lq_amc2_lb)
    if s270_sess == 5 and lq_270_pm
        if lq_pm_h
            f_addlq(lq_270_pma, s270_h, true, lq_pmc1, 2, s270_hx, "NPH", lq_pm_sz, 9, lq_pmc1_lb)
        if lq_pm_l
            f_addlq(lq_270_pma, s270_l, false, lq_pmc2, 2, s270_lx, "NPL", lq_pm_sz, 9, lq_pmc2_lb)

// Nouvelle session 270mn : reset tracker
if _270new
    s270_h := high
    s270_l := low
    s270_hx := bar_index
    s270_lx := bar_index
    s270_sess := _270id
else if _270id > 0
    if high > nz(s270_h)
        s270_h := high
        s270_hx := bar_index
    if low < nz(s270_l, 1e10)
        s270_l := low
        s270_lx := bar_index
f_chklq(lq_270_a1a)
f_chklq(lq_270_a2a)
f_chklq(lq_270_ldna)
f_chklq(lq_270_ama)
f_chklq(lq_270_pma)

// Affichage du cycle 270mn EN COURS (ligne temporaire qui se met a jour)
var line _270_cur_h = na
var line _270_cur_l = na
var label _270_cur_hl = na
var label _270_cur_ll = na
if _270id > 0 and lq_270
    string _cn = _270id == 1 ? "Asia1" : _270id == 2 ? "Asia2" : _270id == 3 ? "Ldn" : _270id == 4 ? "AM" : "PM"
    line.delete(_270_cur_h)
    line.delete(_270_cur_l)
    label.delete(_270_cur_hl)
    label.delete(_270_cur_ll)
    _270_cur_h := line.new(s270_hx, s270_h, bar_index + 2, s270_h, color=color.new(lq_270h, 50), style=line.style_dotted, width=lw_270)
    _270_cur_l := line.new(s270_lx, s270_l, bar_index + 2, s270_l, color=color.new(lq_270l, 50), style=line.style_dotted, width=lw_270)
    _270_cur_hl := label.new(bar_index + 3, s270_h, _cn + " H", style=label.style_none, textcolor=color.new(lq_270h, 50), size=f_lsz(sz_270))
    _270_cur_ll := label.new(bar_index + 3, s270_l, _cn + " L", style=label.style_none, textcolor=color.new(lq_270l, 50), size=f_lsz(sz_270))
else if _270id == 0
    line.delete(_270_cur_h)
    line.delete(_270_cur_l)
    label.delete(_270_cur_hl)
    label.delete(_270_cur_ll)

if n90 and lq_90 and not na(L9.ph) and not na(L9.pl)
    f_addlq(lq_90a, L9.ph, true, lq_q90c1, 2, L9.phx, "Q90H", "Tiny", 1, lq_q90c1_lb)
    f_addlq(lq_90a, L9.pl, false, lq_q90c2, 2, L9.plx, "Q90L", "Tiny", 1, lq_q90c2_lb)
// Q30 : push sur toute transition Q30 (y compris au Q90 boundary pour capturer le Q3 du Q90)
if n30 and lq_30 and not na(L30.ph) and not na(L30.pl)
    f_addlq(lq_30a, L30.ph, true, lq_q30c1, 2, L30.phx, "Q30H", "Tiny", 3, lq_q30c1_lb)
    f_addlq(lq_30a, L30.pl, false, lq_q30c2, 2, L30.plx, "Q30L", "Tiny", 3, lq_q30c2_lb)
f_chklq(lq_30a)
f_chklq(lq_90a)
if n6h and not na(L6.ph) and not na(L6.pl)
    int prevS = qDay > 1 ? qDay - 1 : 4
    color ch = prevS == 1 ? lq_ac1 : prevS == 2 ? lq_lc1 : prevS == 3 ? s6_c3 : s6_c4
    color cl = prevS == 1 ? lq_ac2 : prevS == 2 ? lq_lc2 : prevS == 3 ? s6_c3 : s6_c4
    f_addlq(lq_6ha, L6.ph, true, ch, 2, L6.phx, "", "Tiny", 0, ch)
    f_addlq(lq_6ha, L6.pl, false, cl, 2, L6.plx, "", "Tiny", 0, cl)
f_chklq(lq_6ha)

// ========== HISTORIQUE MOIS / JOUR (liquidites non prises) ==========
f_month_abbr(int m) =>
    m == 1 ? "JAN" : m == 2 ? "FEB" : m == 3 ? "MAR" : m == 4 ? "APR" : m == 5 ? "MAY" : m == 6 ? "JUN" : m == 7 ? "JUL" : m == 8 ? "AUG" : m == 9 ? "SEP" : m == 10 ? "OCT" : m == 11 ? "NOV" : "DEC"
f_day_abbr(int d) =>
    d == 2 ? "MON" : d == 3 ? "TUE" : d == 4 ? "WED" : d == 5 ? "THU" : d == 6 ? "FRI" : d == 7 ? "SAT" : "MON"

// Track mois courant : quand nouveau mois, push ancien dans lq_pm_a
if lq_past_months
    curMonth = month(time, TZ)
    if na(month_id)
        month_id := curMonth
        month_h := high
        month_l := low
        month_hx := bar_index
        month_lx := bar_index
    else if curMonth != month_id
        // Mois precedent termine : ajoute si non encore pris
        // Cree ligne + label avec nom du mois precedent
        prevMonthName = f_month_abbr(month_id)
        f_addlq(lq_pm_a, month_h, true, lq_past_mc, 3 * 2, month_hx, prevMonthName + " H", "Normal", 14, lq_past_mc_lb)
        f_addlq(lq_pm_a, month_l, false, lq_past_mc, 3 * 2, month_lx, prevMonthName + " L", "Normal", 14, lq_past_mc_lb)
        // Reset pour nouveau mois
        month_id := curMonth
        month_h := high
        month_l := low
        month_hx := bar_index
        month_lx := bar_index
    else
        if high > month_h
            month_h := high
            month_hx := bar_index
        if low < month_l
            month_l := low
            month_lx := bar_index
f_chklq(lq_pm_a)

// Track jour courant : quand nouveau jour, push ancien dans lq_pd_a
if lq_past_days
    if na(day_dow)
        day_dow := dayofweek(time, TZ)
        day_h := high
        day_l := low
        day_hx := bar_index
        day_lx := bar_index
    else if nDay
        // nDay fire a 18h ET (debut d'une nouvelle session trading).
        // Le label = dayofweek AU MOMENT DU PUSH (represente la session qui vient de finir).
        // MON=2, TUE=3, WED=4, THU=5, FRI=6. Skip 1 (Sunday 18h = weekend) et 7 (Saturday).
        int curDow = dayofweek(time, TZ)
        if curDow >= 2 and curDow <= 6
            prevDayName = f_day_abbr(curDow)
            f_addlq(lq_pd_a, day_h, true, lq_past_dc, 5 * 2, day_hx, prevDayName + " H", "Small", 7, lq_past_dc_lb)
            f_addlq(lq_pd_a, day_l, false, lq_past_dc, 5 * 2, day_lx, prevDayName + " L", "Small", 7, lq_past_dc_lb)
        day_dow := curDow
        day_h := high
        day_l := low
        day_hx := bar_index
        day_lx := bar_index
    else
        if high > day_h
            day_h := high
            day_hx := bar_index
        if low < day_l
            day_l := low
            day_lx := bar_index
f_chklq(lq_pd_a)

// Historique mois/jours : supprime completement les niveaux une fois pris (ne laisse pas la trace sweep)
f_remove_swept(array<LQ> a) =>
    i = 0
    while i < array.size(a)
        LQ lv = array.get(a, i)
        if lv.swept
            if not na(lv.ln)
                line.delete(lv.ln)
            if not na(lv.lb)
                label.delete(lv.lb)
            array.remove(a, i)
            continue
        i += 1
f_remove_swept(lq_pm_a)
f_remove_swept(lq_pd_a)
// Reset intraday (session + 90m + 30m + 6h) en debut de nouvelle journee
f_clearlq(array<LQ> a) =>
    while array.size(a) > 0
        LQ o = array.shift(a)
        if not na(o.ln)
            line.delete(o.ln)
        if not na(o.lb)
            label.delete(o.lb)
if nDay
    f_clearlq(lq_270_a1a)
    f_clearlq(lq_270_a2a)
    f_clearlq(lq_270_ldna)
    f_clearlq(lq_270_ama)
    f_clearlq(lq_270_pma)
    f_clearlq(lq_90a)
    f_clearlq(lq_30a)
    f_clearlq(lq_6ha)

// Daily/Weekly/Monthly/Yearly : delegue a la section PREVIOUS LEVELS ci-dessous (une seule ligne a la fois)
// Sweep : f_chklq conserve pour detecter sweeps (lines et labels ne sont pas dans lq_da donc pas de doublon visuel)
// NB: si tu veux aussi le sweep cross rouge sur PDH/PDL, reactive les appels f_addlq ci-dessous
// ===== PREVIOUS LEVELS (PDH/PDL/PWH/PWL/PMH/PML/PYH/PYL) =====
var line pdh_l = na, var line pdl_l = na
var label pdh_lb = na, var label pdl_lb = na
var line pwh_l = na, var line pwl_l = na
var label pwh_lb = na, var label pwl_lb = na
var line pmh_l = na, var line pml_l = na
var label pmh_lb = na, var label pml_lb = na
var line pyh_l = na, var line pyl_l = na
var label pyh_lb = na, var label pyl_lb = na
if barstate.islast
    if not na(pdh_l)
        line.delete(pdh_l)
        label.delete(pdh_lb)
    if not na(pdl_l)
        line.delete(pdl_l)
        label.delete(pdl_lb)
    if not na(pwh_l)
        line.delete(pwh_l)
        label.delete(pwh_lb)
    if not na(pwl_l)
        line.delete(pwl_l)
        label.delete(pwl_lb)
    if not na(pmh_l)
        line.delete(pmh_l)
        label.delete(pmh_lb)
    if not na(pml_l)
        line.delete(pml_l)
        label.delete(pml_lb)
    if not na(pyh_l)
        line.delete(pyh_l)
        label.delete(pyh_lb)
    if not na(pyl_l)
        line.delete(pyl_l)
        label.delete(pyl_lb)
    int _xmin = bar_index - 4999
    if lq_daily and not na(LD.ph) and not na(LD.phx)
        pdh_l := line.new(math.max(LD.phx, _xmin), LD.ph, bar_index + 5, LD.ph, color=lq_dc1, style=line.style_dashed, width=lw_prev)
        pdh_lb := label.new(bar_index + 6, LD.ph, "PDH", style=label.style_none, textcolor=lq_dc1, size=f_lsz(sz_prev))
    if lq_daily and not na(LD.pl) and not na(LD.plx)
        pdl_l := line.new(math.max(LD.plx, _xmin), LD.pl, bar_index + 5, LD.pl, color=lq_dc2, style=line.style_dashed, width=lw_prev)
        pdl_lb := label.new(bar_index + 6, LD.pl, "PDL", style=label.style_none, textcolor=lq_dc2, size=f_lsz(sz_prev))
    if lq_weekly and not na(LW.ph) and not na(LW.phx)
        pwh_l := line.new(math.max(LW.phx, _xmin), LW.ph, bar_index + 5, LW.ph, color=lq_wc1, style=line.style_dashed, width=lw_prev)
        pwh_lb := label.new(bar_index + 6, LW.ph, "PWH", style=label.style_none, textcolor=lq_wc1, size=f_lsz(sz_prev))
    if lq_weekly and not na(LW.pl) and not na(LW.plx)
        pwl_l := line.new(math.max(LW.plx, _xmin), LW.pl, bar_index + 5, LW.pl, color=lq_wc2, style=line.style_dashed, width=lw_prev)
        pwl_lb := label.new(bar_index + 6, LW.pl, "PWL", style=label.style_none, textcolor=lq_wc2, size=f_lsz(sz_prev))
    if lq_monthly and not na(LO.ph) and not na(LO.phx)
        pmh_l := line.new(math.max(LO.phx, _xmin), LO.ph, bar_index + 5, LO.ph, color=lq_mc1, style=line.style_dashed, width=lw_prev)
        pmh_lb := label.new(bar_index + 6, LO.ph, "PMH", style=label.style_none, textcolor=lq_mc1, size=f_lsz(sz_prev))
    if lq_monthly and not na(LO.pl) and not na(LO.plx)
        pml_l := line.new(math.max(LO.plx, _xmin), LO.pl, bar_index + 5, LO.pl, color=lq_mc2, style=line.style_dashed, width=lw_prev)
        pml_lb := label.new(bar_index + 6, LO.pl, "PML", style=label.style_none, textcolor=lq_mc2, size=f_lsz(sz_prev))
    if lq_yearly and not na(LY.ph) and not na(LY.phx)
        pyh_l := line.new(math.max(LY.phx, _xmin), LY.ph, bar_index + 5, LY.ph, color=lq_yc1, style=line.style_dashed, width=lw_prev)
        pyh_lb := label.new(bar_index + 6, LY.ph, "PYH", style=label.style_none, textcolor=lq_yc1, size=f_lsz(sz_prev))
    if lq_yearly and not na(LY.pl) and not na(LY.plx)
        pyl_l := line.new(math.max(LY.plx, _xmin), LY.pl, bar_index + 5, LY.pl, color=lq_yc2, style=line.style_dashed, width=lw_prev)
        pyl_lb := label.new(bar_index + 6, LY.pl, "PYL", style=label.style_none, textcolor=lq_yc2, size=f_lsz(sz_prev))
// ===== TIME CYCLES =====

// --- Inputs ---
// ===== ICT CUSTOM OPENS =====
string gOpn = "ICT OPENS"
bool op_show = input.bool(true, "Show Opens", group=gOpn)
string op_sz = input.string("Tiny", "Label Size", options=["Tiny","Small","Normal","Large","Huge"], group=gOpn)
string op_sty = input.string("Dotted", "Line Style", options=["Solid","Dashed","Dotted"], group=gOpn)
int op_w = input.int(1, "Line Width", minval=1, maxval=4, group=gOpn)
bool op1_on = input.bool(true, "2:00 AM", inline="op1", group=gOpn)
color op1_c = input.color(color.white, "", inline="op1", group=gOpn)
bool op2_on = input.bool(true, "3:00 AM", inline="op2", group=gOpn)
color op2_c = input.color(color.white, "", inline="op2", group=gOpn)
bool op3_on = input.bool(true, "4:00 AM", inline="op3", group=gOpn)
color op3_c = input.color(color.white, "", inline="op3", group=gOpn)
bool op4_on = input.bool(true, "7:30 AM", inline="op4", group=gOpn)
color op4_c = input.color(color.yellow, "", inline="op4", group=gOpn)
bool op5_on = input.bool(true, "9:30 AM", inline="op5", group=gOpn)
color op5_c = input.color(color.orange, "", inline="op5", group=gOpn)
bool op6_on = input.bool(true, "10:00 AM", inline="op6", group=gOpn)
color op6_c = input.color(color.orange, "", inline="op6", group=gOpn)
bool op7_on = input.bool(true, "1:30 PM", inline="op7", group=gOpn)
color op7_c = input.color(#2196F3, "", inline="op7", group=gOpn)

// Open tracking + line drawing
var float op1_p = na, var float op2_p = na, var float op3_p = na, var float op4_p = na
var float op5_p = na, var float op6_p = na, var float op7_p = na
var line op1_l = na, var line op2_l = na, var line op3_l = na, var line op4_l = na
var line op5_l = na, var line op6_l = na, var line op7_l = na
var label op1_lb = na, var label op2_lb = na, var label op3_lb = na, var label op4_lb = na
var label op5_lb = na, var label op6_lb = na, var label op7_lb = na
var int op1_sb = na, var int op2_sb = na, var int op3_sb = na, var int op4_sb = na
var int op5_sb = na, var int op6_sb = na, var int op7_sb = na

int _opH = hour(time, TZ)
int _opM = minute(time, TZ)
int _opHM = _opH * 100 + _opM

// ─── NEW DAY RESET: clear all opens so only today's are visible ───
int _opDay = dayofweek(time, TZ)
var int _prevDay = na
bool _newDay = na(_prevDay) ? false : _opDay != _prevDay
_prevDay := _opDay

if _newDay
    line.delete(op1_l),  label.delete(op1_lb),  op1_l := na, op1_lb := na, op1_p := na
    line.delete(op2_l),  label.delete(op2_lb),  op2_l := na, op2_lb := na, op2_p := na
    line.delete(op3_l),  label.delete(op3_lb),  op3_l := na, op3_lb := na, op3_p := na
    line.delete(op4_l),  label.delete(op4_lb),  op4_l := na, op4_lb := na, op4_p := na
    line.delete(op5_l),  label.delete(op5_lb),  op5_l := na, op5_lb := na, op5_p := na
    line.delete(op6_l),  label.delete(op6_lb),  op6_l := na, op6_lb := na, op6_p := na
    line.delete(op7_l),  label.delete(op7_lb),  op7_l := na, op7_lb := na, op7_p := na

// Helper : detect open, save price, create line+label, extend on each bar
f_open_detect(bool enabled, int target_hm, int cur_hm) =>
    enabled and op_show and cur_hm == target_hm and (cur_hm != cur_hm[1] or bar_index != bar_index[1])

// 2:00 AM
if f_open_detect(op1_on, 200, _opHM)
    op1_p := open, op1_sb := bar_index
    line.delete(op1_l), label.delete(op1_lb)
    op1_l := line.new(bar_index, open, bar_index, open, color=op1_c, style=f_style(op_sty), width=op_w)
    op1_lb := label.new(bar_index, open, "2AM", style=label.style_none, textcolor=op1_c, size=f_lsz(op_sz))
if op1_on and op_show and not na(op1_l)
    line.set_x2(op1_l, bar_index + 3)
    label.set_x(op1_lb, bar_index + 4)

// 3:00 AM
if f_open_detect(op2_on, 300, _opHM)
    op2_p := open, op2_sb := bar_index
    line.delete(op2_l), label.delete(op2_lb)
    op2_l := line.new(bar_index, open, bar_index, open, color=op2_c, style=f_style(op_sty), width=op_w)
    op2_lb := label.new(bar_index, open, "3AM", style=label.style_none, textcolor=op2_c, size=f_lsz(op_sz))
if op2_on and op_show and not na(op2_l)
    line.set_x2(op2_l, bar_index + 3)
    label.set_x(op2_lb, bar_index + 4)

// 4:00 AM
if f_open_detect(op3_on, 400, _opHM)
    op3_p := open, op3_sb := bar_index
    line.delete(op3_l), label.delete(op3_lb)
    op3_l := line.new(bar_index, open, bar_index, open, color=op3_c, style=f_style(op_sty), width=op_w)
    op3_lb := label.new(bar_index, open, "4AM", style=label.style_none, textcolor=op3_c, size=f_lsz(op_sz))
if op3_on and op_show and not na(op3_l)
    line.set_x2(op3_l, bar_index + 3)
    label.set_x(op3_lb, bar_index + 4)

// 7:30 AM
if f_open_detect(op4_on, 730, _opHM)
    op4_p := open, op4_sb := bar_index
    line.delete(op4_l), label.delete(op4_lb)
    op4_l := line.new(bar_index, open, bar_index, open, color=op4_c, style=f_style(op_sty), width=op_w)
    op4_lb := label.new(bar_index, open, "7:30", style=label.style_none, textcolor=op4_c, size=f_lsz(op_sz))
if op4_on and op_show and not na(op4_l)
    line.set_x2(op4_l, bar_index + 3)
    label.set_x(op4_lb, bar_index + 4)

// 9:30 AM
if f_open_detect(op5_on, 930, _opHM)
    op5_p := open, op5_sb := bar_index
    line.delete(op5_l), label.delete(op5_lb)
    op5_l := line.new(bar_index, open, bar_index, open, color=op5_c, style=f_style(op_sty), width=op_w)
    op5_lb := label.new(bar_index, open, "9:30", style=label.style_none, textcolor=op5_c, size=f_lsz(op_sz))
if op5_on and op_show and not na(op5_l)
    line.set_x2(op5_l, bar_index + 3)
    label.set_x(op5_lb, bar_index + 4)

// 10:00 AM
if f_open_detect(op6_on, 1000, _opHM)
    op6_p := open, op6_sb := bar_index
    line.delete(op6_l), label.delete(op6_lb)
    op6_l := line.new(bar_index, open, bar_index, open, color=op6_c, style=f_style(op_sty), width=op_w)
    op6_lb := label.new(bar_index, open, "10AM", style=label.style_none, textcolor=op6_c, size=f_lsz(op_sz))
if op6_on and op_show and not na(op6_l)
    line.set_x2(op6_l, bar_index + 3)
    label.set_x(op6_lb, bar_index + 4)

// 1:30 PM
if f_open_detect(op7_on, 1330, _opHM)
    op7_p := open, op7_sb := bar_index
    line.delete(op7_l), label.delete(op7_lb)
    op7_l := line.new(bar_index, open, bar_index, open, color=op7_c, style=f_style(op_sty), width=op_w)
    op7_lb := label.new(bar_index, open, "1:30", style=label.style_none, textcolor=op7_c, size=f_lsz(op_sz))
if op7_on and op_show and not na(op7_l)
    line.set_x2(op7_l, bar_index + 3)
    label.set_x(op7_lb, bar_index + 6)

// TIME CYCLES uses 90mn/30mn inputs above
tc_on = true
tc_show_boxes = tc90_show
tc_show_labels = tc90_lbl
tc_border_col = tc90_brd
tc_opacity = tc90_op
tc_mn = "Chart"
tc_mx = "15 minutes"

// --- TF gate ---
bool tc_tf_ok = f_tf_ok(tc_mn, tc_mx)

// --- Session detection (reuses curH/curM from QT cycles) ---
int hm = curH * 100 + curM
bool tc_gate = tc_on and tc_tf_ok and tc_active
// --- Inline session boxes (same pattern as source code) ---
// ASIA 18:00-02:30
var float tc_hi0 = na, var float tc_lo0 = na, var int tc_sb0 = na
var box tc_bx0 = na, var label tc_lb0 = na
bool tc_s0 = (hm >= 1800 or hm < 230) and tc_gate
if tc_s0
    if na(tc_hi0)
        tc_hi0 := high
        tc_lo0 := low
        tc_sb0 := bar_index
        if tc_show_boxes
            tc_bx0 := box.new(bar_index, high, bar_index, low, bgcolor=color.new(tc90_c_asia, 100 - tc_opacity), border_color=tc_border_col, border_width=1)
        if tc_show_labels
            tc_lb0 := label.new(bar_index, high, "Asia", style=label.style_label_down, textcolor=color.new(tc90_c_asia, 20), color=color.new(color.white, 100), size=f_lsz(sz_tc))
    else
        tc_hi0 := math.max(tc_hi0, high)
        tc_lo0 := math.min(tc_lo0, low)
        if not na(tc_bx0)
            box.set_top(tc_bx0, tc_hi0)
            box.set_bottom(tc_bx0, tc_lo0)
            box.set_right(tc_bx0, bar_index)
        if not na(tc_lb0)
            label.set_x(tc_lb0, int(math.avg(tc_sb0, bar_index)))
            label.set_y(tc_lb0, tc_hi0)
else if not na(tc_hi0)
    tc_hi0 := na, tc_lo0 := na, tc_sb0 := na
// LO1 02:30-04:00
var float tc_hi1 = na, var float tc_lo1 = na, var int tc_sb1 = na
var box tc_bx1 = na, var label tc_lb1 = na
bool tc_s1 = hm >= 230 and hm < 400 and tc_gate
if tc_s1
    if na(tc_hi1)
        tc_hi1 := high, tc_lo1 := low, tc_sb1 := bar_index
        if tc_show_boxes
            tc_bx1 := box.new(bar_index, high, bar_index, low, bgcolor=color.new(tc90_c_lo1, 100 - tc_opacity), border_color=tc_border_col, border_width=1)
        if tc_show_labels
            tc_lb1 := label.new(bar_index, high, "LO1", style=label.style_label_down, textcolor=color.new(tc90_c_lo1, 20), color=color.new(color.white, 100), size=f_lsz(sz_tc))
    else
        tc_hi1 := math.max(tc_hi1, high), tc_lo1 := math.min(tc_lo1, low)
        if not na(tc_bx1)
            box.set_top(tc_bx1, tc_hi1), box.set_bottom(tc_bx1, tc_lo1), box.set_right(tc_bx1, bar_index)
        if not na(tc_lb1)
            label.set_x(tc_lb1, int(math.avg(tc_sb1, bar_index))), label.set_y(tc_lb1, tc_hi1)
else if not na(tc_hi1)
    tc_hi1 := na, tc_lo1 := na, tc_sb1 := na
// LO2 04:00-05:30
var float tc_hi2 = na, var float tc_lo2 = na, var int tc_sb2 = na
var box tc_bx2 = na, var label tc_lb2 = na
bool tc_s2 = hm >= 400 and hm < 530 and tc_gate
if tc_s2
    if na(tc_hi2)
        tc_hi2 := high, tc_lo2 := low, tc_sb2 := bar_index
        if tc_show_boxes
            tc_bx2 := box.new(bar_index, high, bar_index, low, bgcolor=color.new(tc90_c_lo2, 100 - tc_opacity), border_color=tc_border_col, border_width=1)
        if tc_show_labels
            tc_lb2 := label.new(bar_index, high, "LO2", style=label.style_label_down, textcolor=color.new(tc90_c_lo2, 20), color=color.new(color.white, 100), size=f_lsz(sz_tc))
    else
        tc_hi2 := math.max(tc_hi2, high), tc_lo2 := math.min(tc_lo2, low)
        if not na(tc_bx2)
            box.set_top(tc_bx2, tc_hi2), box.set_bottom(tc_bx2, tc_lo2), box.set_right(tc_bx2, bar_index)
        if not na(tc_lb2)
            label.set_x(tc_lb2, int(math.avg(tc_sb2, bar_index))), label.set_y(tc_lb2, tc_hi2)
else if not na(tc_hi2)
    tc_hi2 := na, tc_lo2 := na, tc_sb2 := na
// LO3 05:30-07:00
var float tc_hi3 = na, var float tc_lo3 = na, var int tc_sb3 = na
var box tc_bx3 = na, var label tc_lb3 = na
bool tc_s3 = hm >= 530 and hm < 700 and tc_gate
if tc_s3
    if na(tc_hi3)
        tc_hi3 := high, tc_lo3 := low, tc_sb3 := bar_index
        if tc_show_boxes
            tc_bx3 := box.new(bar_index, high, bar_index, low, bgcolor=color.new(tc90_c_lo3, 100 - tc_opacity), border_color=tc_border_col, border_width=1)
        if tc_show_labels
            tc_lb3 := label.new(bar_index, high, "LO3", style=label.style_label_down, textcolor=color.new(tc90_c_lo3, 20), color=color.new(color.white, 100), size=f_lsz(sz_tc))
    else
        tc_hi3 := math.max(tc_hi3, high), tc_lo3 := math.min(tc_lo3, low)
        if not na(tc_bx3)
            box.set_top(tc_bx3, tc_hi3), box.set_bottom(tc_bx3, tc_lo3), box.set_right(tc_bx3, bar_index)
        if not na(tc_lb3)
            label.set_x(tc_lb3, int(math.avg(tc_sb3, bar_index))), label.set_y(tc_lb3, tc_hi3)
else if not na(tc_hi3)
    tc_hi3 := na, tc_lo3 := na, tc_sb3 := na
// AM1 07:00-08:30
var float tc_hi4 = na, var float tc_lo4 = na, var int tc_sb4 = na
var box tc_bx4 = na, var label tc_lb4 = na
bool tc_s4 = hm >= 700 and hm < 830 and tc_gate
if tc_s4
    if na(tc_hi4)
        tc_hi4 := high, tc_lo4 := low, tc_sb4 := bar_index
        if tc_show_boxes
            tc_bx4 := box.new(bar_index, high, bar_index, low, bgcolor=color.new(tc90_c_am1, 100 - tc_opacity), border_color=tc_border_col, border_width=1)
        if tc_show_labels
            tc_lb4 := label.new(bar_index, high, "AM1", style=label.style_label_down, textcolor=color.new(tc90_c_am1, 20), color=color.new(color.white, 100), size=f_lsz(sz_tc))
    else
        tc_hi4 := math.max(tc_hi4, high), tc_lo4 := math.min(tc_lo4, low)
        if not na(tc_bx4)
            box.set_top(tc_bx4, tc_hi4), box.set_bottom(tc_bx4, tc_lo4), box.set_right(tc_bx4, bar_index)
        if not na(tc_lb4)
            label.set_x(tc_lb4, int(math.avg(tc_sb4, bar_index))), label.set_y(tc_lb4, tc_hi4)
else if not na(tc_hi4)
    tc_hi4 := na, tc_lo4 := na, tc_sb4 := na
// AM2 08:30-10:00
var float tc_hi5 = na, var float tc_lo5 = na, var int tc_sb5 = na
var box tc_bx5 = na, var label tc_lb5 = na
bool tc_s5 = hm >= 830 and hm < 1000 and tc_gate
if tc_s5
    if na(tc_hi5)
        tc_hi5 := high, tc_lo5 := low, tc_sb5 := bar_index
        if tc_show_boxes
            tc_bx5 := box.new(bar_index, high, bar_index, low, bgcolor=color.new(tc90_c_am2, 100 - tc_opacity), border_color=tc_border_col, border_width=1)
        if tc_show_labels
