// AM3 10:00-11:30
var float tc_hi6 = na, var float tc_lo6 = na, var int tc_sb6 = na
var box tc_bx6 = na, var label tc_lb6 = na
bool tc_s6 = hm >= 1000 and hm < 1130 and tc_gate
if tc_s6
