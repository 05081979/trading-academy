y_width = input.int(1, 'Border', inline = 'y2', group = grp_y)
y_style = input.string('Dashed', 'Type', options = ['Solid', 'Dashed', 'Dotted'], inline = 'y2', group = grp_y)

// --- QUARTERLY CYCLE (Sub-Q) ---
