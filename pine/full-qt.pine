lblfrmt         = input.string(defval="Symbol Name",title="SSMT Label Format ",options=["Symbol Name", "Emoji"],inline= "al2",group = g0)
lblcont         = input.int(defval=90,title="Label Contrast ",inline= "al2",group = g0)
i_font          = input.string("tiny", "Chart Text Size",  options = ["tiny", "small",  "normal", "large", "huge"],inline="0",group = g0)
show_rm         = input.bool(defval = true,title = "Remaining Time",inline="0",group = g0)

botm            = "1"
topm            = "2"
botN            = "3"
topN            = "10"
botD            = "15"
topD            = "30"
botW            = "60"
topW            = "180"
botMo           = "180"
topMo           = "360"
botQ            = "1D"
topQ            = "1D"
botY            = "1W"
topY            = "1W"

show_table      = input.bool(defval= false, title= "Show Table",group = g9)
i_pos    = input.string(position.middle_right, "Table Position", options = [position.middle_right, position.top_right,position.bottom_right,position.bottom_center,position.bottom_left], group = g9,inline="tbl")
ii_font  = input.string("tiny", "Table Text size",  options = ["tiny", "small",  "normal", "large", "huge"], group = g9,inline="tbl")
show_bias       = input.bool(defval = false,title = "Show Bias",inline="2",group = g9)
show_sstb       = input.bool(defval = false,title = "SSMT ",inline="2",group = g9)
show_stat       = input.bool(defval = false,title = "Active Cycles",inline="2",group = g9)
