// --- YEARLY CYCLE (Qx) ---
grp_y = 'YEARLY CYCLE (Qx)'
y_show_b = input.bool(true, 'Box', inline = 'y1', group = grp_y)
y_show_l = input.bool(true, 'Line', inline = 'y1', group = grp_y)
y_show_lbl = input.bool(true, 'Label', inline = 'y1', group = grp_y)
