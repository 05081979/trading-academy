f_nwox_main(_tf, clr, del, _show)=>
    // Arrays to store drawing objects
    var nwox_top_lines  = array.new_line()
    var nwox_bot_lines  = array.new_line()
    var nwox_ce_lines   = array.new_line()
    var nwox_link_lines = array.new_line() 
    var nwox_fills      = array.new_linefill()
    var nwox_labels     = array.new_label()

    // Manual mode state
    var bool manual_gap_found = false
    var int manual_gap_time = na

    var float csd_level = na
    _tap = false 
    htapW = false, htapD = false, htap90 = false, htapm = false
    ltapW = false, ltapD = false, ltap90 = false, ltapm = false    

    // Calculate Extension Buffer (Same as 1m FVG)
    // Uses the global 'settings.buffer' defined earlier in your script
    int tc = (time - time[1]) * nwox_buffer

    // --- Detect and Process New Gap on Timeframe Change ---
    if timeframe.change(_tf) 
        // Calculate Gap Levels
        _max = math.max(close[1], open)
        _min = math.min(close[1], open)
        _ce  = math.avg(_max, _min)
        
        // Determine Colors
        gap_border_clr = i_textcolor 
        gap_fill_clr   = color.new(clr, 90) 

        // --- NWOG Manual Mode Logic ---
        bool is_manual_target = false
        if _tf == "1W" and nwog_mode == "Manual" and _show and not na(time)
            int target_month = f_month_from_string(nwog_manual_month)
            int target_quarter = f_quarter_from_string(nwog_manual_quarter)
            int wom = math.ceil(dayofmonth(time) / 7.0)
            if month(time) == target_month and wom == target_quarter
                is_manual_target := true

            // If we find the manual target, store it and prevent other gaps from drawing
            if is_manual_target
                manual_gap_found := true
                manual_gap_time := time

        // --- Drawing Condition ---
        bool can_draw = false
        if _show and _max - _min >= 1 * syminfo.mintick and not (_tf == "1D" and timeframe.change("1W"))
            if _tf == "1W"
                if nwog_mode == "Auto"
                    can_draw := true
                else if is_manual_target // Manual mode, only draw the specific target
                    can_draw := true
            else if _tf == "1D" // Old NDOG logic
                can_draw := true

        if can_draw
            
            
            // 1. Create Horizontal Lines (Extended to time + tc)
            l_top = line.new(x1=time, y1=_max, x2=time + tc, y2=_max, xloc=xloc.bar_time, color=gap_border_clr, style=line.style_solid)
            l_bot = line.new(x1=time, y1=_min, x2=time + tc, y2=_min, xloc=xloc.bar_time, color=gap_border_clr, style=line.style_solid)
            l_ce  = line.new(x1=time, y1=_ce,  x2=time + tc, y2=_ce,  xloc=xloc.bar_time, color=gap_border_clr, style=line.style_dashed)
            l_fill = linefill.new(l_top, l_bot, gap_fill_clr)

            // 2. Create Vertical Link Line (At the end of the extension)
            l_link = line.new(x1=time + tc, y1=_max, x2=time + tc, y2=_min, xloc=xloc.bar_time, color=gap_border_clr, style=line.style_solid, width=3)

            // 3. Generate Label Text
            string lbl_txt = ""
            if _tf == "1W" and not na(time) // NWOG Logic
                int wom = math.ceil(dayofmonth(time) / 7.0)
                lbl_txt := str.format("{0,date,MMMM} Q{1} NWOG", time, wom)
            else if _tf == "1D" // NDOG Logic
                lbl_txt := str.format("{0,date,EEE dd-MM-yyyy} NDOG", time)

            // 4. Create Label (At the end of the extension)
            l_lbl = label.new(x=time + tc, y=_ce, text=lbl_txt, xloc=xloc.bar_time, textcolor=gap_border_clr, style=label.style_label_left, color=color.new(color.white, 100), size=size.small)

            // Store in arrays
            array.unshift(nwox_top_lines, l_top)
            array.unshift(nwox_bot_lines, l_bot)
            array.unshift(nwox_ce_lines, l_ce)
            array.unshift(nwox_link_lines, l_link)
            array.unshift(nwox_fills, l_fill)
            array.unshift(nwox_labels, l_lbl)
            
            // Maintain Array Size Limit
            if array.size(nwox_top_lines) > 60 // Keep a generous buffer for lookback
                line.delete(array.pop(nwox_top_lines))
                line.delete(array.pop(nwox_bot_lines))
                line.delete(array.pop(nwox_ce_lines))
                line.delete(array.pop(nwox_link_lines))
                linefill.delete(array.pop(nwox_fills))
                label.delete(array.pop(nwox_labels))

    // --- Logic for Extending Lines, Moving Labels/Links, and Detecting Taps ---
    dxx   = ta.atr(20)/2
    hmax  = array.get(N_ext,0), lmin  = array.get(N_ext,1)
    hmaxD = array.get(D_ext,0), lminD = array.get(D_ext,1)
    hmaxW = array.get(W_ext,0), lminW = array.get(W_ext,1)
    hmaxm = array.get(m_ext,0), lminm = array.get(m_ext,1)    

    if array.size(nwox_top_lines) > 0
        for i = array.size(nwox_top_lines)-1 to 0
            l_top  = array.get(nwox_top_lines, i)
            l_bot  = array.get(nwox_bot_lines, i)
            l_ce   = array.get(nwox_ce_lines, i)
            l_link = array.get(nwox_link_lines, i)
            l_lbl  = array.get(nwox_labels, i)
            
            top = line.get_y1(l_top)
            bot = line.get_y1(l_bot)
            
            // Extend Horizontal Lines to current bar + buffer (tc)
            line.set_x2(l_top, time + tc)
            line.set_x2(l_bot, time + tc)
            line.set_x2(l_ce,  time + tc)
            
            // Move Vertical Link Line to current bar + buffer (tc)
            line.set_x1(l_link, time + tc)
            line.set_x2(l_link, time + tc)

            // Move Label to current bar + buffer (tc)
            label.set_x(l_lbl, time + tc)

            // Tap Logic
            if math.abs(bot - high) <= dxx or math.abs(low - top) <= dxx or (high <= top and low >= bot) or (high >= bot and low <= top)
                _tap := true
            if ((hmax > top and lmin < top + dxx) or ( top >= hmax and bot <= lmin)) and tf_ok 
                ltap90 := true
            if ((lmin < bot and hmax > bot - dxx) or ( top >= hmax and bot <= lmin)) and tf_ok 
                htap90 := true
            if ((hmaxW > top and lminW < top + dxx) or ( top >= hmaxW and bot <= lminW)) and tf_okW 
                ltapW := true
            if ((lminW < bot and hmaxW > bot - dxx) or ( top >= hmaxW and bot <= lminW)) and tf_okW 
                htapW := true  
            if ((hmaxD > top and lminD < top + dxx) or ( top >= hmaxD and bot <= lminD)) and tf_okD 
                ltapD := true
            if ((lminD < bot and hmaxD > bot - dxx) or ( top >= hmaxD and bot <= lminD)) and tf_okD 
                htapD := true                 
            if ((hmaxm > top and lminm < top + dxx) or ( top >= hmaxm and bot <= lminm)) and tf_ok_mic 
                ltapm := true
            if ((lminm < bot and hmaxm > bot - dxx) or ( top >= hmaxm and bot <= lminm)) and tf_ok_mic 
                htapm := true

    // --- Cleanup Old Objects ---
    // In Auto mode, limit by number. In Manual, we only ever have one.
    int final_del = del
    if _tf == "1W"
        final_del := nwog_mode == "Auto" ? nwog_num_auto : 1

    if array.size(nwox_top_lines) > final_del
        for i = array.size(nwox_top_lines)-1 to final_del
            // Check if we are in manual mode and the line to be deleted is the one we want to keep
            if _tf == "1W" and manual_gap_found and line.get_x1(array.get(nwox_top_lines, i)) == manual_gap_time
                continue

            line.delete(array.pop(nwox_top_lines))
            line.delete(array.pop(nwox_bot_lines))
            line.delete(array.pop(nwox_ce_lines))
            line.delete(array.pop(nwox_link_lines))
            linefill.delete(array.pop(nwox_fills))
            label.delete(array.pop(nwox_labels))

    // Return values
    [_tap, ltapW, htapW, ltapD, htapD, ltap90, htap90, ltapm, htapm]

// -----------------------------------------------------------------------------
f_nwox_corele(_tf, fc1, fo0, fh0, fl0, del, fatr, gc) =>
    var nwox_max = array.new_float()
    var nwox_min = array.new_float()
    _tap = false
    
    // Detect New Gap
    if timeframe.change(_tf) 
        _max = math.max(fc1, fo0) // fc1 is close[1] of the correlated symbol
        _min = math.min(fc1, fo0)
        // Only store if gap exists
        if _max - _min >= 1 * syminfo.mintick and not (_tf == "1D" and timeframe.change("1W") and show_nwog)
            // Use generic array push if add_to_array_box isn't working for floats, 
            // or keep your helper function if it handles generics.
            // Safe fallback using standard array functions:
            array.unshift(nwox_max, _max)
            if array.size(nwox_max) > 40
                array.pop(nwox_max)
                
            array.unshift(nwox_min, _min)
            if array.size(nwox_min) > 40
                array.pop(nwox_min)

    hmax = array.get(N_ext, 0)
    lmin = array.get(N_ext, 1)  

    dxx = fatr / 2

    if array.size(nwox_max) > 0
        for i = array.size(nwox_max) - 1 to 0
            top = array.get(nwox_max, i)
            bot = array.get(nwox_min, i)
            
            // Logic to detect if price tapped the gap
            if gc == "c" and (math.abs(bot - fh0) <= dxx or math.abs(fl0 - top) <= dxx or (fh0 <= top and fl0 >= bot) or (fh0 >= bot and fl0 <= top))
                _tap := true
            if gc == "l" and ((fh0 > top and fl0 < top + dxx) or (top >= fh0 and bot <= fl0))  
                _tap := true
            if gc == "h" and ((lmin < bot and hmax > bot - dxx) or (top >= hmax and bot <= lmin))  
                _tap := true            

    // Cleanup old values
    if array.size(nwox_max) > del
        for i = array.size(nwox_max) - 1 to del
            array.remove(nwox_max, i)
            array.remove(nwox_min, i)

    _tap

// ///////////////////////////////////////////////🐶 

tapWx = false , tapDx = false
tapWy = false , tapDy = false
[tapW,WltapW,WhtapW, WltapD, WhtapD, Wltap90, Whtap90, Wltapm, Whtapm] = f_nwox_main("1W", Wcolor, nwog_num_auto, show_nwog) // on weekly gap
[tapD,DltapW,DhtapW, DltapD, DhtapD, Dltap90, Dhtap90, Dltapm, Dhtapm] = f_nwox_main("1D", Dcolor, ndog_num, show_ndog) //on daily gap

arr_Wgapx = array.from(false,false,false,false,false,false,false,false)
arr_Dgapx = array.from(false,false,false,false,false,false,false,false)
arr_Wgapy = array.from(false,false,false,false,false,false,false,false)
arr_Dgapy = array.from(false,false,false,false,false,false,false,false)

if dyad_ok 
    tapWx := f_nwox_corele("1W",xc0[1],xo0,xh0,xl0,nwog_mode == "Auto" ? nwog_num_auto : 1,xatr,"c")
    tapDx := f_nwox_corele("1D",xc0[1],xo0,xh0,xl0,ndog_num,xatr,"c")


if triad_ok 
    tapWy := f_nwox_corele("1W",yc0[1],yo0,yh0,yl0,nwog_mode == "Auto" ? nwog_num_auto : 1,yatr,"c")
    tapDy := f_nwox_corele("1D",yc0[1],yo0,yh0,yl0,ndog_num,yatr,"c")
    


gaptxtW = "on NWOG => " + (tapW ? str.tostring(syminfo.ticker(sym)) : " ") +" " + (tapWx ? str.tostring(syminfo.ticker(csym)) : " ") +" " + (tapWy ? str.tostring(syminfo.ticker(tsym3)) : " ") 
gaptxtD = "on NDOG => " + (tapD ? str.tostring(syminfo.ticker(sym)) : " ") +" " + (tapDx ? str.tostring(syminfo.ticker(csym)) : " ") +" " + (tapDy ? str.tostring(syminfo.ticker(tsym3)) : " ") 

if show_table and show_nxog
    table.cell(tablo,0,4,text= gaptxtW ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = ii_font,text_formatting = text.format_bold)
    table.cell(tablo,0,5,text= gaptxtD ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = ii_font,text_formatting = text.format_bold)        


///////////////////////////////////////////////////////////////Alerts
f_alert(a_con1,a_con2,a_con3,number)=>
    var bull_alert_trigger = false
    var bear_alert_trigger = false
   
////////////////////normal ssmt
    nbull_control_con1 =
     a_con1 == Mobu ? array.get(M_SSMT,3) or array.get(M_SSMT,7) : // Monthly
     a_con1 == Wbu ? array.get(W_SSMT,3) or array.get(W_SSMT,7) : 
     a_con1 == Dbu ? array.get(D_SSMT,3) or array.get(D_SSMT,7) : 
     a_con1 == Qbu ? array.get(Q_SSMT,3) or array.get(Q_SSMT,7) :
     a_con1 == Ybu ? array.get(Y_SSMT,3) or array.get(Y_SSMT,7) :
     a_con1 == Nbu ? array.get(N_SSMT,3) or array.get(N_SSMT,7) :
     a_con1 == mbu ? array.get(m_SSMT,3) or array.get(m_SSMT,7):
     a_con1 == "none" ? true : false   
    nbear_control_con1 =
     a_con1 == Mobe ? array.get(M_SSMT,1) or array.get(M_SSMT,6): // Monthly
     a_con1 == Wbe ? array.get(W_SSMT,1) or array.get(W_SSMT,6): 
     a_con1 == Dbe ? array.get(D_SSMT,1) or array.get(D_SSMT,6):
     a_con1 == Qbe ? array.get(Q_SSMT,1) or array.get(Q_SSMT,6):
     a_con1 == Ybe ? array.get(Y_SSMT,1) or array.get(Y_SSMT,6):
     a_con1 == Nbe ? array.get(N_SSMT,1) or array.get(N_SSMT,6):
     a_con1 == mbe ? array.get(m_SSMT,1) or array.get(m_SSMT,6):
     a_con1 == "none" ? true : false 

    bull_control_con2 =
     a_con2 == tf1bu ? array.get(TF1_TPD,0) : 
     a_con2 == tf2bu ? array.get(TF2_TPD,0) : 
     a_con2 == tf3bu ? array.get(TF3_TPD,0) :
     a_con2 == "none"  ? true : false   
 
    bear_control_con2 =
     a_con2 == tf1be ? array.get(TF1_TPD,1) : 
     a_con2 == tf2be ? array.get(TF2_TPD,1) : 
     a_con2 == tf3be ? array.get(TF3_TPD,1) :
     a_con2 == "none"  ? true : false 


    nbull_control_con3 =
     a_con3 == Mobu ? array.get(M_SSMT,3) or array.get(M_SSMT,7) : // Monthly
     a_con3 == Wbu ? array.get(W_SSMT,3) or array.get(W_SSMT,7) :
     a_con3 == Dbu ? array.get(D_SSMT,3) or array.get(D_SSMT,7) : 
     a_con3 == Qbu ? array.get(Q_SSMT,3) or array.get(Q_SSMT,7) :
     a_con3 == Ybu ? array.get(Y_SSMT,3) or array.get(Y_SSMT,7) :
     a_con3 == Nbu ? array.get(N_SSMT,3) or array.get(N_SSMT,7):
     a_con3 == mbu ? array.get(m_SSMT,3) or array.get(m_SSMT,7):
     a_con3 == "none" ? true : false   
    nbear_control_con3 =
     a_con3 == Mobe ? array.get(M_SSMT,1) or array.get(M_SSMT,6) : // Monthly
     a_con3 == Wbe  ? array.get(W_SSMT,1) or array.get(W_SSMT,6) :
     a_con3 == Dbe  ? array.get(D_SSMT,1) or array.get(D_SSMT,6) : 
     a_con3 == Qbe  ? array.get(Q_SSMT,1) or array.get(Q_SSMT,6) :
     a_con3 == Ybe  ? array.get(Y_SSMT,1) or array.get(Y_SSMT,6) :
     a_con3 == Nbe  ? array.get(N_SSMT,1) or array.get(N_SSMT,6):
     a_con3 == mbe  ? array.get(m_SSMT,1) or array.get(m_SSMT,6):
     a_con3 == "none" ? true : false

////////////////////hidden ssmt
    hbull_control_con1 =
     a_con1 == Mobu ? array.get(M_SSMT,5) or array.get(M_SSMT,9) : // Monthly
     a_con1 == Wbu ? array.get(W_SSMT,5) or array.get(W_SSMT,9) : 
     a_con1 == Dbu ? array.get(D_SSMT,5) or array.get(D_SSMT,9):
     a_con1 == Qbu ? array.get(Q_SSMT,5) or array.get(Q_SSMT,9):
     a_con1 == Ybu ? array.get(Y_SSMT,5) or array.get(Y_SSMT,9):
     a_con1 == Nbu ? array.get(N_SSMT,5) or array.get(N_SSMT,9):
     a_con1 == mbu ? array.get(m_SSMT,5) or array.get(m_SSMT,9):
     a_con1 == "none" ? true : false   
    hbear_control_con1 =
     a_con1 == Mobe ? array.get(M_SSMT,4) or array.get(M_SSMT,8): // Monthly
     a_con1 == Wbe ? array.get(W_SSMT,4) or array.get(W_SSMT,8): 
     a_con1 == Dbe ? array.get(D_SSMT,4) or array.get(D_SSMT,8):
     a_con1 == Qbe ? array.get(Q_SSMT,4) or array.get(Q_SSMT,8):
     a_con1 == Ybe ? array.get(Y_SSMT,4) or array.get(Y_SSMT,8):
     a_con1 == Nbe ? array.get(N_SSMT,4) or array.get(N_SSMT,8):
     a_con1 == mbe ? array.get(m_SSMT,4) or array.get(m_SSMT,8):
     a_con1 == "none" ? true : false 

    hbull_control_con3 =
     a_con3 == Mobu ? array.get(M_SSMT,5) or array.get(M_SSMT,9) : // Monthly
     a_con3 == Wbu ? array.get(W_SSMT,5) or array.get(W_SSMT,9) :
     a_con3 == Dbu ? array.get(D_SSMT,5) or array.get(D_SSMT,9):
     a_con3 == Qbu ? array.get(Q_SSMT,5) or array.get(Q_SSMT,9):
     a_con3 == Ybu ? array.get(Y_SSMT,5) or array.get(Y_SSMT,9):
     a_con3 == Nbu ? array.get(N_SSMT,5) or array.get(N_SSMT,9):
     a_con3 == mbu ? array.get(m_SSMT,5) or array.get(m_SSMT,9):
     a_con3 == "none" ? true : false   
    hbear_control_con3 =
     a_con3 == Mobe ? array.get(M_SSMT,4) or array.get(M_SSMT,8): // Monthly
     a_con3 == Wbe  ? array.get(W_SSMT,4) or array.get(W_SSMT,8):
     a_con3 == Dbe  ? array.get(D_SSMT,4) or array.get(D_SSMT,8):
     a_con3 == Qbe  ? array.get(Q_SSMT,4) or array.get(Q_SSMT,8):
     a_con3 == Ybe  ? array.get(Y_SSMT,4) or array.get(Y_SSMT,8):
     a_con3 == Nbe  ? array.get(N_SSMT,4) or array.get(N_SSMT,8):
     a_con3 == mbe  ? array.get(m_SSMT,4) or array.get(m_SSMT,8):
     a_con3 == "none" ? true : false
//////////////////////////////////////////////////////

    newcyc1 = str.contains(a_con1,"Y") ? newY : str.contains(a_con1,"Q") ? newQ : str.contains(a_con1,"M") ? newMo : str.contains(a_con1,"W") ? newW : str.contains(a_con1,"D") ? newD : str.contains(a_con1,"N") ? newN : str.contains(a_con1,"m") ? newm : false
    newcyc3 = str.contains(a_con3,"Y") ? newY : str.contains(a_con3,"Q") ? newQ : str.contains(a_con3,"M") ? newMo : str.contains(a_con3,"W") ? newW : str.contains(a_con3,"D") ? newD : str.contains(a_con3,"N") ? newN : str.contains(a_con3,"m") ? newm : false
    newcyc  = newcyc1 or newcyc3
    if newcyc
        bull_alert_trigger := false
        bear_alert_trigger := false    
//////////////////////////////////////////////////////
  

    bull_control_con1 = 
     alerttype == "All" ? nbull_control_con1 or hbull_control_con1 : 
     alerttype == "Normal" ? nbull_control_con1 : hbull_control_con1

    bear_control_con1 = 
     alerttype == "All" ? nbear_control_con1 or hbear_control_con1 : 
     alerttype == "Normal" ? nbear_control_con1 : hbear_control_con1
 
    bull_control_con3 = 
     alerttype == "All" ? nbull_control_con1 or hbull_control_con1 : 
     alerttype == "Normal" ? nbull_control_con1 : hbull_control_con1

    bear_control_con3 = 
     alerttype == "All" ? nbear_control_con3 or hbear_control_con3 : 
     alerttype == "Normal" ? nbear_control_con3 : hbear_control_con3


    bull_alert = bull_control_con1 and bull_control_con2 and bull_control_con3  and not (a_con1 == "none" and a_con2 == "none" and a_con3 == "none" ) 
    if bull_alert and bull_alert_trigger == false
        alert(number+" 🟢 Bullish Selection Active " + '\n' + a_con1 +" " + a_con2+ " " + a_con3  + '\n'+ " " ,alert.freq_once_per_bar)
        bull_alert_trigger := true
    bear_alert = bear_control_con1 and bear_control_con2 and bear_control_con3   and not (a_con1 == "none" and a_con2 == "none" and a_con3 == "none" ) 
    if bear_alert and bear_alert_trigger == false
        alert(number+" 🔴 Bearish Selection Active "+ '\n' + a_con1 +" " + a_con2+ " " + a_con3 + " " + '\n'+ " ",alert.freq_once_per_bar)
        bear_alert_trigger := true

    if bull_alert[1] and bull_alert == false
        bull_alert_trigger := false
    if bear_alert[1] and bear_alert == false
        bear_alert_trigger := false 

if al1ok
    f_alert(al_con1,al_con2,al_con3,"1")
if al2ok
    f_alert(bl_con1,bl_con2,bl_con3,"2")
if al3ok
    f_alert(cl_con1,cl_con2,cl_con3,"3")
if al4ok
    f_alert(dl_con1,dl_con2,dl_con3,"4")
if show_table
    if show_stat    
        table.cell(tablo,0,3,text= lbl2 ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = ii_font,text_formatting = text.format_bold)
    if show_sstb 
        table.cell(tablo,0,6,text= "---------- SSMT ----------" ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = ii_font,text_formatting = text.format_bold)
        table.cell(tablo,0,7,text= array.get(m_label,0) ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = ii_font,text_formatting = text.format_bold)
        table.cell(tablo,0,8,text= array.get(N_label,0) ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = ii_font,text_formatting = text.format_bold)
        table.cell(tablo,0,9,text= array.get(D_label,0) ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = ii_font,text_formatting = text.format_bold)
        table.cell(tablo,0,10,text= array.get(W_label,0) ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = ii_font,text_formatting = text.format_bold)
        table.cell(tablo,0,11,text= array.get(M_label,0) ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = ii_font,text_formatting = text.format_bold)
        table.cell(tablo,0,12,text= array.get(Q_label,0) ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = ii_font,text_formatting = text.format_bold)
        table.cell(tablo,0,13,text= array.get(Y_label,0) ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = ii_font,text_formatting = text.format_bold)
    if show_bias
        table.cell(tablo,0,14,text= "----------- Bias ---------" ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = ii_font,text_formatting = text.format_bold)
        if tf_ok_mic
            table.cell(tablo,0,15,text= "Micro :" + array.get(m_bias,0) ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = ii_font,text_formatting = text.format_bold)
        if tf_ok
            table.cell(tablo,0,16,text= "90m   :" + array.get(N_bias,0) ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = ii_font,text_formatting = text.format_bold)
        if tf_okD
            table.cell(tablo,0,17,text= "Daily :" + array.get(D_bias,0) ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = ii_font,text_formatting = text.format_bold)
        if tf_okW
            table.cell(tablo,0,18,text= "Weekly:" + array.get(W_bias,0) ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = ii_font,text_formatting = text.format_bold)  
        if tf_okMo
            table.cell(tablo,0,19,text= "Monthly:" + array.get(M_bias,0) ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = ii_font,text_formatting = text.format_bold)
        if tf_okQ
            table.cell(tablo,0,20,text= "Quarterly:" + array.get(Q_bias,0) ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = ii_font,text_formatting = text.format_bold)
        if tf_okY
            table.cell(tablo,0,21,text= "Yearly:" + array.get(Y_bias,0) ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = ii_font,text_formatting = text.format_bold)
    //table.cell(tablo,0,16,text= str.tostring(triad_ok) ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = ii_font,text_formatting = text.format_bold)        
       
//------------------------------------------------------------------------------
// MERGED FVG SCRIPT
//------------------------------------------------------------------------------
// int ext_fvg = (time - time[1]) * 5
int ext_fvg = timeframe.in_seconds(timeframe.period)*1000 * 5
var string fvg_tf = na, var string fvg_lbl = na
if barstate.isfirst
    m = timeframe.multiplier
    fvg_tf := timeframe.isminutes ? (m==1?"15": m==3?"30": m==5?"60": m==15?"240": m==60?"1D": m==240?"1W": "1D") : timeframe.isdaily ? (m==1?"1W":"1M") : timeframe.isweekly ? "1M" : "1D"
    fvg_lbl := fvg_tf == "15" ? "15m" : fvg_tf == "30" ? "30m" : fvg_tf == "60" ? "1h" : fvg_tf == "240" ? "4h" : fvg_tf

[mx_h3, mx_l3, mx_c3, mx_o3, mx_t3, mx_h2, mx_l2, mx_c2, mx_o2, mx_t2, mx_h1, mx_l1, mx_c1, mx_o1, mx_t1, mx_h0, mx_l0, mx_c0, mx_o0, mx_t0, mx_up1, mx_dw1, mx_l1t, mx_h1t] = f_live_sym(close, open, high, low, time, fvg_tf)
[p2_h3, p2_l3, p2_c3, p2_o3, p2_t3, p2_h2, p2_l2, p2_c2, p2_o2, p2_t2, p2_h1, p2_l1, p2_c1, p2_o1, p2_t1, p2_h0, p2_l0, p2_c0, p2_o0, p2_t0, p2_up1, p2_dw1, p2_l1t, p2_h1t] = f_live_sym(xc0, xo0, xh0, xl0, xt0, fvg_tf)
[p3_h3, p3_l3, p3_c3, p3_o3, p3_t3, p3_h2, p3_l2, p3_c2, p3_o2, p3_t2, p3_h1, p3_l1, p3_c1, p3_o1, p3_t1, p3_h0, p3_l0, p3_c0, p3_o0, p3_t0, p3_up1, p3_dw1, p3_l1t, p3_h1t] = f_live_sym(yc0, yo0, yh0, yl0, yt0, fvg_tf)

type fvg_box
    line t
    line b
    line c
    line l1
    line l2
    linefill f
    label lb
    float top
    float bot
    float p2
    float p3
    bool is_b
    bool mit
    bool p2h
    bool p3h
var fvg_box[] fvg_list = array.new<fvg_box>()

f_add_fvg(is_b, y1, y2, t3, clr, p2h, p2l, p3h, p3l) =>
    ce = (y1 + y2) / 2, inv0 = array.get(arr_inv, 0), inv1 = array.get(arr_inv, 1)
    t_ln = line.new(t3, y1, time, y1, xloc=xloc.bar_time, color=clr), b_ln = line.new(t3, y2, time, y2, xloc=xloc.bar_time, color=clr)
    array.push(fvg_list, fvg_box.new(t_ln, b_ln, line.new(t3, ce, time, ce, xloc=xloc.bar_time, color=i_textcolor, style=line.style_dashed), line.new(time, y1, time, y2, xloc=xloc.bar_time, color=clr, width=3), line.new(t3, y1, t3, y2, xloc=xloc.bar_time, color=clr, width=3), linefill.new(t_ln, b_ln, color.new(clr, 90)), label.new(time, ce, "", xloc=xloc.bar_time, textcolor=i_textcolor, color=color.new(color.white, 100), style=label.style_label_left, size=fvg_sz), math.max(y1, y2), math.min(y1, y2), is_b ? (inv0 ? p2h : p2l) : (inv0 ? p2l : p2h), is_b ? (inv1 ? p3h : p3l) : (inv1 ? p3l : p3h), is_b, false, false, false))

if ta.change(mx_t1) != 0 and showfill and not (sym == csym and sym == tsym3)
    if mx_l1 > mx_h3
        f_add_fvg(true, mx_h3, mx_l1, mx_t3, fvg_bull_clr, p2_h1, p2_l1, p3_h1, p3_l1)
    if mx_h1 < mx_l3
        f_add_fvg(false, mx_l3, mx_h1, mx_t3, fvg_bear_clr, p2_h1, p2_l1, p3_h1, p3_l1)

if array.size(fvg_list) > max_fvg_display
    f = array.shift(fvg_list), line.delete(f.t), line.delete(f.b), line.delete(f.c), line.delete(f.l1), line.delete(f.l2), linefill.delete(f.f), label.delete(f.lb)

if array.size(fvg_list) > 0
    inv0 = array.get(arr_inv, 0), inv1 = array.get(arr_inv, 1)
    for i = array.size(fvg_list) - 1 to 0
        f = array.get(fvg_list, i)
        if not f.mit
            line.set_x2(f.t, time + ext_fvg), line.set_x2(f.b, time + ext_fvg), line.set_x2(f.c, time + ext_fvg), line.set_x1(f.l1, time + ext_fvg), line.set_x2(f.l1, time + ext_fvg), label.set_x(f.lb, time + ext_fvg)
            if f.is_b ? low < f.bot : high > f.top
                f.mit := true
            if not f.p2h and ((f.is_b == not inv0) ? xl0 < f.p2 : xh0 > f.p2)
                f.p2h := true
            if not f.p3h and ((f.is_b == not inv1) ? yl0 < f.p3 : yh0 > f.p3)
                f.p3h := true
            label.set_text(f.lb, fvg_lbl + " " + (f.p2h ? ssmt_pair + " " : "") + (f.p3h ? ssmt_pair2 : ""))
        else
            line.delete(f.t), line.delete(f.b), line.delete(f.c), line.delete(f.l1), line.delete(f.l2), linefill.delete(f.f), label.delete(f.lb), array.remove(fvg_list, i)

get_style(s) =>
    s == 'Dashed' ? line.style_dashed : s == 'Dotted' ? line.style_dotted : line.style_solid

manage_layer(bool cond, bool tf_visible, CycleLayer layer, string id_text) =>
    if cond and tf_visible
        color phase_col = color.gray
        if id_text == 'Q1' or id_text == 'W1' or id_text == 'A'
            phase_col := q1_box_clr
            phase_col
        else if id_text == 'Q2' or id_text == 'W2' or id_text == 'M'
            phase_col := q2_box_clr
            phase_col
        else if id_text == 'Q3' or id_text == 'W3' or id_text == 'D'
            phase_col := q3_box_clr
            phase_col
        else if id_text == 'Q4' or id_text == 'W4' or id_text == 'X'
            phase_col := q4_box_clr
            phase_col
        else if id_text == 'Fr'
            phase_col := color.orange
            phase_col

        b_c = layer.show_box ? color.new(phase_col, 50) : color.new(phase_col, 100)
        bg_c = layer.show_box ? color.new(phase_col, 90) : color.new(phase_col, 100)
        if layer.show_line
            line.new(bar_index, low, bar_index, high, extend = extend.both, color = color.new(phase_col, 70), style = get_style(layer.b_style))
        nb = box.new(bar_index, high, bar_index, low, border_color = b_c, bgcolor = bg_c, border_width = layer.b_width, border_style = get_style(layer.b_style))
        array.push(layer.boxes, nb)
        nl = label.new(bar_index, high, text = layer.show_label ? id_text : '', color = color.new(color.white, 100), textcolor = phase_col, style = label.style_label_down, size = size.small)
        array.push(layer.labels, nl)
        if array.size(layer.boxes) > layer.limit
            box.delete(array.shift(layer.boxes))
            label.delete(array.shift(layer.labels))

update_box_visual(bool tf_visible, CycleLayer layer) =>
    if array.size(layer.boxes) > 0
        b = array.get(layer.boxes, array.size(layer.boxes) - 1)
        l = array.get(layer.labels, array.size(layer.labels) - 1)
        box.set_top(b, layer.h)
        box.set_bottom(b, layer.l)
        box.set_right(b, bar_index)
        label.set_xy(l, math.round(math.avg(box.get_left(b), bar_index)), layer.h)

var lbl_q = array.from('Q1', 'Q2', 'Q3', 'Q4')
var lbl_w = array.from('W1', 'W2', 'W3', 'W4', 'Gap')
var lbl_d = array.from('A', 'M', 'D', 'X', 'Fr', 'Sat', 'Sun')
var lbl_gen = array.from('A', 'M', 'D', 'X')

get_lbl(arr, idx) =>
    if idx >= 1 and idx <= array.size(arr)
        array.get(arr, idx - 1)
    else
        ''

manage_layer(bool(new_year), tf_okY_V, Year, get_lbl(lbl_q, qYear))
manage_layer(bool(new_quart), tf_okQ_V, Quart, get_lbl(lbl_q, q2Month))
manage_layer(bool(new_month), tf_okMo_V, Month, get_lbl(lbl_w, qMonth))
manage_layer(bool(new_week), tf_okW_V, Day, get_lbl(lbl_d, qWeek))
manage_layer(bool(new_daily), tf_okD_V, Ana, get_lbl(lbl_gen, qDay))
manage_layer(bool(new_90m), tf_ok_V, Sub, get_lbl(lbl_gen, q90))
manage_layer(bool(new_micro), tf_ok_mic_V, Micro, get_lbl(lbl_gen, qMicro))

update_box_visual(tf_okY_V, Year)
update_box_visual(tf_okQ_V, Quart)
update_box_visual(tf_okMo_V, Month)
update_box_visual(tf_okW_V, Day)
update_box_visual(tf_okD_V, Ana)
update_box_visual(tf_ok_V, Sub)
update_box_visual(tf_ok_mic_V, Micro)
//------------------------------------------------------------------------------
// END OF SCRIPT
