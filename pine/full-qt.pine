f_manage_level_box(box _b, int _l, float _lvl, int _r, string _txt, color _clr) =>
    box res = _b
    if na(res)
        res := box.new(_l, _lvl, _r, _lvl, xloc=xloc.bar_time, border_color=_clr, bgcolor=color.new(color.red,100), text=_txt, text_color=_clr, text_valign=text.align_bottom, text_halign=text.align_right, text_size=size.small, border_style=line.style_solid)
    else
        box.set_left(res, _l)
        box.set_top(res, _lvl)
        box.set_bottom(res, _lvl)
        box.set_right(res, _r)
        box.set_border_color(res, _clr)
        box.set_text_color(res, _clr)
        box.set_text(res, _txt)
    res

type SessionState
    float h = na
    int ht = na
    float l = na
    int lt = na
    bool hs = false
    int hst = na
    bool ls = false
    int lst = na
    float cur_h = high
    int cur_ht = time
    float cur_l = low
    int cur_lt = time
    box bh = na
    box bl = na

f_update_htf_state(SessionState s, bool new_period) =>
    if new_period
        s.h := s.cur_h, s.ht := s.cur_ht
        s.l := s.cur_l, s.lt := s.cur_lt
        s.cur_h := high, s.cur_ht := time
        s.cur_l := low, s.cur_lt := time
        s.hs := false, s.ls := false
    else
        if high > s.cur_h
            s.cur_h := high, s.cur_ht := time
        if low < s.cur_l
            s.cur_l := low, s.cur_lt := time
            
    if not s.hs and not na(s.h) and high > s.h
        s.hs := true, s.hst := time
    if not s.ls and not na(s.l) and low < s.l
        s.ls := true, s.lst := time
    0

f_update_session_state(SessionState s, bool active) =>
    if active
        if not active[1]
            s.h := high, s.ht := time
            s.l := low, s.lt := time
            s.hs := false, s.ls := false
        else
            if high > s.h
                s.h := high, s.ht := time
            if low < s.l
                s.l := low, s.lt := time
    else
        if not s.hs and not na(s.h) and high > s.h
            s.hs := true, s.hst := time
        if not s.ls and not na(s.l) and low < s.l
            s.ls := true, s.lst := time
    0

f_render_state(SessionState s, bool show, string txt_h, string txt_l, color c, int dt) =>
    if show and not na(s.h)
        s.bh := f_manage_level_box(s.bh, s.ht, s.h, s.hs ? s.hst : time + 15*dt, txt_h, c)
        s.bl := f_manage_level_box(s.bl, s.lt, s.l, s.ls ? s.lst : time + 15*dt, txt_l, c)
    else
        box.delete(s.bh), s.bh := na
        box.delete(s.bl), s.bl := na

var pd_state = SessionState.new()
f_update_htf_state(pd_state, ta.change(time("D")) != 0)
f_render_state(pd_state, show_PDHL, "PDH", "PDL", pdhl_clr, dt)

