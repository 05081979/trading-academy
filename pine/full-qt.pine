    array.set(TF2_TPD,1,tf2_bear_tpd)       
if tf3ok and timeframe.in_seconds(tf) <= timeframe.in_seconds(tf3)and triad_ok
    [tf3_psp,tf3_bull_tpd,tf3_bear_tpd] = f_psp_tpd_triad(tf3,1) 
