// Helper functions to convert NWOG manual string inputs to numbers
f_month_from_string(s) =>
    s == "January" ? 1 : s == "February" ? 2 : s == "March" ? 3 : s == "April" ? 4 : s == "May" ? 5 : s == "June" ? 6 : s == "July" ? 7 : s == "August" ? 8 : s == "September" ? 9 : s == "October" ? 10 : s == "November" ? 11 : 12

f_quarter_from_string(s) =>
    s == "Q1" ? 1 : s == "Q2" ? 2 : s == "Q3" ? 3 : 4


