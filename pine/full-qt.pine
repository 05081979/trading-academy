g20 = "Daily Opeing Range Gap"
dot_line=" ------------------------------ "
canvas_theme    = input.string("Light", "Theme", options=["Dark", "Light", "Custom"], inline= "al0", group = g0, tooltip="Pine Script cannot detect chart theme automatically. Please select manually.")
modeltype       = input.string(defval =  mdl1, title = "Settings => ", options=[ mdl1, mdl2 ],inline= "al0",group = g0,tooltip= " Micro => 1-2m,'\n' 90m =>3m-10m, '\n'Daily=> 15-30m, '\n'Weekly => h1-12h, '\n' Effect => Visibility")
