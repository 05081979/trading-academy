tf_okMo = timeframe.in_seconds(tf) <= timeframe.in_seconds("360")
tf_okQ = timeframe.in_seconds(tf) <= timeframe.in_seconds("1D")
tf_okY  = timeframe.in_seconds(tf) <= timeframe.in_seconds("1M")

// --- Visibility Logic ---
// Auto Mode: Use the timeframe ranges defined in the inputs.
// Manual Mode: Use the user-requested timeframe filters.

// Micro SSMT Visibility: Show on <= 2m charts in Manual mode.
type CycleLayer
	array<box> boxes
	array<label> labels
	float o
	float h
	float l
	float c
	float last_h
	float last_l
	int limit
	int b_width
	string b_style
	bool show_box
	bool show_line
	bool show_label
	string current_id

tf_ok_mic_V = modeltype == mdl1 ? (timeframe.in_seconds(tf) >= timeframe.in_seconds(botm) and timeframe.in_seconds(tf) <= timeframe.in_seconds(topm)) : (timeframe.in_seconds(tf) <= 120)

// 90m SSMT Visibility: Show on <= 15m charts in Manual mode.
tf_ok_V = modeltype == mdl1 ? (timeframe.in_seconds(tf) >= timeframe.in_seconds(botN) and timeframe.in_seconds(tf) <= timeframe.in_seconds(topN)) : (timeframe.in_seconds(tf) <= 600)

// Daily SSMT Visibility: Show on <= 1h charts in Manual mode.
tf_okD_V = modeltype == mdl1 ? (timeframe.in_seconds(tf) >= timeframe.in_seconds(botD) and timeframe.in_seconds(tf) <= timeframe.in_seconds(topD)) : (timeframe.in_seconds(tf) <= 1800)

// Weekly SSMT Visibility: Show on <= 4h charts in Manual mode.
tf_okW_V = modeltype == mdl1 ? (timeframe.in_seconds(tf) >= timeframe.in_seconds(botW) and timeframe.in_seconds(tf) <= timeframe.in_seconds(topW)) : (timeframe.in_seconds(tf) <= 10800)

// Monthly SSMT Visibility: Always show in Manual mode, respect range in Auto mode.
tf_okMo_V = modeltype == mdl1 ? (timeframe.in_seconds(tf) >= timeframe.in_seconds(botMo) and timeframe.in_seconds(tf) <= timeframe.in_seconds(topMo)) : (timeframe.in_seconds(tf) <= 21600)

// Quarterly Cycle Visibility 1 Day only
tf_okQ_V = modeltype == mdl1 ? (timeframe.in_seconds(tf) >= timeframe.in_seconds(botQ) and timeframe.in_seconds(tf) <= timeframe.in_seconds(topQ)) : (timeframe.in_seconds(tf) <= 86400)

// Yearly Cycle Visibility 1 week only
tf_okY_V  = modeltype == mdl1 ? (timeframe.in_seconds(tf) >= timeframe.in_seconds(botY) and timeframe.in_seconds(tf) <= timeframe.in_seconds(topY)) : (timeframe.in_seconds(tf) <= 604800)

var Year = CycleLayer.new(array.new_box(), array.new_label(), na, na, na, na, na, na, 5, y_width, y_style, y_show_b, y_show_l, y_show_lbl, '')
var Quart = CycleLayer.new(array.new_box(), array.new_label(), na, na, na, na, na, na, 10, q_width, q_style, q_show_b, q_show_l, q_show_lbl, '')
var Month = CycleLayer.new(array.new_box(), array.new_label(), na, na, na, na, na, na, 15, mo_width, mo_style, mo_show_b, mo_show_l, mo_show_lbl, '')
var Day = CycleLayer.new(array.new_box(), array.new_label(), na, na, na, na, na, na, 20, d_width, d_style, d_show_b, d_show_l, d_show_lbl, '')
var Ana = CycleLayer.new(array.new_box(), array.new_label(), na, na, na, na, na, na, 50, m_width, m_style, m_show_b, m_show_l, m_show_lbl, '')
var Sub = CycleLayer.new(array.new_box(), array.new_label(), na, na, na, na, na, na, 100, s_width, s_style, s_show_b, s_show_l, s_show_lbl, '')
var Micro = CycleLayer.new(array.new_box(), array.new_label(), na, na, na, na, na, na, 250, mi_width, mi_style, mi_show_b, mi_show_l, mi_show_lbl, '')

type QCISD_Data
    line[] lines
    label[] lbls
    int[] dirs
    bool[] is_hp
    bool[] confirmed



var tablo = table.new(position = i_pos,columns = 2,rows = 22,frame_color=i_textcolor ,frame_width=1,border_color=i_bgcolor ,border_width=1)


/////////////////////////////////////
add_to_array(arr, value) =>
    array.unshift(arr, value)
    if array.size(arr) > num_candles -1
        array.pop(arr)
add_to_array_box(arr, value) =>
    array.unshift(arr, value)
    if array.size(arr) > ssmt_history_limit
        popped_id = array.pop(arr)
        line.delete(popped_id)

add_to_line_array(arr, value) =>
    array.unshift(arr, value)
    if array.size(arr) > ssmt_history_limit
        line.delete(array.pop(arr))

add_to_label_array(arr, value) =>
    array.unshift(arr, value)
    if array.size(arr) > ssmt_history_limit
        label.delete(array.pop(arr))
f_live_sym(_xc0,_xo0,_xh0,_xl0,_xt0,_tf)=>

    var _c1 = 0.0, var _o1 = 0.0 , var _h1 = 0.0, var _l1 = 0.0, var _t1 = 0
    var _c2 = 0.0, var _o2 = 0.0 , var _h2 = 0.0, var _l2 = 0.0, var _t2 = 0 
    var _c3 = 0.0, var _o3 = 0.0 , var _h3 = 0.0, var _l3 = 0.0, var _t3 = 0 
    var up0 = false , var up1 = false
    var dw0 = false , var dw1 = false
    var _l0t = time , var _h0t = time, var _h1t = time , var _l1t = time   
    var _o0 = open
    var _h0 = high
    var _l0 = low
    var _t0 = time
    var _c0 = close
    if timeframe.change(_tf)
        _t0 := _xt0
        _o0 := _xo0
        _h0 := _xh0
        _l0 := _xl0
        
    if _xh0 >= _h0
        _h0 := _xh0
        _h0t := time
    if _xl0 <= _l0
        _l0 := _xl0
        _l0t := time
    _c0 := _xc0
    up0 := _c0 > _o0
    dw0 := _c0 < _o0
    if timeframe.change(_tf)
        _c3  :=  _c2[1]
        _o3  :=  _o2[1]
        _h3  :=  _h2[1]
        _l3  :=  _l2[1]
        _t3  :=  _t2[1]
        _c1  :=  _c0[1]
        _o1  :=  _o0[1]
        _h1  :=  _h0[1]
        _l1  :=  _l0[1]
        _t1  :=  _t0[1]
        _c2  :=  _c1[1]
        _o2  :=  _o1[1]
        _h2  :=  _h1[1]
        _l2  :=  _l1[1]
        _t2  :=  _t1[1] 
        up1  :=  up0[1]
        dw1  :=  dw0[1]
        _l1t :=  _l0t[1]
        _h1t :=  _h0t[1]


    [_h3,_l3,_c3,_o3,_t3,_h2,_l2,_c2,_o2,_t2,_h1,_l1,_c1,_o1,_t1,_h0,_l0,_c0,_o0,_t0,up1,dw1,_l1t,_h1t] 
f_text(string _tf)=>
    _text = str.tonumber(_tf) < 59 ? _tf + 'm'  :
     str.tonumber(_tf) > 59  ? 'h'+ str.tostring(math.floor(str.tonumber(_tf)/60))    : _tf
    _text := _tf == "1D" ? "D" : _tf == "1W" ? "W" : _tf == "1M" ? "M" : _text    
Getcolor_candle(_o,_c)=>
    clr = _c > _o ? bull_clr : _o > _c ? bear_clr : eq_clr
    clr
f_plot_candle(_c,_o,_h,_l,start,i,txt,ty)=>
    dxx =dx
    nn = num_candles
    m = nn - i
    bl0=box.new(left=bar_index+start+dxx+ 0 + m * 3  ,top= _c , right= bar_index+start + dxx + 2 + m * 3 , bottom = _o  , bgcolor = ty == 1 ? Getcolor_candle(_o,_c):color.new(color.black,100), border_color = ty == 1 ? brd_clr : color.new(brd_clr,50), text = txt , text_size = i_font ,text_valign = text.align_center , text_halign = text.align_center ,text_color = color.white)
    wup=box.new(left=bar_index+start+dxx+ 1 + m * 3  ,top= _h , right= bar_index+start + dxx + 1 + m * 3 , bottom = math.max(_o,_c)  , border_color = brd_clr,border_width =1)
    wdw=box.new(left=bar_index+start+dxx+ 1 + m * 3  ,top= _l , right= bar_index+start + dxx + 1 + m * 3 , bottom = math.min(_o,_c) , border_color = brd_clr,border_width =1)
    box.delete(bl0[1])
    box.delete(wup[1])    
    box.delete(wdw[1]) 
///////////////////////////////////////////
RemainingTime(_TF) =>
    if barstate.isrealtime
        timeRemaining = (_TF - timenow) / 1000
        days = math.floor(timeRemaining / 86400)
        hours = math.floor((timeRemaining - days * 86400) / 3600)
        minutes = math.floor((timeRemaining - days * 86400 - hours * 3600) / 60)
        seconds = math.floor(timeRemaining - days * 86400 - hours * 3600 - minutes * 60)

        r = str.tostring(seconds, '00')
        if minutes == 0
            r:= str.tostring(minutes, '00') + ':' + r
            r
        if minutes > 0 or hours > 0 or days > 0
            r := str.tostring(minutes, '00') + ':' + r
            r
        if hours > 0 or days > 0
            r := str.tostring(hours, '00') + ':' + r
            r
        if days > 0
            r := str.tostring(days) + 'D ' + r
            r
        r

    else
        'Market closed' 

var tablo3 = table.new(position = position.bottom_center,columns = 2,rows = 11,frame_color=i_textcolor,frame_width=2,border_color=i_textcolor,border_width=1)
if not str.contains(syminfo.tickerid,"replay")and show_rm and tipo != "futures"
    table.cell(tablo3,0,0,text="TF: " + RemainingTime(time_close(tf)) ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = i_font,text_formatting = text.format_bold)


///////////////////////////////////
var TMO = open, var TWO = open , var TDO = open, TSO = open , var TMSO = open
var TMOt = time, var TWOt = time, var TDOt = time, var TSOt = time, var TMSOt = time

type dfr_item
    line[] lines
    box[] boxes
    label lbl

get_dfr(session, session_name, session_css, show, nn) =>
    var dfr_item[] history = array.new<dfr_item>()
    var t = 0 
    var max = high
    var min = low
    var line bxh = na
    var line bxl = na
    var label lbl = na
    
    // Arrays to manage the 8 levels efficiently (reduces tokens)
    var box[] active_boxes = array.new_box(0)
    var float[] active_levels = array.new_float(0)

    show_txt = show
            
    if session and not session[1]
        t := time
        max := high
        min := low
        
        bxh := line.new(t, max, t, max, xloc=xloc.bar_time, color=session_css, style=line.style_dotted, width=2)
        bxl := line.new(t, min, t, min, xloc=xloc.bar_time, color=session_css, style=line.style_dotted, width=2) 

        if show_txt
            lbl := label.new(t, max, session_name, xloc=xloc.bar_time, textcolor=session_css, style=label.style_label_down, color=color.new(color.white, 100), size=i_font)
        // Store in history
        item = dfr_item.new(array.new_line(), array.new_box(), lbl)
        array.push(item.lines, bxh)
        array.push(item.lines, bxl)
        array.push(history, item)
        // 4. Initialize the boxes for the new session
        array.clear(active_boxes)
        array.clear(active_levels)


        // STRICT MANAGEMENT: 
        // Use a 'while' loop instead of 'if' to force the size to match dfr_cycles
        while array.size(history) > dfr_cycles
            old = array.shift(history)
            for l in old.lines
                line.delete(l)
            for b in old.boxes
                box.delete(b)
            label.delete(old.lbl)

    if session
        max := math.max(high, max)
        min := math.min(low, min)
        line.set_xy1(bxh, t, max)
        line.set_xy2(bxh, time, max)
        line.set_xy1(bxl, t, min)
        line.set_xy2(bxl, time, min)

        if show_txt 
            label.set_xy(lbl, int(math.avg(t, time)), max)
            
        dr = max - min
        
        // Define levels in an array to loop through them
        levels = array.from(max + dr, max + 2 * dr, max + 2.5 * dr, max + 4 * dr, min - dr, min - 2 * dr, min - 2.5 * dr, min - 4 * dr)
        texts  = array.from("1", "2", "2.5", "4", "-1", "-2", "-2.5", "-4")

        if not session[1]
            // NEW SESSION: Create boxes and store in arrays
            array.clear(active_boxes)
            array.clear(active_levels)
            cur_item = array.get(history, array.size(history) - 1)
            
            for i = 0 to 7
                lvl_price = array.get(levels, i)
                txt = array.get(texts, i)
                v_align = i < 4 ? text.align_bottom : text.align_top
                
                bx = box.new(t, lvl_price, time, lvl_price, 
                     xloc=xloc.bar_time, 
                     border_color=session_css, 
                     bgcolor=color.new(color.red, 100), 
                     text=txt, 
                     text_color=session_css, 
                     text_valign=v_align, 
                     text_halign=text.align_right, 
                     text_size=size.tiny, 
                     border_style=line.style_dotted)
                
                array.push(active_boxes, bx)
                array.push(active_levels, lvl_price)
                array.push(cur_item.boxes, bx)
        else
            // DURING SESSION: Update all 8 boxes using a single loop (Token Saver)
            if array.size(active_boxes) > 0
                for i = 0 to array.size(active_boxes) - 1
                    bx_id = array.get(active_boxes, i)
                    pr    = array.get(levels, i) // Use updated price levels
                    box.set_right(bx_id, time)
                    box.set_top(bx_id, pr)
                    box.set_bottom(bx_id, pr)
   

//////////////////////////////////////////////////////////////////////////////////////////
arrstart  = array.from(0, 0, 0, 0, 0, 0, 0)
//-----------------------------------------------------------------------------}
//Sessions
//-----------------------------------------------------------------------------{

f_leap_year(y) =>
    y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)

f_month_length(is_leap, m) =>
    if m == 2
        is_leap ? 29 : 28
    else if (m == 4 or m == 6 or m == 9 or m == 11)
        30
    else
        31

dayStartHour = input.int(18, "Day Start Hour (TZ)", minval=0, maxval=23, group=g1)

msDay   = 24 * 60 * 60 * 1000
msWeek  = 7  * 24 * 60 * 60 * 1000
ms90m   = 90 * 60 * 1000
msMicro = 1350000  // 22.5 minutes in ms

yy  = year(time, tz)
mo  = month(time, tz)
dom = dayofmonth(time, tz)
dow = dayofweek(time, tz)

// Day start (timezone-aware)
dayStartToday = timestamp(tz, yy, mo, dom, dayStartHour, 0)
dayStart      = time >= dayStartToday ? dayStartToday : (dayStartToday - msDay)
minsFromDayStart = int(((time - dayStart) % msDay) / (60 * 1000))  // 0..1439

// Recalculate date components based on dayStart for Cycle alignment
yy_c  = year(dayStart, tz)
mo_c  = month(dayStart, tz)
dom_c = dayofmonth(dayStart, tz)
dow_c = dayofweek(dayStart, tz)

// Cycle IDs
qYear = mo_c <= 3 ? 1 : mo_c <= 6 ? 2 : mo_c <= 9 ? 3 : 4

is_year1 = qYear == 1
is_year2 = qYear == 2
is_year3 = qYear == 3
is_year4 = qYear == 4

qs_m = math.floor((mo_c - 1) / 3) * 3 + 1
qs_t = timestamp(tz, yy_c, qs_m, 1, dayStartHour, 0)
qe_t = timestamp(tz, yy_c, qs_m + 3, 1, dayStartHour, 0)
q_dur = qe_t - qs_t
q2Month = int(math.floor((time - qs_t) / q_dur * 4)) + 1
q2Month := math.max(1, math.min(4, q2Month))
is_quarter1 = q2Month == 1
is_quarter2 = q2Month == 2
is_quarter3 = q2Month == 3
is_quarter4 = q2Month == 4

curr_week  = weekofyear(dayStart + msDay, tz)
days_in_mo = f_month_length(f_leap_year(yy_c), mo_c)
day_end_mo = days_in_mo - dom_c

iso_year = yy_c
if mo_c == 12 and curr_week == 1
    iso_year := yy_c + 1
else if mo_c == 1 and curr_week >= 52
    iso_year := yy_c - 1

t_jan1 = timestamp(tz, iso_year, 1, 1, 0, 0)
d_jan1 = dayofweek(t_jan1, tz)
is_leap_iso = (iso_year % 4 == 0 and (iso_year % 100 != 0 or iso_year % 400 == 0))
weeks_in_year = (d_jan1 == dayofweek.thursday or (d_jan1 == dayofweek.wednesday and is_leap_iso)) ? 53 : 52

// Automatic Cycle Adjustment:
// - 52-week years: Continuous W1-W4 cycles.
// - 53-week years: Week 1 is Gap (5), then W1-W4 cycles start from Week 2.
qMonth = weeks_in_year == 53 ? (curr_week == 1 ? 5 : ((curr_week - 2) % 4) + 1) : ((curr_week - 1) % 4) + 1

Full_Week_Count = curr_week

qWeek = dow_c == dayofweek.sunday ? 1 : dow_c == dayofweek.monday ? 2 : dow_c == dayofweek.tuesday ? 3 : dow_c == dayofweek.wednesday ? 4 : dow_c == dayofweek.thursday ? 5 : dow_c == dayofweek.friday ? 6 : dow_c == dayofweek.saturday ? 7 : na

qDay = int(math.floor(minsFromDayStart / 360)) + 1  // 1..4

minsIn6H = minsFromDayStart % 360
q90 = int(math.floor(minsIn6H / 90)) + 1 // 1..4

msInto90 = int((time - dayStart) % ms90m)
qMicro = int(math.floor(msInto90 / msMicro)) + 1
qMicro := qMicro < 1 ? 1 : qMicro > 4 ? 4 : qMicro

update_data(CycleLayer layer, bool is_new) =>
    if is_new
        layer.last_h := layer.h
        layer.last_l := layer.l
        layer.o := open
        layer.h := high
        layer.l := low
        layer.c := close
        layer.c
    else
        layer.h := math.max(high, nz(layer.h, high))
        layer.l := math.min(low, nz(layer.l, low))
        layer.c := close
        layer.c

new_year = ta.change(qYear), new_quart = ta.change(q2Month), new_month = ta.change(qMonth), new_week = ta.change(qWeek), new_daily = ta.change(qDay), new_90m = ta.change(q90), new_micro = ta.change(qMicro)

update_data(Year, bool(new_year)), update_data(Quart, bool(new_quart)), update_data(Month, bool(new_month)), update_data(Day, bool(new_week)), update_data(Ana, bool(new_daily)), update_data(Sub, bool(new_90m)), update_data(Micro, bool(new_micro))


