        lb0bear := label.new(time[1], high[1], text="🔻", xloc=xloc.bar_time, yloc=yloc.abovebar, color=color.new(color.gray,100), size=size.normal, textcolor=bear_clr, tooltip="Bearish PSP")
        label.delete(lb0bear[1])

//////////////////////////////////////////////////////////////////////////
if tf1ok and timeframe.in_seconds(tf) <= timeframe.in_seconds(tf1) and not triad_ok 
