show_tpdd       = input.bool(defval = false,title = "TPD",inline="2",group = g9)

i_main_clr = color.red
i_title_clr = color.red
i_bgcolor  = canvas_theme == "Dark" ? color.rgb(0, 0, 0, 50) : canvas_theme == "Light" ? color.rgb(255, 255, 255, 50) : color.rgb(178, 181, 190, 50)
